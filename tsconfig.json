{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "#schema/*": ["./schema/*"],
      "#scripts/*": ["./scripts/*"]
    }
  },
  "include": ["schema/**/*", "scripts/**/*", "tests/**/*"]
}
