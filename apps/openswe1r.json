{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.openswe1r.openswe1r",
      "name": "OpenSWE1R",
      "summary": "Open-source port and reimplementation of Star Wars Episode I: Racer",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "OpenSWE1R is an open-source reimplementation and modern port of the classic 1999 racing game Star Wars: Episode I Racer. It combines API translation with x86 CPU emulation, dynamically patching in native open-source code while executing original binaries to achieve cross-platform portability."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "While the project aims to eventually replace all proprietary game logic with clean, portable C11 code, original game data files and assets are required to play."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Cross-platform runtime abstraction using SDL2, GLEW, and OpenAL"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in x86 CPU emulation powered by the Unicorn-Engine backend"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern rendering pipeline built on OpenGL 3.3 Core"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dynamic runtime binary patching for incremental reimplementation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native support for original Windows game data and assets"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "OpenSWE1R Developers",
        "url": "https://github.com/OpenSWE1R/openswe1r"
      },
      "homepage": "https://github.com/OpenSWE1R/openswe1r",
      "repository": "https://github.com/pkgforge-dev/OpenSWE1R-AppImage",
      "keywords": [
        "starwars",
        "racer",
        "podracing",
        "racing",
        "reimplementation",
        "emulator",
        "opengl",
        "sdl2"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/openswe1r.png",
      "screenshots": [
        {
          "caption": "OpenSWE1R running Star Wars Episode I: Racer on Linux",
          "source": "https://i.imgur.com/LAqHPgh.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/OpenSWE1R-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
