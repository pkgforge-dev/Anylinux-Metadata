{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.linuxmint.bulky",
      "name": "Bulky",
      "summary": "Rename multiple files and directories in bulk with preview support",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Bulky is a dedicated bulk file and folder renaming utility created by the Linux Mint team under the XApps project. It allows users to rename multiple files and directories at once across desktop environments like Cinnamon, MATE, and GNOME."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Batch renaming for both files and directories"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-desktop compatibility across Cinnamon, MATE, GNOME, and other Linux desktop environments"
              }
            ],
            [
              {
                "type": "text",
                "value": "Side-by-side preview of original names and modified names before applying changes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for finding, replacing, and reformatting character patterns"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless integration with file managers as part of the XApps ecosystem"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Bulky Developers",
        "url": "https://github.com/linuxmint/bulky"
      },
      "homepage": "https://github.com/linuxmint/bulky",
      "repository": "https://github.com/pkgforge-dev/Bulky-AppImage",
      "keywords": [
        "rename",
        "batch",
        "xapps",
        "cinnamon",
        "mate",
        "gnome",
        "files",
        "directories",
        "reorganize"
      ],
      "categories": [
        "Utility",
        "System",
        "FileTransfer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/bulky.png",
      "screenshots": [
        {
          "caption": "Main Bulky interface displaying files queued for bulk renaming with side-by-side preview",
          "source": "https://github.com/user-attachments/assets/d8ba440b-5223-4387-904d-62beffec6711"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Bulky-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
