{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.freedesktop.gitlab.xclock",
      "name": "xclock",
      "summary": "Classic analog and digital clock display utility for the X Window System",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "xclock is the quintessential time display utility for the X Window System, offering both classic analog dial and straightforward digital clock presentations. Built natively on core X11 libraries, it provides a lightweight, highly responsive desktop clock with minimal resource overhead."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged with portable runtime dependencies, this build ensures effortless execution across a broad range of Linux distributions without requiring system-level installation."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Displays time in customizable analog or digital presentation modes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Lightweight X11 footprint with minimal system resource consumption"
              }
            ],
            [
              {
                "type": "text",
                "value": "FUSE-independent standalone portable execution using modern runtime components"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated opt-in update notifications with support for external package managers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "xclock Developers",
        "url": "https://gitlab.freedesktop.org/xorg/app/xclock"
      },
      "homepage": "https://gitlab.freedesktop.org/xorg/app/xclock",
      "repository": "https://github.com/pkgforge-dev/xclock-appimage",
      "keywords": [
        "clock",
        "time",
        "analog",
        "digital",
        "x11",
        "xorg",
        "desktop",
        "utility"
      ],
      "categories": [
        "Utility",
        "DesktopSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/xclock.png",
      "screenshots": [
        {
          "caption": "xclock interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/xclock-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
