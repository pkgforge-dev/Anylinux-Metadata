{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.valvesoftware.gamescope",
      "name": "Gamescope",
      "summary": "SteamOS micro-compositor designed to isolate, upscale, and manage game sessions",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Gamescope is a micro-compositor developed by Valve that isolates games inside a dedicated Xwayland sandbox desktop. Leveraging DRM/KMS direct frame flips and asynchronous Vulkan compute composition, it minimizes latency and eliminates unnecessary memory copies both in nested desktop sessions and embedded gaming environments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By spoofing virtual display resolutions and refresh rates, Gamescope allows fine-grained control over rendering and presentation across conventional displays, rotated screens, and ultrawide setups."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Low-latency frame presentation via direct DRM/KMS page flipping"
              }
            ],
            [
              {
                "type": "text",
                "value": "Asynchronous Vulkan compute composition for non-blocking frame pacing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dedicated Xwayland sandboxing to prevent game and desktop conflicts"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in spatial upscaling including AMD FSR, NVIDIA NIS, and integer scaling"
              }
            ],
            [
              {
                "type": "text",
                "value": "Virtual display spoofing for custom resolutions, aspect ratios, and refresh rates"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Gamescope Developers",
        "url": "https://github.com/ValveSoftware/gamescope"
      },
      "homepage": "https://github.com/ValveSoftware/gamescope",
      "repository": "https://github.com/pkgforge-dev/gamescope-appimage",
      "keywords": [
        "compositor",
        "wayland",
        "xwayland",
        "vulkan",
        "fsr",
        "upscaling",
        "steam",
        "gaming",
        "drm"
      ],
      "categories": [
        "System",
        "Game",
        "DesktopSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/gamescope.png",
      "screenshots": [
        {
          "caption": "Gamescope interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/gamescope-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
