{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.harbourmasters.lighthouse",
      "name": "Lighthouse",
      "summary": "Native PC port and launcher for Banjo-Kazooie by Harbour Masters",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Lighthouse is Harbour Masters' native PC port and launcher for Banjo-Kazooie, powered by a complete 100% decompilation of the original game. It enables running the classic 3D platformer natively on modern operating systems without emulation overhead, delivering improved performance and modern system integration."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By leveraging authentic game assets extracted from legally obtained original game ROMs, the project ensures accurate game mechanics and audio-visual fidelity while opening up possibilities for native enhancements."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native PC execution compiled directly for modern Linux systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full compatibility with multiple original game releases including US v1.0, US v1.1, JP, and PAL"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modular architecture allowing targeted extraction and building of individual game levels and modules"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automated asset extraction pipeline verified against authentic SHA-1 ROM checksums"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built on a complete 100% decompilation codebase of the original title"
              }
            ]
          ]
        }
      ],
      "projectLicense": "CC0-1.0",
      "developer": {
        "name": "Harbour Masters",
        "url": "https://www.harbourmasters.org"
      },
      "homepage": "https://www.harbourmasters.org",
      "repository": "https://github.com/HarbourMasters/Lighthouse",
      "keywords": [
        "banjo-kazooie",
        "decompilation",
        "port",
        "platformer",
        "n64",
        "harbour masters",
        "launcher",
        "retro"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/lighthouse.png",
      "screenshots": [
        {
          "caption": "Lighthouse interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Lighthouse-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
