{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.dcfuksurmom.phantom_satellite",
      "name": "Phantom Satellite",
      "summary": "Lightweight Pale Moon fork optimized for legacy architectures and niche platforms",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Phantom Satellite is a web browser forked from Pale Moon and built on the Unified XUL Platform (UXP). It is designed to extend web browsing capabilities to older, specialized, and niche platforms without sacrificing support for contemporary Linux distributions and modern hardware."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The browser incorporates tailored compiler configurations and community patches to enable usability across vintage processor architectures while retaining classic web browsing functionality."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Support for legacy 64-bit PowerPC (PPC64) chips dating prior to 2013 by decoupling hardcoded crypto instructions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatibility with x86 CPUs lacking SSE instruction sets, requiring only an Intel Pentium MMX or equivalent"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatibility configurations for x86 CPUs without SSE2 support, operable on systems with an Intel Pentium III"
              }
            ],
            [
              {
                "type": "text",
                "value": "Custom browser branding and integration with dedicated themes such as Cyan Moon"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for Linux systems using GTK2 toolkits alongside modern 64-bit ARM and x86_64 architectures"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Phantom Satellite Developers",
        "url": "https://github.com/DCFUKSURMOM/Phantom-Satellite"
      },
      "homepage": "https://github.com/DCFUKSURMOM/Phantom-Satellite",
      "repository": "https://github.com/pkgforge-dev/Phantom-Satellite-AppImage",
      "keywords": [
        "browser",
        "web",
        "palemoon",
        "uxp",
        "legacy",
        "powerpc",
        "ppc64",
        "nosse",
        "gtk2"
      ],
      "categories": [
        "Network",
        "WebBrowser"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/phantom-satellite.png",
      "screenshots": [
        {
          "caption": "Phantom Satellite interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Phantom-Satellite-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
