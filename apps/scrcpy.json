{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.genymobile.scrcpy",
      "name": "scrcpy",
      "summary": "Display and control Android devices connected via USB or TCP/IP",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "scrcpy is a lightweight, high-performance utility designed to mirror Android device screens and forward audio over USB or wireless TCP/IP connections. It enables seamless interaction with Android devices using your computer keyboard and mouse without requiring root access or installing client applications on the target device."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Engineered for low latency and high visual fidelity, scrcpy provides native performance with configurable resolutions, frame rates between 30 and 120 frames per second, and bidirectional clipboard synchronization."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Audio and video screen mirroring over USB or TCP/IP connections"
              }
            ],
            [
              {
                "type": "text",
                "value": "Control using physical keyboard and mouse simulation via HID and OTG modes"
              }
            ],
            [
              {
                "type": "text",
                "value": "High performance with 30 to 120 fps and ultra-low latency between 35 and 70 ms"
              }
            ],
            [
              {
                "type": "text",
                "value": "Screen recording and camera mirroring as a Linux V4L2 webcam"
              }
            ],
            [
              {
                "type": "text",
                "value": "Mirroring with the Android device screen turned off"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless bidirectional copy-paste clipboard sharing"
              }
            ]
          ]
        }
      ],
      "projectLicense": "Apache-2.0",
      "developer": {
        "name": "scrcpy Developers",
        "url": "https://github.com/Genymobile/scrcpy"
      },
      "homepage": "https://github.com/Genymobile/scrcpy",
      "repository": "https://github.com/pkgforge-dev/scrcpy-AppImage",
      "keywords": [
        "android",
        "mirroring",
        "remote",
        "screen",
        "adb",
        "usb",
        "webcam",
        "screencast"
      ],
      "categories": [
        "Utility",
        "Development",
        "RemoteAccess",
        "Debugger"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/scrcpy.png",
      "screenshots": [
        {
          "caption": "scrcpy mirroring an Android device screen on Debian",
          "source": "https://raw.githubusercontent.com/Genymobile/scrcpy/master/assets/screenshot-debian-600.jpg"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/scrcpy-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
