{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.afritz1.opentesarena",
      "name": "OpenTESArena",
      "summary": "Modern open-source engine reimplementation of The Elder Scrolls: Arena",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "OpenTESArena is an open-source engine written from scratch to reimplement the classic 1994 DOS role-playing game The Elder Scrolls: Arena. Developing a clean-room approach, it aims to faithfully replicate original game systems while introducing modern quality-of-life improvements and multiplatform compatibility."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine operates using original game data assets and provides both authentic classic controls and modernized navigation options."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Combat mechanics featuring attacking enemies, loot dropping, and character experience progression"
              }
            ],
            [
              {
                "type": "text",
                "value": "Town and shopkeeper services including buying, selling, tavern room rentals, and disease curing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Interactive wandering citizens capable of offering directions and sharing rumors"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast travel functionality accessible across any world map location"
              }
            ],
            [
              {
                "type": "text",
                "value": "Character creation and full inventory management for picking up, equipping, and dropping gear"
              }
            ],
            [
              {
                "type": "text",
                "value": "Configurable input supporting modern WASD mouselook controls alongside traditional classic controls"
              }
            ]
          ]
        }
      ],
      "projectLicense": "MIT",
      "developer": {
        "name": "Alexander Fritz",
        "url": "https://github.com/afritz1"
      },
      "homepage": "https://github.com/afritz1/OpenTESArena",
      "repository": "https://github.com/afritz1/OpenTESArena",
      "keywords": [
        "elder scrolls",
        "arena",
        "rpg",
        "game engine",
        "reimplementation",
        "dos",
        "bethesda",
        "dungeon crawler"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/opentesarena.png",
      "screenshots": [
        {
          "caption": "In-game exploration view in OpenTESArena",
          "source": "https://raw.githubusercontent.com/afritz1/OpenTESArena/main/Preview.PNG"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/OpenTESArena-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
