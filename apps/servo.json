{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.servo.servo",
      "name": "Servo",
      "summary": "Independent parallel web browser engine written in Rust",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Servo is an open-source, independent prototype web browser engine written in the Rust programming language. Designed for parallel execution and memory safety, Servo explores modern architecture patterns for rendering web content efficiently."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "It provides a cross-platform engine along with the servoshell application harness to experiment with web standards and cutting-edge browser technologies."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Written in Rust to ensure thread safety, concurrency, and memory safety"
              }
            ],
            [
              {
                "type": "text",
                "value": "Parallel layout, styling, and rendering architecture"
              }
            ],
            [
              {
                "type": "text",
                "value": "Includes the servoshell browser shell for standalone browsing and testing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform support across Linux, macOS, Windows, Android, and OpenHarmony"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modular toolchain integration using the mach build workflow"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Servo Developers",
        "url": "https://github.com/servo/servo"
      },
      "homepage": "https://github.com/servo/servo",
      "repository": "https://github.com/pkgforge-dev/servo-AppImage",
      "keywords": [
        "browser",
        "engine",
        "rust",
        "html",
        "rendering",
        "web",
        "css",
        "servoshell"
      ],
      "categories": [
        "Network",
        "Development",
        "WebBrowser",
        "WebDevelopment"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/servo.png",
      "screenshots": [
        {
          "caption": "Servo interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/servo-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
