{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rubberduckycooly.sonic_cd_11_decompilation_rsdkv3",
      "name": "RSDKv3",
      "summary": "Standalone open-source decompilation of Sonic CD (2011) and Retro Engine v3",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "RSDKv3 is a full open-source standalone decompilation of the Retro Engine v3 and the 2011 release of Sonic CD. Built using modern C and CMake, it provides a native cross-platform engine recreation that accurately delivers the classic platformer with enhanced modern capabilities, requiring assets from a legally acquired copy of the game to run."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine improves significantly upon the original PC and mobile ports by integrating extended gameplay tweaks, developer tools, and an extensible modding infrastructure."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Crisp, pixel-perfect rendering with full palette support and custom display resolution options"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in mod loader and API supporting save file redirection and XML GameConfig data"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full support for mobile and updated scripts to access exclusive features and revisions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive developer menu with scene jumping, scene reloading, and hitbox visualization"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully customizable controls and engine behavior via a centralized configuration file"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced debugging features ported from Sonic Mania, including frame step-over and fast forward"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "RSDKv3 Developers",
        "url": "https://github.com/Rubberduckycooly/Sonic-CD-11-Decompilation"
      },
      "homepage": "https://github.com/Rubberduckycooly/Sonic-CD-11-Decompilation",
      "repository": "https://github.com/pkgforge-dev/RSDKv3-AppImage",
      "keywords": [
        "sonic",
        "decompilation",
        "retroengine",
        "platformer",
        "engine",
        "modding",
        "soniccd"
      ],
      "categories": [
        "Game",
        "Development",
        "Debugger"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/rsdkv3.png",
      "screenshots": [
        {
          "caption": "RSDKv3 interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
