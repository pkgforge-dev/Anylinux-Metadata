{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "net.projectmagma.myth2",
      "name": "Myth II: Soulblighter",
      "summary": "Play the classic real-time tactical game with modern 64-bit Linux native support",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Myth II: Soulblighter is a modern 64-bit native Linux port of Bungie's acclaimed real-time tactical strategy game, maintained by Project Magma. Players command squads of warriors against undead legions, focusing on formation tactics, unit positioning, physics, and battlefield terrain rather than resource gathering."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package delivers seamless compatibility across modern distributions while preserving the original tactical gameplay, high-resolution rendering, and custom modding capabilities."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Updated 64-bit native engine powered by Project Magma improvements"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for custom tags, plugins, and cutscenes via user directory storage"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully self-contained package running reliably across glibc and musl distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated automatic update notifications with package manager detection"
              }
            ],
            [
              {
                "type": "text",
                "value": "FUSE-independent runtime execution for universal compatibility"
              }
            ]
          ]
        }
      ],
      "projectLicense": "LicenseRef-Proprietary",
      "developer": {
        "name": "Project Magma",
        "url": "https://projectmagma.net"
      },
      "homepage": "https://projectmagma.net",
      "repository": "https://github.com/pkgforge-dev/Myth-II-AppImage",
      "keywords": [
        "tactics",
        "strategy",
        "rts",
        "magma",
        "bungie",
        "classic",
        "soulblighter",
        "dark fantasy"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/myth-ii.png",
      "screenshots": [
        {
          "caption": "Myth II: Soulblighter interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Myth-II-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
