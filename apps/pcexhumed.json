    "metadata": {
      "id": "io.github.nblood.nblood_pcexhumed",
      "name": "PCExhumed",
      "summary": "PCExhumed is an accurate source port of the PC release of Exhumed (known in North America as PowerSlave), the 1996 Egyptian-themed first-person sho",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "PCExhumed is an accurate source port of the PC release of Exhumed (known in North America as PowerSlave), the 1996 Egyptian-themed first-person shooter. Based on the EDuke32 BUILD engine, it provides native 64-bit performance on Linux."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native execution on modern operating systems with high-resolution widescreen rendering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Smooth mouselook controls with customizable keybindings and crosshairs"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full support for original game data, CD audio soundtracks, and voiceovers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced dynamic lighting, particle effects, and uncapped framerate options"
              }
            ],
            [
              {
                "type": "text",
                "value": "Restores cut features and fixes engine glitches present in the original DOS release"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
