{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.nblood.nblood_pcexhumed",
      "name": "PCExhumed",
      "summary": "Reverse-engineered source port of the classic first-person shooter Exhumed and PowerSlave",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "PCExhumed is an accurate source port of the PC release of Exhumed (released as PowerSlave in North America), built upon EDuke32 engine technology and reverse-engineering principles. It brings the 1996 Egyptian-themed Build engine first-person shooter to modern Linux operating systems with enhanced stability and compatibility."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The port natively loads original game assets from retail releases, classic shareware/demo versions, and modern digital re-releases from Steam and GOG."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Automatic detection and compatibility with Steam and GOG installations of PowerSlave (DOS Classic Edition)"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for retail PC CD-ROM data files as well as the original demo release"
              }
            ],
            [
              {
                "type": "text",
                "value": "External OGG audio track playback for full CD soundtrack music and King Ramses storyline narration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full cinematic video playback support for original cutscene movies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Configurable field of view (FOV) settings ranging from 60 to 140 degrees"
              }
            ],
            [
              {
                "type": "text",
                "value": "Mouse look customization options including optional vertical axis inversion"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "PCExhumed Developers",
        "url": "https://github.com/NBlood/NBlood"
      },
      "homepage": "https://github.com/NBlood/NBlood",
      "repository": "https://github.com/pkgforge-dev/PCExhumed-AppImage",
      "keywords": [
        "powerslave",
        "exhumed",
        "eduke32",
        "build engine",
        "source port",
        "fps",
        "shooter",
        "retro"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/pcexhumed.png",
      "screenshots": [
        {
          "caption": "In-game gameplay in PCExhumed",
          "source": "https://github.com/user-attachments/assets/43ec8959-a6e6-4d8c-a4a9-3d3f9f08d65a"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/PCExhumed-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
