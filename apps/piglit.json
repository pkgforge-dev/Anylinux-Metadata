{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.freedesktop.gitlab.piglit",
      "name": "piglit",
      "summary": "Automated test suite designed for verifying OpenGL, OpenCL, and Vulkan driver implementations",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Piglit is a comprehensive open-source automated testing suite developed under the Mesa project for validating graphics hardware drivers. It provides developers and testers with robust tools to verify driver compliance, catch regressions, and ensure conformance across modern graphical computing APIs."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By executing test matrices against standard graphics profiles and shader pipelines, Piglit delivers detailed test reports to isolate issues in rendering, hardware acceleration, and API behaviors."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Automated test execution across OpenGL, OpenGL ES, OpenCL, and Vulkan implementations"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive shader verification covering GLSL compilation and execution"
              }
            ],
            [
              {
                "type": "text",
                "value": "Regression testing framework tailored for graphics driver quality assurance"
              }
            ],
            [
              {
                "type": "text",
                "value": "HTML and structured test result generation for benchmarking and tracking runs"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive suite of functional rendering and compute verification tests"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "piglit Developers",
        "url": "https://gitlab.freedesktop.org/mesa/piglit"
      },
      "homepage": "https://gitlab.freedesktop.org/mesa/piglit",
      "repository": "https://github.com/pkgforge-dev/Piglit-AppImage",
      "keywords": [
        "opengl",
        "vulkan",
        "opencl",
        "mesa",
        "driver",
        "testing",
        "benchmark",
        "graphics",
        "conformance"
      ],
      "categories": [
        "Development",
        "Graphics",
        "Debugger",
        "Profiling",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/piglit.png",
      "screenshots": [
        {
          "caption": "piglit interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Piglit-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
