{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.revosucks.bm64recomp",
      "name": "Bomberman 64 Recompiled",
      "summary": "Native PC port of Bomberman 64 created via static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Bomberman 64 Recompiled is an enhanced native PC port of the classic Nintendo 64 title Bomberman 64, powered by the N64Recomp static recompilation engine and the RT64 rendering engine. It delivers modernized performance, full graphical fidelity, and extensive modding support while requiring an original game ROM to provide game assets."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Plug-and-play ROM asset loading without requiring manual extraction or separate asset builds"
              }
            ],
            [
              {
                "type": "text",
                "value": "High and uncapped refresh rate support without altering core game mechanics or physics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Widescreen and ultrawide display rendering with original visual effects fully intact"
              }
            ],
            [
              {
                "type": "text",
                "value": "In-game configuration menus with full navigation support for mouse, keyboard, and gamepads"
              }
            ],
            [
              {
                "type": "text",
                "value": "Reduced input latency and near-instant load times compared to original hardware"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Revo",
        "url": "https://github.com/RevoSucks"
      },
      "homepage": "https://github.com/RevoSucks/BM64Recomp",
      "repository": "https://github.com/RevoSucks/BM64Recomp",
      "keywords": [
        "bomberman",
        "recompiled",
        "n64recomp",
        "rt64",
        "recompilation",
        "port",
        "retrogaming"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/bm64recomp.png",
      "screenshots": [
        {
          "caption": "Bomberman 64 Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
