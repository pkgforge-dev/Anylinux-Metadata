  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.revosucks.bm64recomp",
      "name": "Bomberman 64 Recompiled",
      "summary": "Native PC port of Bomberman 64 created using static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Bomberman 64 Recompiled is an enhanced native PC port of the classic Nintendo 64 game Bomberman 64, generated through static binary recompilation. The project compiles original game logic into native C code for seamless desktop execution."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Players can experience the single-player adventure and chaotic multiplayer battle modes with modern resolutions, responsive controls, and high-framerate performance."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native 64-bit execution eliminating emulation performance overhead"
              }
            ],
            [
              {
                "type": "text",
                "value": "Widescreen and high-resolution rendering support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Low-latency input processing with modern controller compatibility"
              }
            ],
            [
              {
                "type": "text",
                "value": "Authentic physics simulation and bomb bouncing mechanics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Classic multi-arena battle mode with configurable match rules"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Revo",
        "url": "https://github.com/RevoSucks"
