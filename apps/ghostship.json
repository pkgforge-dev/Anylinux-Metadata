{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.sm64pc.sm64ex_ghostship",
      "name": "Ghostship",
      "summary": "Enhanced native PC port of Super Mario 64 with modern features and enhancements",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Ghostship is an enhanced native PC port of Super Mario 64 based on the sm64ex project. It provides an optimized, native platforming experience on modern systems without requiring emulation, featuring improved performance and extensive configurability."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The port introduces modern convenience and graphics upgrades while preserving authentic game mechanics and compatibility with original assets and save files."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "In-game options menu with customizable key and controller button remapping"
              }
            ],
            [
              {
                "type": "text",
                "value": "Analog camera and mouse look control support powered by Puppycam"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for external texture packs and custom assembled soundbanks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiple rendering backends including OpenGL and configurable drawing distances"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-compatibility with emulator and port save files, alongside text-based save support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in cheats menu and option to skip introductory cutscenes"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Ghostship Developers",
        "url": "https://github.com/sm64pc/sm64ex"
      },
      "homepage": "https://github.com/sm64pc/sm64ex",
      "repository": "https://github.com/pkgforge-dev/Ghostship-AppImage-Enhanced",
      "keywords": [
        "sm64",
        "sm64ex",
        "mario",
        "platformer",
        "port",
        "puppycam",
        "opengl",
        "retro"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/ghostship.png",
      "screenshots": [
        {
          "caption": "Ghostship interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Ghostship-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
