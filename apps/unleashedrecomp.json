{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.hedge_dev.unleashedrecomp",
      "name": "Unleashed Recompiled",
      "summary": "Enhanced native PC port of Sonic Unleashed created using static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Unleashed Recompiled is an unofficial native PC port of the Xbox 360 version of Sonic Unleashed, created via static recompilation using XenonRecomp and XenosRecomp. It converts the game's original PowerPC code and Xenos shaders into native C++ and graphics APIs without runtime emulation overhead, requiring user-provided original game assets to play."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The port significantly enhances the original title with modern display standards, optimized performance, and platform upgrades for Linux and Windows systems."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native execution with support for high resolutions and ultrawide aspect ratios"
              }
            ],
            [
              {
                "type": "text",
                "value": "High frame rate display options and improved rendering performance"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern graphics pipeline support targeting Vulkan 1.2 and Direct3D 12"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in modding capabilities and custom content loading"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for optional Xbox 360 downloadable content and high-quality DLC lighting"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Unleashed Recompiled Developers",
        "url": "https://github.com/hedge-dev/UnleashedRecomp"
      },
      "homepage": "https://github.com/hedge-dev/UnleashedRecomp",
      "repository": "https://github.com/pkgforge-dev/UnleashedRecomp-AppImage",
      "keywords": [
        "sonic",
        "unleashed",
        "recompilation",
        "platformer",
        "port",
        "vulkan",
        "hedgehog",
        "xenon"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/unleashedrecomp.png",
      "screenshots": [
        {
          "caption": "Unleashed Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/UnleashedRecomp-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
