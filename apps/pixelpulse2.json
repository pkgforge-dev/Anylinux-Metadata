{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.analogdevicesinc.pixelpulse2",
      "name": "Pixelpulse2",
      "summary": "Explore, visualize, and manipulate hardware signals using compatible analog interface devices",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Pixelpulse2 is an open-source graphical user interface designed for visualizing and manipulating signals while exploring hardware systems attached to analog interface devices such as Analog Devices' ADALM1000. Built with the Qt5 graphics framework and OpenGL-accelerated density-gradiated rendering, it provides an interactive and responsive environment for hardware signal experimentation."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "With an intuitive click-and-drag interface, users can quickly source constant signals or generate dynamic waveforms to analyze system behavior across varied amplitudes, frequencies, and phases."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Stream data to and from USB-connected devices via libsmu integration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Source constant voltage or current with single-click controls"
              }
            ],
            [
              {
                "type": "text",
                "value": "Generate standard waveforms including sinusoidal, square, triangle, and sawtooth"
              }
            ],
            [
              {
                "type": "text",
                "value": "Accelerate density-gradiated waveform rendering via OpenGL"
              }
            ],
            [
              {
                "type": "text",
                "value": "Pan along the time axis and zoom into signal details using scroll wheel and multitouch gestures"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Pixelpulse2 Developers",
        "url": "https://github.com/analogdevicesinc/pixelpulse2"
      },
      "homepage": "https://github.com/analogdevicesinc/pixelpulse2",
      "repository": "https://github.com/pkgforge-dev/pixelpulse2-appimage",
      "keywords": [
        "signal",
        "oscilloscope",
        "adalm1000",
        "libsmu",
        "waveform",
        "analog",
        "hardware",
        "visualization"
      ],
      "categories": [
        "Development",
        "Science",
        "Debugger",
        "Chart"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/pixelpulse2.png",
      "screenshots": [
        {
          "caption": "Pixelpulse2 interface screenshot 1",
          "source": "https://analogdevicesinc.github.io/Pixelpulse2/pp2screenshot.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Pixelpulse2-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
