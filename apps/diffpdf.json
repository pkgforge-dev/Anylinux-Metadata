{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.gitlab.diffpdf",
      "name": "DiffPDF",
      "summary": "Compare two PDF files side by side visually or by text",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "DiffPDF is a specialized graphical desktop utility designed to compare two PDF files side by side and highlight differences between them. Built using Qt and Poppler, it offers an efficient and intuitive way to verify document revisions, proofread publications, and inspect formatting changes."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The tool supports dual comparison modes, allowing users to inspect files either textually or visually based on layout rendering and appearance."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Side-by-side synchronized view for comparing PDF documents simultaneously"
              }
            ],
            [
              {
                "type": "text",
                "value": "Text comparison mode to detect textual modifications, deletions, and additions across pages"
              }
            ],
            [
              {
                "type": "text",
                "value": "Visual appearance comparison mode to catch subtle layout, font, and graphic changes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Clear visual highlighting of matching and non-matching areas directly on document pages"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for custom page ranges and individual page alignment across different document versions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "DiffPDF Developers",
        "url": "https://gitlab.com/eang/diffpdf"
      },
      "homepage": "https://gitlab.com/eang/diffpdf",
      "repository": "https://github.com/pkgforge-dev/diffpdf-appimage",
      "keywords": [
        "pdf",
        "diff",
        "compare",
        "document",
        "poppler",
        "proofreading",
        "side-by-side"
      ],
      "categories": [
        "Office",
        "Viewer",
        "TextTools"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/diffpdf.png",
      "screenshots": [
        {
          "caption": "DiffPDF interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/DiffPDF-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
