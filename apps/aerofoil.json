{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.elasota.aerofoil",
      "name": "Aerofoil",
      "summary": "Fly a paper airplane through obstacles in a modern port of the classic Macintosh game Glider PRO",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Aerofoil is a modern, cross-platform port of John Calhoun's classic 1994 Macintosh flight game, Glider PRO. The project faithfully recreates the original paper airplane navigation experience while modernizing the engine for contemporary desktop systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Featuring authentic gameplay and retro styling, Aerofoil combines nostalgic audiovisual presentation with modern quality-of-life enhancements and content creation tools."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Faithful 1990s-style graphical user interface"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern gamepad and controller input support"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-quality graphic upscaling and color correction filters"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated port of the original Glider PRO house and level editor"
              }
            ],
            [
              {
                "type": "text",
                "value": "Import utilities for unpacking and playing legacy community house files"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-only",
      "developer": {
        "name": "Aerofoil Developers",
        "url": "https://github.com/elasota/Aerofoil"
      },
      "homepage": "https://github.com/elasota/Aerofoil",
      "repository": "https://github.com/pkgforge-dev/Aerofoil-AppImage",
      "keywords": [
        "glider",
        "glider pro",
        "paper airplane",
        "flight",
        "macintosh",
        "retro",
        "arcade",
        "level editor"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/aerofoil.png",
      "screenshots": [
        {
          "caption": "Aerofoil interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
