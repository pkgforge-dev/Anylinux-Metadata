{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rockinchaos.shiru",
      "name": "Shiru",
      "summary": "Personal anime library manager for watching and tracking media collections in real time",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Shiru is a feature-rich desktop anime library manager designed for speed, control, and a seamless playback experience. Built using Electron and Vue, it plays local media directly for near-instant native video performance without transcoding or compression."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "It acts as a centralized dashboard for tracking viewing progress, organizing series, and managing synchronization across third-party tracking services."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "AniList and MyAnimeList integration for list synchronization, progress tracking, and ratings"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dub-first tracking with independent dub and sub schedules and customizable preference filters"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive subtitle support for softcoded and external files including VTT, SSA, ASS, and SUB"
              }
            ],
            [
              {
                "type": "text",
                "value": "Real-time notifications for newly released subbed, dubbed, and batch episodes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensible architecture supporting personal media server and custom content source plugins"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully customizable drag-and-drop keybinding editor for tailored playback controls"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "RockinChaos",
        "url": "https://github.com/RockinChaos"
      },
      "homepage": "https://github.com/RockinChaos/Shiru",
      "repository": "https://github.com/RockinChaos/Shiru",
      "keywords": [
        "anime",
        "player",
        "video",
        "anilist",
        "myanimelist",
        "subtitles",
        "media",
        "library"
      ],
      "categories": [
        "AudioVideo",
        "Video",
        "Viewer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/shiru.png",
      "screenshots": [
        {
          "caption": "Shiru interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Shiru-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
