{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.phoboslab.wipeout_rewrite",
      "name": "WipEout Rewrite",
      "summary": "Re-implementation of the classic 1995 futuristic anti-gravity racing game",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "wipEout Rewrite is an open-source C re-implementation of the iconic 1995 anti-gravity combat racing game originally released for the Sony PlayStation. It brings the high-speed futuristic racing experience to modern platforms with native performance and updated rendering pipelines."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine is architected with multiple backend options, allowing it to adapt to diverse graphical APIs, legacy drivers, and input configurations across modern operating systems."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native SDL2 platform backend offering full support for gamepads and joysticks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern rendering through OpenGL 3.3 via the lightweight Sokol backend"
              }
            ],
            [
              {
                "type": "text",
                "value": "Legacy OpenGL 2.x and GLX backend support for compatibility with older hardware"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform anti-gravity racing physics and track simulation accurate to the original PSX title"
              }
            ],
            [
              {
                "type": "text",
                "value": "CMake and Makefile build systems designed for straightforward compilation on Linux and Unix-like systems"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "WipEout Rewrite Developers",
        "url": "https://github.com/phoboslab/wipeout-rewrite"
      },
      "homepage": "https://github.com/phoboslab/wipeout-rewrite",
      "repository": "https://github.com/pkgforge-dev/wipEout-Rewrite-AppImage",
      "keywords": [
        "wipeout",
        "racing",
        "playstation",
        "psx",
        "sdl2",
        "sokol",
        "opengl",
        "retro"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/wipeout-rewrite.png",
      "screenshots": [
        {
          "caption": "WipEout Rewrite interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/wipEout-Rewrite-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
