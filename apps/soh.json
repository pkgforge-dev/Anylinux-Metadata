{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.harbourmasters.shipofharkinian",
      "name": "Ship of Harkinian",
      "summary": "Native PC port of The Legend of Zelda: Ocarina of Time with modern enhancements",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Ship of Harkinian is an open-source native port of The Legend of Zelda: Ocarina of Time built on libultraship and the decompilation project. It runs the classic adventure natively on modern PC platforms without emulation, requiring a user-provided ROM dump to extract game assets."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The port introduces quality-of-life upgrades, enhanced visuals, and customizable controls while faithfully maintaining the original game experience."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native cross-platform rendering backends including OpenGL and DirectX11"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern keyboard, mouse capture, and gamepad controller configuration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in save state management and state switching shortcuts"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-framerate rendering and fullscreen display support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for alternate visual assets and text-to-speech accessibility features"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automatic asset extraction and generation of O2R archive packages from supported ROM dumps"
              }
            ]
          ]
        }
      ],
      "projectLicense": "CC0-1.0",
      "developer": {
        "name": "Harbour Masters",
        "url": "https://www.harbourmasters.org"
      },
      "homepage": "https://www.shipofharkinian.com",
      "repository": "https://github.com/HarbourMasters/Shipwright",
      "keywords": [
        "zelda",
        "ocarina",
        "port",
        "libultraship",
        "decompilation",
        "n64",
        "adventure",
        "opengl"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/soh.png",
      "screenshots": [
        {
          "caption": "Ship of Harkinian interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/soh-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
