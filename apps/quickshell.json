{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.outfoxxed.quickshell",
      "name": "Quickshell",
      "summary": "Flexible framework for building custom desktop shells, status bars, and system widgets using QML and QtQuick",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Quickshell is a flexible and lightweight framework designed for creating custom desktop shells, system widgets, status bars, and notification daemons using QML and QtQuick. It enables developers and users to build tailored, modular desktop interface components that integrate cleanly with modern Linux desktop environments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Leveraging the reactive design of QtQuick and declarative QML, Quickshell offers full control over layout, styling, and system event handling, allowing users to configure or replace traditional desktop environment components."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Declarative user interface creation powered by QtQuick and QML"
              }
            ],
            [
              {
                "type": "text",
                "value": "Framework for crafting custom status bars, panels, and docks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for standalone notification daemons and popup overlays"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modular system widget architecture for desktop customization"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless integration with Wayland and X11 display servers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "LGPL-3.0-or-later",
      "developer": {
        "name": "Quickshell Developers",
        "url": "https://github.com/outfoxxed/quickshell"
      },
      "homepage": "https://github.com/outfoxxed/quickshell",
      "repository": "https://github.com/pkgforge-dev/quickshell-appimage",
      "keywords": [
        "qml",
        "qtquick",
        "desktop",
        "status bar",
        "panel",
        "widget",
        "wayland",
        "shell",
        "notifications"
      ],
      "categories": [
        "System",
        "DesktopSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/quickshell.png",
      "screenshots": [
        {
          "caption": "Quickshell interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Quickshell-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
