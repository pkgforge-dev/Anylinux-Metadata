{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rhy3756547.simitone",
      "name": "Simitone",
      "summary": "Open-source 3D reimplementation and modern frontend for The Sims 1",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Simitone is an open-source C# frontend and reimplementation engine for The Sims 1, built upon the FreeSO architecture. Designed to enhance the playability of original game installations on modern operating systems, it brings updated rendering, high-resolution visual enhancements, and contemporary interface scaling to the classic simulation title."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Please note that running the game requires a legitimate existing installation of The Sims: Complete Collection."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Modernized user interface designed to scale seamlessly at high display resolutions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced graphical performance featuring support for high refresh rates and arbitrary resolutions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated advanced lighting effects to elevate original scene rendering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Bundled Volcanic tool for inspecting, modifying, and creating custom game objects"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Simitone Developers",
        "url": "https://github.com/RHY3756547/Simitone"
      },
      "homepage": "https://github.com/RHY3756547/Simitone",
      "repository": "https://github.com/pkgforge-dev/Simitone-AppImage",
      "keywords": [
        "simulation",
        "sims",
        "freeso",
        "game engine",
        "reimplementation",
        "3d engine",
        "modding"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/simitone.png",
      "screenshots": [
        {
          "caption": "Simitone in-game 3D rendering and neighborhood gameplay interface",
          "source": "https://user-images.githubusercontent.com/6294155/29047328-2bb60b54-7bc3-11e7-8d88-cee5309495ed.png"
        }
      ]
    }
