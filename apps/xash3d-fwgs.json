{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.fwgs.xash3d_fwgs",
      "name": "xash3d-fwgs",
      "summary": "Custom game engine compatible with Half-Life and GoldSrc modifications",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Xash3D FWGS is an open-source, cross-platform game engine designed to provide extended compatibility with the GoldSrc engine and Valve's Half-Life SDK. As a heavily updated fork of the original Xash3D engine, it modernizes classic gameplay workflows across modern operating systems and CPU architectures."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Full compatibility with Steam Half-Life (HLSDK 2.5) and GoldSrc protocol standards"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiple graphical renderers including OpenGL, GLESv1, GLESv2, and Software rendering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced multiplayer with multiple master servers, headless dedicated server, voice chat, and IPv6"
              }
            ],
            [
              {
                "type": "text",
                "value": "Advanced virtual filesystem supporting .pk3 and .pk3dir packages alongside fast case-insensitivity emulation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern asset format support including PNG, KTX2, Ogg Vorbis, and Opus audio"
              }
            ],
            [
              {
                "type": "text",
                "value": "Versatile input support covering keyboard, mouse, touch controls, and gamepads"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-only",
      "developer": {
        "name": "xash3d-fwgs Developers",
        "url": "https://github.com/FWGS/xash3d-fwgs"
      },
      "homepage": "https://github.com/FWGS/xash3d-fwgs",
      "repository": "https://github.com/pkgforge-dev/Xash3D-FWGS-AppImage-Enhanced",
      "keywords": [
        "game",
        "engine",
        "halflife",
        "goldsrc",
        "opengl",
        "fps",
        "multiplayer",
        "hlsdk"
      ],
      "categories": [
        "Game",
        "Development"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/xash3d-fwgs.png",
      "screenshots": [
        {
          "caption": "xash3d-fwgs interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Xash3D-FWGS-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
