{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.mednafen.mednafen",
      "name": "Mednafen",
      "summary": "Multi-system command-line emulator utilizing OpenGL and SDL",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Mednafen is a versatile, portable multi-system emulator driven by a robust command-line interface and accelerated with OpenGL and SDL. It delivers high-accuracy emulation for an extensive array of classic gaming consoles and handheld architectures."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for broad cross-distribution compatibility, this build bundles all required runtime libraries and provides integrated update notifications without requiring elevated container privileges."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High-performance video rendering backed by OpenGL and SDL"
              }
            ],
            [
              {
                "type": "text",
                "value": "Accurate emulation across multiple classic console and handheld platforms"
              }
            ],
            [
              {
                "type": "text",
                "value": "Lightweight command-line interface tailored for speed and scriptability"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully bundled standalone execution compatible across glibc and musl distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Optional integrated self-updater with automatic update detection"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Mednafen Developers",
        "url": "https://mednafen.github.io/"
      },
      "homepage": "https://mednafen.github.io/",
      "repository": "https://github.com/pkgforge-dev/mednafen-appimage",
      "keywords": [
        "emulator",
        "emulation",
        "retrogaming",
        "opengl",
        "sdl",
        "console",
        "multisystem"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/mednafen.png",
      "screenshots": [
        {
          "caption": "Mednafen interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/mednafen-appimage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
