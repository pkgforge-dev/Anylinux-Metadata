{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.mralaux.nugget_doom",
      "name": "nugget-doom",
      "summary": "Enhanced Doom source port forked from Woof! with modern gameplay and visual features",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Nugget Doom is an enhanced Doom source port forked from Woof! that brings extensive gameplay options, visual improvements, and quality-of-life enhancements while aiming to preserve demo compatibility."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "It incorporates advanced rendering touches, expanded modding capabilities, and accessibility features inspired by modern classic ports."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "True-color lighting, radial fog, sprite shadows, and thing lighting modes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for high-resolution sprites and weapon voxel models"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced mobility options including jumping, crouching, freecam, and moving over or under things"
              }
            ],
            [
              {
                "type": "text",
                "value": "NUGHUD alternative lump support for deep HUD customization and multi-line messages"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive accessibility options, smart autoaim, and customizable gibbing physics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Quality-of-life additions including auto-save intervals, tag finder, and expanded cheats"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "nugget-doom Developers",
        "url": "https://github.com/mralaux/nugget-doom"
      },
      "homepage": "https://github.com/mralaux/nugget-doom",
      "repository": "https://github.com/pkgforge-dev/Nugget-Doom-AppImage-Enhanced",
      "keywords": [
        "doom",
        "woof",
        "source port",
        "fps",
        "shooter",
        "classic",
        "retro",
        "voxels"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/nugget-doom.png",
      "screenshots": [
        {
          "caption": "nugget-doom interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Nugget-Doom-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
