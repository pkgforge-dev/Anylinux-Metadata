{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.universal_debloater_alliance.universal_android_debloater_next_generation_uad_ng",
      "name": "Universal Android Debloater NG",
      "summary": "Debloat and remove unnecessary system apps from non-rooted Android devices",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Universal Android Debloater Next Generation (UAD-ng) is an open-source desktop utility built with Rust and the Iced GUI framework designed to debloat non-rooted Android devices. It helps users uninstall or disable unwanted OEM, carrier, and vendor software to improve privacy, performance, battery life, and security."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By reducing the device's attack surface and eliminating obscure background system applications, UAD-ng gives users complete oversight of their installed packages without requiring root access."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Uninstall or disable unwanted system packages safely on non-rooted Android devices"
              }
            ],
            [
              {
                "type": "text",
                "value": "Curated community debloat lists with package safety classifications and descriptions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automatic updates for the debloat package recommendations list via GitHub"
              }
            ],
            [
              {
                "type": "text",
                "value": "Privacy-focused operation without telemetry, analytics, or user data tracking"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern, responsive graphical user interface built with the Rust Iced toolkit"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Universal Android Debloater NG Developers",
        "url": "https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation"
      },
      "homepage": "https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation",
      "repository": "https://github.com/pkgforge-dev/uad-ng-AppImage",
      "keywords": [
        "android",
        "debloat",
        "debloater",
        "adb",
        "privacy",
        "packages",
        "uninstaller"
      ],
      "categories": [
        "System",
        "Utility",
        "PackageManager",
        "HardwareSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/uad-ng.png",
      "screenshots": [
        {
          "caption": "Universal Android Debloater NG interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/uad-ng-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
