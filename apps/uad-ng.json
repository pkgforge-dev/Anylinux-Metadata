{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.universal_debloater_alliance.universal_android_debloater_next_generation_uad_ng",
      "name": "Universal Android Debloater NG",
      "summary": "Universal Android Debloater Next Generation (UAD-NG) is an open-source desktop tool to debloat non-rooted Android devices",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Universal Android Debloater Next Generation (UAD-NG) is an open-source desktop tool to debloat non-rooted Android devices. Using ADB, it safely uninstalls or disables manufacturer and carrier bloatware to improve privacy and battery life."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Extensively documented debloat package list with safety ratings and descriptions"
              }
            ],
            [
              {
                "type": "text",
                "value": "One-click disabling and re-enabling of carrier bloat, tracking daemons, and vendor apps"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multi-user and multi-profile support (Work profiles, Secure Folder)"
              }
            ],
            [
              {
                "type": "text",
                "value": "Safe restoration and un-debloat functionality to restore original system state"
              }
            ],
            [
              {
                "type": "text",
                "value": "Connects directly over USB or Wi-Fi ADB without needing root access on the device"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Universal Android Debloater NG Developers",
        "url": "https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation"
      },
      "homepage": "https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation",
      "repository": "https://github.com/pkgforge-dev/uad-ng-AppImage",
      "keywords": [
        "uad-ng",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "System",
        "Utility",
        "HardwareSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/uad-ng.png",
      "screenshots": [
        {
          "caption": "Universal Android Debloater NG interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/uad-ng-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
