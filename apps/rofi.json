{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.samueru_sama.rofi_appimage_rofi",
      "name": "rofi",
      "summary": "Window switcher, application launcher, and dmenu replacement",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Rofi is a versatile, lightweight window switcher, application launcher, and dmenu replacement designed to streamline window management and command execution on Linux desktops."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package bundles all required dependencies and operates without requiring FUSE or container runtimes, ensuring broad compatibility across glibc and musl-based distributions."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Functions as a drop-in replacement for dmenu with extended capabilities"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast interactive window switcher and desktop application launcher"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable distribution with all dependencies bundled"
              }
            ],
            [
              {
                "type": "text",
                "value": "Runs seamlessly on diverse Linux distributions including musl-based systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Operates without requiring FUSE system privileges"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "rofi Developers",
        "url": "https://github.com/Samueru-sama/rofi-AppImage"
      },
      "homepage": "https://github.com/Samueru-sama/rofi-AppImage",
      "repository": "https://github.com/pkgforge-dev/rofi-AppImage",
      "keywords": [
        "launcher",
        "switcher",
        "dmenu",
        "window",
        "desktop",
        "fuzzy",
        "menu"
      ],
      "categories": [
        "System",
        "Utility",
        "DesktopSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/rofi.png",
      "screenshots": [
        {
          "caption": "rofi interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/rofi-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
