{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rws_studios.postal_sourcecode_postal",
      "name": "POSTAL",
      "summary": "Classic fast-paced isometric shooter inspired by Robotron",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "POSTAL is the open-source release of the classic 1997 isometric shooter developed by Running With Scissors. Built originally as a fast-paced, top-down combat title influenced by arcade games like Robotron, the game puts players into intense survival scenarios across varied environments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Now maintained as open-source software, the codebase allows modern systems to experience the original gameplay, mechanics, and retro aesthetic faithfully preserved by the community."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Classic isometric 2.5D perspective and top-down shooter action"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast-paced combat mechanics inspired by arcade twin-stick classics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully open-source engine enabling cross-platform compatibility"
              }
            ],
            [
              {
                "type": "text",
                "value": "Hand-painted atmospheric level backgrounds and vintage late-90s art style"
              }
            ],
            [
              {
                "type": "text",
                "value": "Complete preservation of original audio, dialogue, and sound design"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "POSTAL Developers",
        "url": "https://github.com/RWS-Studios/POSTAL-SourceCode"
      },
      "homepage": "https://github.com/RWS-Studios/POSTAL-SourceCode",
      "repository": "https://github.com/pkgforge-dev/POSTAL-AppImage",
      "keywords": [
        "shooter",
        "isometric",
        "arcade",
        "retro",
        "classic",
        "action",
        "robotron",
        "open-source"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/postal.png",
      "screenshots": [
        {
          "caption": "POSTAL interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
