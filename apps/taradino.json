{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.fabiangreffrath.taradino",
      "name": "Taradino",
      "summary": "Modern SDL2 source port of the classic first-person shooter Rise of the Triad",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Taradino is an open-source modern source port of Rise of the Triad: Dark War, the classic 1994 first-person shooter by Apogee Software. Built using SDL2 and SDL_mixer, it faithfully reproduces the gameplay and features of the original title on contemporary operating systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine has been updated with modern portability fixes to run smoothly across modern Linux environments, while preserving the fast-paced retro action of the original release."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Cross-platform support for 64-bit and big-endian computer architectures"
              }
            ],
            [
              {
                "type": "text",
                "value": "Powered by modern Simple DirectMedia Layer (SDL2) video and input backends"
              }
            ],
            [
              {
                "type": "text",
                "value": "Audio playback handled via SDL_mixer"
              }
            ],
            [
              {
                "type": "text",
                "value": "Optional authentic OPL3 and AdLib music synthesis powered by libADLMIDI"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatible with both shareware and registered retail game data files"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Taradino Developers",
        "url": "https://github.com/fabiangreffrath/taradino"
      },
      "homepage": "https://github.com/fabiangreffrath/taradino",
      "repository": "https://github.com/pkgforge-dev/Taradino-AppImage",
      "keywords": [
        "rise of the triad",
        "rott",
        "apogee",
        "fps",
        "source port",
        "retro",
        "shooter",
        "sdl2",
        "adlmidi"
      ],
      "categories": [
        "Game",
        "Midi"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/taradino.png",
      "screenshots": [
        {
          "caption": "Taradino interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Taradino-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
