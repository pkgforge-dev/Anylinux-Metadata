{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "net.launchpad.maniadrive",
      "name": "ManiaDrive",
      "summary": "Arcade car driving and acrobatic stunt game in the spirit of TrackMania",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ManiaDrive is an arcade racing game centered on complex stunt driving and fast-paced acrobatic tracks. Inspired by the TrackMania series, the game challenges drivers to navigate intricate courses featuring loops, steep jumps, and tight obstacles requiring precise control and physics mastery."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged with portable runtime dependencies, this release delivers seamless compatibility across varied Linux distributions without external configuration."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Acrobatic stunt courses including dramatic loops, corkscrews, and ramps"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast-paced arcade physics engine emphasizing quick reflexes and timing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Time attack racing aimed at beating lap records and personal bests"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in update notification system ensuring up-to-date game builds"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable execution requiring no FUSE setup or system-level containers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ManiaDrive Developers",
        "url": "https://launchpad.net/~aapo-rantalainen/+archive/ubuntu/games"
      },
      "homepage": "https://launchpad.net/~aapo-rantalainen/+archive/ubuntu/games",
      "repository": "https://github.com/pkgforge-dev/ManiaDrive-AppImage",
      "keywords": [
        "racing",
        "arcade",
        "stunts",
        "driving",
        "cars",
        "trackmania",
        "physics",
        "simulation"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/maniadrive.png",
      "screenshots": [
        {
          "caption": "ManiaDrive interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
