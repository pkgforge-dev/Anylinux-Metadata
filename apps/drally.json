{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.urxp.drally",
      "name": "dRally",
      "summary": "Play the classic 1996 top-down vehicular combat and racing game natively",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "dRally is an open-source native port of Death Rally (1996), the classic top-down vehicular combat racing game originally developed by Remedy Entertainment. Built using SDL2 and C, the project modernizes the game engine to run natively on Linux and BSD operating systems while preserving authentic gameplay."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The port requires the original Death Rally game data assets to operate, providing faithful recreation of original mechanics, full audio playback, cinematic sequences, and single-player tournament progression."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native SDL2-powered rendering and input for modern Linux and BSD platforms"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for original cinematics, animations, and CD-ROM cutscenes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Classic top-down vehicular racing, vehicle upgrades, and weapon combat"
              }
            ],
            [
              {
                "type": "text",
                "value": "Playback of original in-game music tracks and sound effects"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatibility with original freeware and registered Death Rally asset archives"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "dRally Developers",
        "url": "https://github.com/urxp/dRally"
      },
      "homepage": "https://github.com/urxp/dRally",
      "repository": "https://github.com/pkgforge-dev/dRally-AppImage",
      "keywords": [
        "death rally",
        "racing",
        "vehicular combat",
        "remedy",
        "source port",
        "sdl2",
        "retro gaming",
        "arcade"
      ],
      "categories": [
        "Game",
        "2DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/drally.png",
      "screenshots": [
        {
          "caption": "dRally interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/dRally-AppImage"
  },
  "sandbox": {
