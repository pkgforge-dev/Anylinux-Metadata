      "name": "cursor-cli",
      "summary": "Cursor CLI is the official command-line interface for the Cursor AI code editor ecosystem",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Cursor CLI is the official command-line interface for the Cursor AI code editor ecosystem. It provides terminal-based developer tools to interact with Cursor's AI models, search codebases, and manage background coding sessions."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Direct command-line interaction with advanced AI programming models"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast repository indexing and codebase-wide semantic search capabilities"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless terminal workflows for asking questions and generating code diffs"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integration with local developer environments and CI/CD pipelines"
              }
            ],
            [
              {
                "type": "text",
                "value": "Rapid access to project context and documentation summaries"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
