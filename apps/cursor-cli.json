{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.cursor.cursor_cli",
      "name": "cursor-cli",
      "summary": "Command-line interface for the Cursor AI code editor ecosystem",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Cursor CLI provides command-line access to the Cursor AI-powered coding environment. It allows developers to interact with Cursor services, manage editor sessions, and integrate Cursor features directly from the terminal."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Seamless integration with the Cursor AI code editor workflow"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully portable and standalone bundle compatible with standard and musl-based Linux distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Runs without requiring FUSE installed on the host system"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated update notifications and self-updater support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automatic integration and interoperability with Linux package managers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "cursor-cli Developers",
        "url": "https://cursor.com/cli"
      },
      "homepage": "https://cursor.com/cli",
      "repository": "https://github.com/pkgforge-dev/cursor-cli-AppImage",
      "keywords": [
        "cursor",
        "terminal",
        "cli",
        "editor",
        "developer",
        "ai",
        "coding",
        "programming"
      ],
      "categories": [
        "Development",
        "Utility",
        "IDE",
        "TextTools"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/cursor-cli.png",
      "screenshots": [
        {
          "caption": "cursor-cli interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/cursor-cli-AppImage"
  },
  "sandbox": {
