{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.dscharrer.innoextract",
      "name": "innoextract",
      "summary": "Extract files from Inno Setup installers without Wine",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "innoextract is a tool designed to unpack installers created by Inno Setup under non-Windows systems without running Wine. It provides a clean, native way to inspect and extract application data, games, and patches directly from Windows installer executables."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Beyond standard Inno Setup setups, it handles custom installer variants and provides full extraction support across a broad range of versions."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Supports installers created by Inno Setup versions 1.2.10 through 6.3.3"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extracts GOG.com game installers and Wadjet Eye Games packages"
              }
            ],
            [
              {
                "type": "text",
                "value": "Supports Martijn Laan's My Inno Setup Extensions versions 1.3.10 to 3.0.6.1"
              }
            ],
            [
              {
                "type": "text",
                "value": "Handles multi-part installers, encrypted archives, and LZMA compression"
              }
            ],
            [
              {
                "type": "text",
                "value": "Unpacks patch executables such as Arx Fatalis patches for native Linux engines"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "innoextract Developers",
        "url": "https://github.com/dscharrer/innoextract"
      },
      "homepage": "https://github.com/dscharrer/innoextract",
      "repository": "https://github.com/pkgforge-dev/innoextract-AppImage",
      "keywords": [
        "inno",
        "setup",
        "installer",
        "extractor",
        "unpack",
        "decompress",
        "archive",
        "gog"
      ],
      "categories": [
        "Utility",
        "PackageManager"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/innoextract.png",
      "screenshots": [
        {
          "caption": "innoextract interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/innoextract-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
