{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.grumpycoders.pcsx_redux",
      "name": "PCSX-Redux",
      "summary": "Modern, modular PlayStation 1 emulator designed for reverse engineering and development",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "PCSX-Redux is a modernized fork of the PCSX PlayStation 1 emulator, reimagined as a monolithic and modular platform tailored for homebrew development, reverse engineering, and gaming. Built on OpenGL 3+ and Dear ImGui, it offers a portable, modern interface alongside deep inspection capabilities."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By replacing legacy plugin architectures with a cohesive codebase, PCSX-Redux delivers advanced debugging, memory inspection, and high-fidelity rendering tools for PlayStation enthusiasts and programmers alike."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Monolithic core design replacing outdated plugin systems for all emulation subsystems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modernized user interface written on top of OpenGL 3+ and ImGui for enhanced portability"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive integrated debugging and reverse-engineering toolset"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced graphics rendering and visual output options"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in OpenBIOS support allowing games to boot without requiring a retail BIOS"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "GrumpyCoders",
        "url": "https://github.com/grumpycoders"
      },
      "homepage": "https://github.com/grumpycoders/pcsx-redux",
      "repository": "https://github.com/grumpycoders/pcsx-redux",
      "keywords": [
        "playstation",
        "psx",
        "ps1",
        "emulator",
        "debugger",
        "reverse-engineering",
        "openbios",
        "imgui",
        "mips"
      ],
      "categories": [
        "Development",
        "Game",
        "Debugger",
        "IDE"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/pcsx-redux.png",
      "screenshots": [
        {
          "caption": "PCSX-Redux interactive debugger and memory inspection interface",
          "source": "https://pcsx-redux.consoledev.net/images/debugger1.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/PCSX-Redux-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
