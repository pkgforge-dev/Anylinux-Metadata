{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.claude.claude_desktop",
      "name": "claude-desktop",
      "summary": "AI assistant desktop application with Model Context Protocol integration and Linux system enhancements",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Claude Desktop is an AI assistant application repackaged for broader Linux ecosystem compatibility. Based on Anthropic's official client, it provides an intelligent conversational workspace optimized with Linux-tailored launcher capabilities and hardware integrations."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed to accommodate diverse desktop environments and display servers, the client incorporates environment diagnosis tools and automated recovery features to ensure dependable execution."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Full Model Context Protocol (MCP) integration configured via JSON"
              }
            ],
            [
              {
                "type": "text",
                "value": "Opt-in native Wayland support and display server compatibility flags"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in diagnostic tooling to verify permissions, display settings, and sandbox state"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automatic GPU crash recovery and autostart configuration healing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Hardware virtualization support for Cowork environments on Linux"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "claude-desktop Developers",
        "url": "https://claude.com/"
      },
      "homepage": "https://claude.com/",
      "repository": "https://github.com/aaddrick/claude-desktop-debian",
      "keywords": [
        "anthropic",
        "assistant",
        "chatbot",
        "mcp",
        "llm",
        "artificial intelligence",
        "wayland",
        "productivity"
      ],
      "categories": [
        "Utility",
        "Office",
        "Chat",
        "TextTools"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/claude-desktop.png",
      "screenshots": [
        {
          "caption": "Claude Desktop chat workspace interface",
          "source": "https://raw.githubusercontent.com/aaddrick/claude-desktop-debian/main/docs/images/claude-desktop-screenshot1.png"
        },
        {
          "caption": "Claude Desktop conversation and settings view",
          "source": "https://raw.githubusercontent.com/aaddrick/claude-desktop-debian/main/docs/images/claude-desktop-screenshot2.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Claude-Desktop-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
