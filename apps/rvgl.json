{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.rvgl.rvgl",
      "name": "RVGL",
      "summary": "Cross-platform, enhanced rewrite of the classic radio-controlled car racing game Re-Volt",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "RVGL is a modern, cross-platform port and enhanced rewrite of the classic 1999 radio-controlled car racing game Re-Volt. Built upon modern graphics and audio APIs, it brings the fast-paced arcade racing experience to modern operating systems with wide display support and performance improvements."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged with portable runtime dependencies, this release delivers a frictionless standalone experience that retains full compatibility across diverse Linux environments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Faithful recreation of the original Re-Volt physics, tracks, and vehicles"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modernized graphics engine with widescreen, high-resolution, and 60+ FPS support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable packaging running without requiring FUSE"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated update notification system with automatic checks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive compatibility across modern and legacy Linux distributions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "RVGL Developers",
        "url": "https://rvgl.org/"
      },
      "homepage": "https://rvgl.org/",
      "repository": "https://github.com/pkgforge-dev/RVGL-AppImage",
      "keywords": [
        "revolt",
        "racing",
        "arcade",
        "rc cars",
        "cars",
        "motorsport",
        "classic"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/rvgl.png",
      "screenshots": [
        {
          "caption": "RVGL interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/RVGL-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
