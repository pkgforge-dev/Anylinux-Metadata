{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.cuberite.cuberite",
      "name": "Cuberite",
      "summary": "Lightweight and high-performance Minecraft-compatible multiplayer game server written in C++",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Cuberite is a fast, custom Minecraft-compatible multiplayer server written in C++. Designed from the ground up to be efficient with memory and CPU usage, it provides a lightweight alternative to the official server software while maintaining compatibility with the Minecraft Java Edition client."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "With support extending from standard desktop systems to low-power devices like Raspberry Pis and Android hardware, Cuberite offers exceptional efficiency alongside an extensible Lua scripting environment."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Compatible with Minecraft Java Edition clients across release versions 1.8 through 1.12.2"
              }
            ],
            [
              {
                "type": "text",
                "value": "Highly optimized C++ architecture minimizing CPU utilization and memory footprint"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensible Lua plugin API for developing custom game mechanics and administrative features"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform support suitable for standard servers, single-board computers, and embedded devices"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automated build and compilation support with comprehensive dependency verification"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Cuberite Developers",
        "url": "https://github.com/cuberite/cuberite"
      },
      "homepage": "https://github.com/cuberite/cuberite",
      "repository": "https://github.com/pkgforge-dev/Cuberite-AppImage",
      "keywords": [
        "minecraft",
        "server",
        "multiplayer",
        "voxel",
        "sandbox",
        "lua",
        "game server"
      ],
      "categories": [
        "Game",
        "Network"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/cuberite.png",
      "screenshots": [
        {
          "caption": "Cuberite interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Cuberite-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
