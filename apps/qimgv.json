{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.easymodo.qimgv",
      "name": "qimgv",
      "summary": "Fast and configurable image viewer with video playback support",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "qimgv is a lightweight, fast, and highly customizable image viewer built with Qt. Designed with a clean, uncluttered interface that stays out of your way, it provides quick navigation, smooth scaling, and efficient file management tools."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "In addition to static images, qimgv includes optional video playback powered by libmpv and allows users to trigger custom shell scripts directly from the viewer."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High-quality image scaling with customizable fit modes and zooming"
              }
            ],
            [
              {
                "type": "text",
                "value": "Basic image editing capabilities including crop, rotate, and resize"
              }
            ],
            [
              {
                "type": "text",
                "value": "Quick copy and move panels with configurable target folders"
              }
            ],
            [
              {
                "type": "text",
                "value": "Folder view mode and pull-down thumbnail panel for intuitive navigation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Experimental video playback via libmpv integration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensible workflow with custom shell script and command execution"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-only",
      "developer": {
        "name": "qimgv Developers",
        "url": "https://github.com/easymodo/qimgv"
      },
      "homepage": "https://github.com/easymodo/qimgv",
      "repository": "https://github.com/pkgforge-dev/Qimgv-AppImage",
      "keywords": [
        "image viewer",
        "photo viewer",
        "gallery",
        "qt",
        "libmpv",
        "slideshow",
        "crop",
        "resize"
      ],
      "categories": [
        "Graphics",
        "Viewer",
        "2DGraphics",
        "Photography"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/qimgv.png",
      "screenshots": [
        {
          "caption": "Main viewer window with thumbnail panel",
          "source": "https://raw.githubusercontent.com/easymodo/qimgv/master/qimgv/distrib/screenshots/qimgv0.9_1_thumb.jpg"
        },
        {
          "caption": "Folder browsing view mode",
          "source": "https://raw.githubusercontent.com/easymodo/qimgv/master/qimgv/distrib/screenshots/qimgv0.9_2_thumb.jpg"
        },
        {
          "caption": "Application preferences and settings window",
          "source": "https://raw.githubusercontent.com/easymodo/qimgv/master/qimgv/distrib/screenshots/qimgv_3_thumb.jpg"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Qimgv-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
