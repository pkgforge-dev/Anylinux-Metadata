{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "net.sourceforge.foobillardplus",
      "name": "FooBillard++",
      "summary": "Play 3D billiards, pool, and snooker with realistic physics and tournament modes",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "FooBillard++ is an advanced 3D OpenGL cue sports game that delivers realistic ball physics, reflections, and immersive table gameplay. Building upon the classic FooBillard codebase, it provides players with an authentic simulation of various pool, carom, and snooker disciplines."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Featuring both single-player challenges against AI opponents and local competition, the game offers configurable table dimensions, customizable cue perspectives, and detailed trajectory controls."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Multiple cue sport game modes including 8-ball, 9-ball, carom, and snooker"
              }
            ],
            [
              {
                "type": "text",
                "value": "Realistic rigid-body collision physics, ball spin, and table friction models"
              }
            ],
            [
              {
                "type": "text",
                "value": "Hardware-accelerated OpenGL 3D graphics with detailed shading and reflections"
              }
            ],
            [
              {
                "type": "text",
                "value": "Adjustable AI difficulty levels for tournament and exhibition matches"
              }
            ],
            [
              {
                "type": "text",
                "value": "Flexible camera angles including bird's-eye overhead and free-look cue views"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-2.0-or-later",
      "developer": {
        "name": "FooBillard++ Team",
        "url": "https://foobillardplus.sourceforge.net"
      },
      "homepage": "https://foobillardplus.sourceforge.net",
      "repository": "https://sourceforge.net/projects/foobillardplus",
      "keywords": [
        "billiards",
        "pool",
        "snooker",
        "carom",
        "physics",
        "simulation",
        "opengl",
        "tournament"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/foobillard.png",
      "screenshots": [
        {
          "caption": "FooBillard++ interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
