{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.opendriver2.redriver2",
      "name": "REDRIVER2",
      "summary": "Reverse-engineered native PC port of the classic PlayStation driving game Driver 2",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "REDRIVER2 is an open-source, reverse-engineered native port of Driver 2, the classic 2000 PlayStation action driving game by Reflections Interactive. Rather than relying on emulation, the original MIPS binary was completely disassembled and translated into clean C, running natively on modern platforms via the Psy-Cross compatibility layer."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This rebuild enhances the classic console experience with bug fixes, restored gameplay elements, and modern system compatibility while preserving original physics and vehicle handling."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Fully native reimplementation translated from MIPS machine code back to C without PlayStation emulation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fixes numerous glitches and bugs present in the original PlayStation release"
              }
            ],
            [
              {
                "type": "text",
                "value": "Restores and completes unfinished gameplay aspects from the original game"
              }
            ],
            [
              {
                "type": "text",
                "value": "Utilizes the Psy-Cross hardware abstraction layer for cross-platform rendering and input"
              }
            ],
            [
              {
                "type": "text",
                "value": "Includes modding support with custom texture and 3D model replacement via OpenDriver2Tools"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "REDRIVER2 Developers",
        "url": "https://github.com/OpenDriver2/REDRIVER2"
      },
      "homepage": "https://github.com/OpenDriver2/REDRIVER2",
      "repository": "https://github.com/pkgforge-dev/REDRIVER2-AppImage",
      "keywords": [
        "driver",
        "driving",
        "racing",
        "decompilation",
        "reverse engineering",
        "playstation",
        "psx",
        "action"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/redriver2.png",
      "screenshots": [
        {
          "caption": "REDRIVER2 running in-game action on desktop",
