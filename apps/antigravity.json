{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "google.antigravity.antigravity",
      "name": "Antigravity",
      "summary": "Agentic AI coding assistant designed to accelerate software development and pair programming workflows",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Antigravity is an advanced agentic AI coding assistant created by Google DeepMind to augment software engineering. It provides an intelligent pair-programming environment capable of code generation, multi-file refactoring, debugging, and task automation directly on your system."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged with portable runtime dependencies, this release delivers a frictionless standalone developer experience across Linux distributions without external system setup."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Agentic pair-programming workflows for deep codebase understanding and code generation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated terminal and autonomous tool usage for automated debugging and testing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable packaging that runs without requiring FUSE or root privileges"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless background update notifications with automatic package manager detection"
              }
            ],
            [
              {
                "type": "text",
                "value": "Broad compatibility across glibc and musl-based Linux distributions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Antigravity Developers",
        "url": "https://antigravity.google/download https://antigravity.google"
      },
      "homepage": "https://antigravity.google/download https://antigravity.google",
      "repository": "https://github.com/pkgforge-dev/Antigravity-AppImage",
      "keywords": [
        "ai",
        "assistant",
        "coding",
        "developer",
        "deepmind",
        "programming",
        "automation",
        "debugger"
      ],
      "categories": [
        "Development",
        "IDE",
        "Debugger",
        "Building"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/antigravity.png",
      "screenshots": [
        {
          "caption": "Antigravity interface screenshot 1",
