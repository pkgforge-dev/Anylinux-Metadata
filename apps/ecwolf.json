{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.bitbucket.ecwolf",
      "name": "ECWolf",
      "summary": "Advanced open-source port for Wolfenstein 3D, Spear of Destiny, and Super 3D Noah's Ark",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ECWolf is an advanced open-source source port based on the Wolfenstein 3D engine, bringing modern enhancements and broad platform compatibility to classic first-person shooters including Wolfenstein 3D, Spear of Destiny, and Super 3D Noah's Ark."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged with an embedded runtime for wide compatibility across Linux distributions, it loads custom and original game data files directly from local user directories."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Compatibility with Wolfenstein 3D, Spear of Destiny, and Super 3D Noah's Ark game data"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automatic game asset discovery and loading from standard user data directories"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for modern screen resolutions, aspect ratios, and enhanced controls"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable execution without requiring root privileges or system FUSE support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated update notifications and compatibility with popular package managers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ECWolf Developers",
        "url": "https://bitbucket.org/ecwolf/ecwolf"
      },
      "homepage": "https://bitbucket.org/ecwolf/ecwolf",
      "repository": "https://github.com/pkgforge-dev/ECWolf-AppImage",
      "keywords": [
        "wolfenstein",
        "fps",
        "shooter",
        "retro",
        "classic",
        "source port",
        "spear of destiny",
        "id software"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/ecwolf.png",
      "screenshots": [
        {
          "caption": "ECWolf interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ECWolf-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
