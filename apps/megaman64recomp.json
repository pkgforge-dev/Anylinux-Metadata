  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.megaman64recomp.megaman64recompiled_megaman64recomp",
      "name": "Mega Man 64 Recompiled",
      "summary": "Native PC port of Mega Man 64 created through static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Mega Man 64 Recompiled is an enhanced native PC port of the classic Nintendo 64 action-adventure title Mega Man 64 (Mega Man Legends), built using modern static recompilation technology. It translates original N64 binary code into native instructions to deliver optimized performance without conventional emulation overhead."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The project enhances the classic 3D exploration and combat gameplay with native desktop integration, higher fidelity rendering, and customizable controls suited for modern systems."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native x86_64 execution via static binary recompilation"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-resolution rendering with modern display aspect ratio support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fluid frame rates without standard Nintendo 64 emulation latency"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern gamepad support and customizable keyboard controls"
              }
            ],
            [
              {
                "type": "text",
                "value": "Faithful recreation of the original Kattelox Island adventure"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Mega Man 64 Recompiled Developers",
        "url": "https://github.com/MegaMan64Recomp/MegaMan64Recompiled"
      },
      "homepage": "https://github.com/MegaMan64Recomp/MegaMan64Recompiled",
      "repository": "https://github.com/pkgforge-dev/megaman64recomp-appimage",
      "keywords": [
        "megaman",
        "rockman",
        "recompiled",
        "n64",
        "port",
        "static recompilation",
        "legends",
        "action"
      ],
