{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.harbourmasters.spaghettikart",
      "name": "SpaghettiKart",
      "summary": "Native PC port of Mario Kart 64 featuring modern graphics enhancements and modding support",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "SpaghettiKart is a native PC port of Mario Kart 64 created by the Harbour Masters team. Designed to run on modern systems without traditional emulation overhead, it allows players to experience the classic kart racing title with modern rendering enhancements, customizable controls, and native system integration."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The port requires a legally dumped original US ROM to generate modern asset archives, ensuring clean separation of proprietary game assets while providing extensive flexibility for user-created content and customization."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native cross-platform rendering backends including OpenGL and DirectX 11"
              }
            ],
            [
              {
                "type": "text",
                "value": "Widescreen resolution and high framerate rendering capabilities"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive gamepad and keyboard input mapping via SDL"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modding support through custom .o2r and zipped asset packages"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automated asset extraction directly from original N64 ROM dumps"
              }
            ]
          ]
        }
      ],
      "projectLicense": "CC0-1.0",
      "developer": {
        "name": "Harbour Masters",
        "url": "https://www.harbourmasters.org"
      },
      "homepage": "https://github.com/HarbourMasters/SpaghettiKart",
      "repository": "https://github.com/HarbourMasters/SpaghettiKart",
      "keywords": [
        "mariokart",
        "n64",
        "kart",
        "racing",
        "port",
        "opengl",
        "gamepad",
        "decompilation"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/spaghettikart.png",
      "screenshots": [
        {
          "caption": "SpaghettiKart interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/SpaghettiKart-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
