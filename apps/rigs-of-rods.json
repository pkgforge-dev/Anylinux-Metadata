{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rigsofrods.rigs_of_rods",
      "name": "Rigs of Rods",
      "summary": "Open-source vehicle simulator featuring an advanced soft-body physics engine",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Rigs of Rods is an open-source physics sandbox simulation game that simulates the motion and deformation of vehicles in real time. It offers a flexible and powerful simulation environment supporting vehicles, physical objects, and terrain deformation."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The simulation accommodates a wide variety of control setups and gameplay modes, from casual exploration to community-driven multiplayer sessions."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Diverse vehicle roster including cars, trucks, trains, boats, airplanes, helicopters, and heavy machinery"
              }
            ],
            [
              {
                "type": "text",
                "value": "Soft-body real-time physics simulating realistic structural damage and chassis flexing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Flexible control options ranging from keyboard driving to gamepads, steering wheels, and pedal sets"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in mod repository browser for discovering and installing community-created vehicles and terrains"
              }
            ],
            [
              {
                "type": "text",
                "value": "AngelScript scripting integration for vehicle part customization and gameplay logic"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiplayer support with dedicated servers and an integrated server browser"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Rigs of Rods Developers",
        "url": "https://github.com/RigsOfRods/rigs-of-rods"
      },
      "homepage": "https://github.com/RigsOfRods/rigs-of-rods",
      "repository": "https://github.com/pkgforge-dev/Rigs-of-Rods-AppImage",
      "keywords": [
        "simulator",
        "simulation",
        "physics",
        "softbody",
        "driving",
        "vehicles",
        "sandbox",
        "multiplayer"
      ],
      "categories": [
        "Game",
        "Simulation"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/rigs-of-rods.png",
      "screenshots": [
        {
          "caption": "Rigs of Rods interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
