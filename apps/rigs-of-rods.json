{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rigsofrods.rigs_of_rods",
      "name": "Rigs of Rods",
      "summary": "Rigs of Rods is an open-source vehicle simulator featuring an advanced soft-body physics engine",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Rigs of Rods is an open-source vehicle simulator featuring an advanced soft-body physics engine. Unlike traditional rigid-body simulators, Rigs of Rods simulates the real-time deformation and stress of chassis, beams, and suspension components."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Realistic soft-body physics simulating structural flex, crashes, and metal deformation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Diverse vehicle simulation including land vehicles, trucks, construction machinery, aircraft, and boats"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dynamic terrain interaction with mud, sand, water, and varying friction coefficients"
              }
            ],
            [
              {
                "type": "text",
                "value": "Massive community catalog of downloadable vehicles, terrains, and scenario mods"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for force-feedback steering wheels, joysticks, and modern game controllers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Rigs of Rods Developers",
        "url": "https://github.com/RigsOfRods/rigs-of-rods"
      },
      "homepage": "https://github.com/RigsOfRods/rigs-of-rods",
      "repository": "https://github.com/pkgforge-dev/Rigs-of-Rods-AppImage",
      "keywords": [
        "rigs-of-rods",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "Simulation",
        "Physics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/rigs-of-rods.png",
      "screenshots": [
        {
          "caption": "Rigs of Rods interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
