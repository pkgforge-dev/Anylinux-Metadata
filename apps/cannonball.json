{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.djyt.cannonball",
      "name": "Cannonball",
      "summary": "Enhanced open-source engine rewrite of the classic OutRun arcade driving game",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Cannonball is an enhanced, open-source C++ game engine rewrite of Yu Suzuki's classic 1986 arcade racing game OutRun. Built using SDL 2 and modern C++, it completely replaces the original Motorola 68000 and Z80 assembly code while preserving authentic arcade logic and delivering modern enhancements."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine requires the original OutRun revision B arcade ROM files for audio and visual assets, modernizing the gameplay experience with improved performance and contemporary display capabilities."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Complete C++ rewrite of the original 68000 and Z80 arcade assembler codebase"
              }
            ],
            [
              {
                "type": "text",
                "value": "Smooth 60 FPS gameplay and enhanced high frame-rate rendering support"
              }
            ],
            [
              {
                "type": "text",
                "value": "True widescreen display modes alongside original 4:3 arcade aspect ratios"
              }
            ],
            [
              {
                "type": "text",
                "value": "Flexible hardware-accelerated rendering via OpenGL, OpenGLES, or SDL2"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive XML-based configuration for custom controller mappings, video options, and ROM paths"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Cannonball Developers",
        "url": "https://github.com/djyt/cannonball"
      },
      "homepage": "https://github.com/djyt/cannonball",
      "repository": "https://github.com/pkgforge-dev/Cannonball-AppImage",
      "keywords": [
        "outrun",
        "arcade",
        "racing",
        "driving",
        "engine",
        "sega",
        "retro",
        "sdl2",
        "opengl"
      ],
      "categories": [
        "Game",
        "2DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/cannonball.png",
      "screenshots": [
        {
          "caption": "Cannonball interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Cannonball-AppImage"
  },
  "sandbox": {
