{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.yarl.pattypan",
      "name": "Pattypan",
      "summary": "Upload media files in bulk to Wikimedia Commons for GLAM projects",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Pattypan is an open-source desktop utility built with Java and JavaFX designed to simplify bulk media uploading to Wikimedia Commons. Developed with support from a Wikimedia Foundation grant, it is tailored for GLAM (galleries, libraries, archives, and museums) institutions and volunteers working with large file collections."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Batch upload images and media files directly to Wikimedia Commons"
              }
            ],
            [
              {
                "type": "text",
                "value": "Structured metadata generation and spreadsheet-driven workflow"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for custom target wikis, protocols, and test server instances"
              }
            ],
            [
              {
                "type": "text",
                "value": "Streamlined interface optimized for GLAM cultural heritage collections"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Pattypan Developers",
        "url": "https://github.com/yarl/pattypan"
      },
      "homepage": "https://github.com/yarl/pattypan",
      "repository": "https://github.com/pkgforge-dev/pattypan-appimage",
      "keywords": [
        "wikimedia",
        "commons",
        "glam",
        "uploader",
        "batch",
        "media",
        "upload",
        "metadata"
      ],
      "categories": [
        "Network",
        "FileTransfer",
        "Publishing"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/pattypan.png",
      "screenshots": [
        {
          "caption": "Pattypan interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Pattypan-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
