{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pixelguys.cubyz",
      "name": "Cubyz",
      "summary": "3D open-source voxel sandbox game featuring procedurally generated worlds with unlimited height and depth",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Cubyz is an open-source 3D voxel sandbox game written in Zig that focuses on deep procedural generation and performance. Taking inspiration from classic block-building sandbox titles, it utilizes OpenGL 4.3 to deliver expansive, customizable worlds with extreme verticality and high rendering efficiency."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine is architected around true three-dimensional chunking and extensive procedural systems, allowing players to explore seamless landscapes and craft custom equipment without standard architectural limitations."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Level of Detail (LoD) rendering enabling expansive view distances across the landscape"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full 3D chunk architecture removing traditional height and depth limits for subterranean and sky exploration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Procedural tool crafting system providing vast possibilities for combinations and equipment"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-performance native core written in Zig leveraging modern OpenGL graphics"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Cubyz Developers",
        "url": "https://github.com/PixelGuys/Cubyz"
      },
      "homepage": "https://github.com/PixelGuys/Cubyz",
      "repository": "https://github.com/pkgforge-dev/cubyz-appimage",
      "keywords": [
        "voxel",
        "sandbox",
        "procedural",
        "crafting",
        "opengl",
        "zig",
        "mining",
        "building"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/cubyz.png",
      "screenshots": [
        {
          "caption": "Cubyz interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Cubyz-AppImage"
  },
  "sandbox": {
