{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.evilsocket.opensnitch",
      "name": "OpenSnitch",
      "summary": "GNU/Linux application firewall providing real-time outbound connection alerts and rule management",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "OpenSnitch is a GNU/Linux application firewall designed to monitor, prompt, and control outbound network connections initiated by running applications. It provides real-time visibility into process network activity, giving users complete oversight and control over system traffic."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Interactive filtering and prompt alerts for outgoing application network connections"
              }
            ],
            [
              {
                "type": "text",
                "value": "System-wide domain block lists to stop ads, trackers, and malware"
              }
            ],
            [
              {
                "type": "text",
                "value": "System firewall configuration powered by nftables directly from the graphical interface"
              }
            ],
            [
              {
                "type": "text",
                "value": "Centralized GUI support for monitoring and managing multiple remote nodes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integration capabilities with SIEM systems for enterprise network auditing"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Simone Margaritelli",
        "url": "https://github.com/evilsocket"
      },
      "homepage": "https://github.com/evilsocket/opensnitch",
      "repository": "https://github.com/evilsocket/opensnitch",
      "keywords": [
        "firewall",
        "network",
        "security",
        "nftables",
        "monitoring",
        "traffic",
        "connections"
      ],
      "categories": [
        "Network",
        "System"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/opensnitch.png",
      "screenshots": [
        {
          "caption": "OpenSnitch network connection monitor and active rules management interface",
          "source": "https://user-images.githubusercontent.com/2742953/85205382-6ba9cb00-b31b-11ea-8e9a-bd4b8b05a236.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/OpenSnitch-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
