{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.zaps166.nfsiise",
      "name": "Need For Speed II SE",
      "summary": "Modern open-source wrapper and port for Need for Speed II: Special Edition",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Need for Speed II SE is a modern cross-platform open-source port and wrapper for the classic 1997 racing game Need for Speed II: Special Edition. Powered by SDL2 and hardware-accelerated rendering, it enables the original title to run seamlessly on contemporary operating systems while preserving original gameplay physics and assets."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Hardware-accelerated 3D rendering with support for OpenGL 1, OpenGL 2, and OpenGL ES 2"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modernized cross-platform audio, input, and display handling via SDL2"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for TCP protocol networking alongside classic multiplayer modes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multi-architecture compatibility with support for x86 and 32-bit ARM platforms"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Need For Speed II SE Developers",
        "url": "https://github.com/zaps166/NFSIISE"
      },
      "homepage": "https://github.com/zaps166/NFSIISE",
      "repository": "https://github.com/pkgforge-dev/NFSIISE-AppImage",
      "keywords": [
        "racing",
        "arcade",
        "cars",
        "opengl",
        "sdl2",
        "wrapper",
        "port",
        "tcp"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/nfsiise.png",
      "screenshots": [
        {
          "caption": "Need for Speed II SE gameplay showing McLaren F1 racing with 3D hardware acceleration",
          "source": "https://raw.githubusercontent.com/zaps166/GitHubCommonContents/master/Screenshots/NFSIISE.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/NFSIISE-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
