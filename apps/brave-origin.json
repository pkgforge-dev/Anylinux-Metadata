{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.brave.brave_browser_brave_origin",
      "name": "Brave Origin",
      "summary": "Fast, stripped-down variant of the Brave web browser focused on privacy and performance",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Brave Origin is a streamlined, debloated variant of the Brave web browser designed to deliver a lightweight and privacy-centric browsing experience. Built on Chromium and the open-source brave-core engine, it focuses on fast page load times and reduced resource consumption while stripping out unnecessary bundled components."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The browser retains essential web compatibility and robust security safeguards, offering an uncluttered environment ideal for daily web navigation and development work."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Stripped-down Chromium-based architecture for minimized memory footprint"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built on the open-source brave-core browser foundation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive protection following Brave security and release policies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive internationalization support with community translations"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless compatibility with modern web standards and devtools"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Brave Origin Developers",
        "url": "https://github.com/brave/brave-browser"
      },
      "homepage": "https://github.com/brave/brave-browser",
      "repository": "https://github.com/pkgforge-dev/Brave-Origin-AppImage",
      "keywords": [
        "browser",
        "web",
        "chromium",
        "privacy",
        "debloated",
        "lightweight",
        "internet",
        "navigator"
      ],
      "categories": [
        "Network",
        "WebBrowser"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/brave-origin.png",
      "screenshots": [
        {
          "caption": "Brave Origin interface screenshot 1",
          "source": "https://github.com/user-attachments/assets/e40de7aa-8605-4a81-9487-582f13f77f0c"
        },
        {
          "caption": "Brave Origin interface screenshot 2",
          "source": "https://github.com/user-attachments/assets/2e291e68-782d-4eeb-878e-a72f42b57867"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Brave-Origin-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
