{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.crenedecotret.vibeprint_vibeprint_studio",
      "name": "Vibeprint Studio",
      "summary": "ICC-aware print layout engine and graphical printing studio",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Vibeprint Studio is an open-source, color-managed print layout engine and graphical user interface built in Rust. It enables photographers, artists, and printmakers to prepare, preview, and output raster graphics with accurate ICC color profiling and high-resolution layout controls."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The software interfaces directly with CUPS print queues and standard Linux printing libraries, facilitating seamless print preparation workflows alongside removable device support for local file management."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "ICC-aware color management engine leveraging LittleCMS for precision profiling"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full integration with CUPS to discover and manage local and networked printers"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-resolution image processing and TIFF export with customizable DPI targets"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in crop, border, and image metadata inspection tools"
              }
            ],
            [
              {
                "type": "text",
                "value": "Removable device mount and file access integration via udisks2"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Vibeprint Studio Developers",
        "url": "https://github.com/crenedecotret/vibeprint"
      },
      "homepage": "https://github.com/crenedecotret/vibeprint",
      "repository": "https://github.com/pkgforge-dev/vibeprint-studio-appimage",
      "keywords": [
        "icc",
        "color-management",
        "cups",
        "printing",
        "layout",
        "raster",
        "tiff",
        "photography",
        "lcms2"
      ],
      "categories": [
        "Graphics",
        "Printing",
        "Photography",
        "Publishing"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/vibeprint-studio.png",
      "screenshots": [
        {
          "caption": "Vibeprint Studio interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Vibeprint-Studio-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
