{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.gitlab.sonicdcer.extremegrecomp",
      "name": "Extreme-G Recompiled",
      "summary": "Play the statically recompiled native PC port of the classic Extreme-G racing game",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Extreme-G Recompiled is an enhanced native PC port of the high-speed futuristic racing game Extreme-G, achieved through static recompilation of the original binary code to provide optimal modern performance and native compatibility."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package delivers seamless execution on modern Linux distributions without requiring system modifications, external emulators, or elevated runtime dependencies."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native executable execution via static binary recompilation"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-speed futuristic motorcycle racing with weapon combat"
              }
            ],
            [
              {
                "type": "text",
                "value": "FUSE-independent standalone portability across glibc and musl distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in automated update detection and notification system"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "sonicdcer",
        "url": "https://gitlab.com/sonicdcer"
      },
      "homepage": "https://gitlab.com/sonicdcer/ExtremeGRecomp",
      "repository": "https://gitlab.com/sonicdcer/ExtremeGRecomp",
      "keywords": [
        "racing",
        "recompiled",
        "port",
        "combat",
        "futuristic",
        "n64",
        "motorcycle"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/extremegrecomp.png",
      "screenshots": [
        {
          "caption": "Extreme-G Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
