{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.gitlab.sonicdcer.extremegrecomp",
      "name": "Extreme-G Recompiled",
      "summary": "Native PC port of Extreme-G created using static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Extreme-G Recompiled is a native PC port of the futuristic racing game Extreme-G, created through static recompilation of the original Nintendo 64 binary."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Players race futuristic superbikes along roller-coaster-style tracks at breakneck speeds with native rendering, ultra-wide display compatibility, and modern gamepads."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Full native PC compilation delivering smooth high framerates and fluid action"
              }
            ],
            [
              {
                "type": "text",
                "value": "Ultra-wide display rendering and customizable graphical fidelity settings"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-octane futuristic racing across looping and spiraling tracks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for modern game controllers with fine-tuned steering calibration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full digital audio and soundtrack playback with zero emulation stutter"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "sonicdcer",
        "url": "https://gitlab.com/sonicdcer"
      },
      "homepage": "https://gitlab.com/sonicdcer/ExtremeGRecomp",
      "repository": "https://gitlab.com/sonicdcer/ExtremeGRecomp",
      "keywords": [
        "extremegrecomp",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "SportsGame",
        "ArcadeGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/extremegrecomp.png",
      "screenshots": [
        {
          "caption": "Extreme-G Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ExtremeGRecomp-AppImage"
  },
  "sandbox": {
