{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.chipass.ChiPass",
      "name": "ChiPass",
      "summary": "Secure cross-platform password manager with desktop and browser integration",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ChiPass is a secure, cross-platform password manager built on Qt6 designed to keep your credentials safe and accessible. It delivers robust vault encryption and seamless desktop workflow integration."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "With integrated browser interoperability and an intuitive Qt-based interface, ChiPass provides a frictionless experience for managing passwords, secure notes, and personal data."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Cross-platform graphical interface built with modern Qt6"
              }
            ],
            [
              {
                "type": "text",
                "value": "Encrypted credential vaults for passwords and sensitive information"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless desktop integration and native system tray presence"
              }
            ],
            [
              {
                "type": "text",
                "value": "Browser integration support for quick credential autofill"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in update notification system to ensure prompt security fixes"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ChiPass Team",
        "url": "https://codeberg.org/ChiPass/ChiPass"
      },
      "homepage": "https://codeberg.org/ChiPass/ChiPass",
      "repository": "https://codeberg.org/ChiPass/ChiPass",
      "keywords": [
        "password manager",
        "passwords",
        "vault",
        "encryption",
        "credentials",
        "security",
        "qt6"
      ],
      "categories": [
        "Utility",
        "Security"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/chipass.png",
      "screenshots": [
        {
          "caption": "ChiPass interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
