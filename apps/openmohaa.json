{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.openmoh.openmohaa",
      "name": "OpenMoHAA",
      "summary": "Modern open-source reimplementation of Medal of Honor: Allied Assault",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "OpenMoHAA is an open-source game engine reimplementation of the landmark first-person shooter Medal of Honor: Allied Assault. It enables the classic game to run natively on modern operating systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine provides updated OpenGL rendering, modern audio backend support, high-resolution widescreen displays, and cross-platform multiplayer networking."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native Linux execution compatible with original Allied Assault retail assets"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modernized OpenGL graphics pipeline supporting 4K resolutions and arbitrary aspect ratios"
              }
            ],
            [
              {
                "type": "text",
                "value": "Spatial 3D positional audio powered by OpenAL and modern sound subsystems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full compatibility with single-player missions and expansion pack campaigns"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiplayer protocol improvements for robust LAN and internet match play"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-2.0-or-later",
      "developer": {
        "name": "OpenMoHAA Developers",
        "url": "https://github.com/openmoh/openmohaa"
      },
      "homepage": "https://github.com/openmoh/openmohaa",
      "repository": "https://github.com/openmoh/openmohaa",
      "keywords": [
        "openmohaa",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/openmohaa.png",
      "screenshots": [
        {
          "caption": "OpenMoHAA interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/OpenMoHAA-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
