{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.ladybird.ladybird",
      "name": "Ladybird",
      "summary": "Independent, open-source web browser and engine written from scratch in modern C++",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Ladybird is a truly independent, open-source web browser and rendering engine developed from scratch in modern C++. Built without relying on legacy browser engines, Ladybird aims to provide a fresh, standards-compliant alternative for exploring the modern web."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This package delivers a universal, self-contained executable build designed for high portability and compatibility across Linux distributions."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Independent rendering and JavaScript engine implemented entirely from scratch"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built using modern C++ for performance, modularity, and memory safety"
              }
            ],
            [
              {
                "type": "text",
                "value": "Universal Linux distribution compatibility, including musl-based systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Portable, standalone packaging requiring no system-wide modification"
              }
            ]
          ]
        }
      ],
      "projectLicense": "BSD-2-Clause",
      "developer": {
        "name": "Ladybird Developers",
        "url": "https://ladybird.org"
      },
      "homepage": "https://ladybird.org",
      "repository": "https://github.com/pkgforge-dev/ladybird-appimage",
      "keywords": [
        "browser",
        "web",
        "rendering engine",
        "html",
        "css",
        "javascript",
        "c++",
        "internet"
      ],
      "categories": [
        "Network",
        "WebBrowser"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/ladybird.png",
      "screenshots": [
        {
          "caption": "Ladybird interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ladybird-appimage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
