{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.spikehd.dorion",
      "name": "dorion",
      "summary": "Lightweight alternative Discord client optimized for low-spec PCs with theme and plugin support",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Dorion is an alternative Discord client built using Tauri, engineered specifically for low-specification or storage-sensitive computers. By replacing heavyweight Chromium runtimes with a native webview, it provides a snappier startup and a significantly reduced memory and storage footprint while retaining full voice, video, and text communication features."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The client focuses on performance and customizability, making Discord accessible on older machines without sacrificing modern messaging capabilities or user personalization."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Significantly reduced RAM and storage usage compared to the official client"
              }
            ],
            [
              {
                "type": "text",
                "value": "Snappier startup times powered by a native webview architecture"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in support for custom themes and visual styling"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensible plugin system for enhanced chat functionality"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full compatibility with standard Discord messaging, voice, and servers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "dorion Developers",
        "url": "https://github.com/SpikeHD/Dorion"
      },
      "homepage": "https://github.com/SpikeHD/Dorion",
      "repository": "https://github.com/pkgforge-dev/Dorion-AppImage-Enhanced",
      "keywords": [
        "discord",
        "chat",
        "messaging",
        "voip",
        "voice",
        "tauri",
        "lightweight",
        "themes",
        "plugins"
      ],
      "categories": [
        "Network",
        "InstantMessaging",
        "Chat",
        "VideoConference"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dorion.png",
