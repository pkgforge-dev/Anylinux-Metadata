{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "net.sourceforge.denise",
      "name": "Denise",
      "summary": "Emulate Commodore 64 and Amiga 500, 1000, and 2000 systems with cycle-accurate precision",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Denise is a cycle-accurate, open-source emulator targeting Commodore 64 and Commodore Amiga 500, 1000, and 2000 computers. Designed for accurate retrocomputing preservation, it provides clean audio and video reproduction alongside faithful hardware timing."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package delivers seamless execution across various Linux distributions without requiring FUSE or container overhead."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Cycle-accurate emulation of Commodore 64 architectures"
              }
            ],
            [
              {
                "type": "text",
                "value": "Faithful support for Amiga 500, 1000, and 2000 systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable execution with no external dependencies required"
              }
            ],
            [
              {
                "type": "text",
                "value": "FUSE-independent runtime environment"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in update notification and checking mechanisms"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Denise Developers",
        "url": "https://sourceforge.net/projects/deniseemu/"
      },
      "homepage": "https://sourceforge.net/projects/deniseemu/",
      "repository": "https://github.com/pkgforge-dev/denise-appimage",
      "keywords": [
        "commodore",
        "c64",
        "amiga",
        "emulator",
        "retrogaming",
        "retrocomputing",
        "cycle-accurate"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/denise.png",
      "screenshots": [
        {
          "caption": "Denise interface screenshot 1",
