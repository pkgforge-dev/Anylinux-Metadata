{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "net.riseup.riseup_vpn",
      "name": "RiseupVPN",
      "summary": "Easy-to-use and secure personal virtual private network service operated by the Riseup collective",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "RiseupVPN is a personal virtual private network (VPN) client designed to provide secure, encrypted internet access without logging traffic. Powered by the LEAP Bitmask VPN technology, it routes your network traffic through trusted servers to protect communications against censorship and surveillance."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The application runs out of the box with zero configuration required, allowing users to quickly connect and safeguard their online activity."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "One-click connection to secure Riseup-operated VPN gateways"
              }
            ],
            [
              {
                "type": "text",
                "value": "Encrypted network tunnels that safeguard traffic against snooping and censorship"
              }
            ],
            [
              {
                "type": "text",
                "value": "No-logging policy ensuring user activity remains private and anonymous"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-update capability to keep the client securely updated"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built on Bitmask technology with broad compatibility across Linux distributions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "RiseupVPN Developers",
        "url": "https://riseup.net/vpn"
      },
      "homepage": "https://riseup.net/vpn",
      "repository": "https://github.com/pkgforge-dev/Riseup-VPN-AppImage",
      "keywords": [
        "vpn",
        "privacy",
        "security",
        "encryption",
        "bitmask",
        "tunnel",
        "proxy",
        "anonymity"
      ],
      "categories": [
        "Network",
        "System",
        "RemoteAccess"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/riseup-vpn.png",
      "screenshots": [
        {
          "caption": "RiseupVPN interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Riseup-VPN-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
