{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.durasj.webamp_desktop",
      "name": "Webamp Desktop",
      "summary": "Reimplementation of Winamp 2 for modern desktop operating systems",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Webamp Desktop is a cross-platform desktop wrapper bringing the iconic Winamp 2 experience to modern operating systems. Powered by Webamp—the faithful HTML5 and JavaScript reimplementation of Winamp 2.91—it delivers the authentic retro audio player interface directly to your desktop environment."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The player combines classic media playback with modern web technologies, preserving original user interface behaviors and modular component windows."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Faithful recreation of the classic Winamp 2.91 interface and window layout"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modular player, equalizer, and playlist editor components"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for classic Winamp skins and customizable visual themes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Audio playback powered by modern HTML5 and JavaScript audio APIs"
              }
            ]
          ]
        }
      ],
      "projectLicense": "MIT",
      "developer": {
        "name": "Jakub Duras",
        "url": "https://github.com/durasj"
      },
      "homepage": "https://github.com/durasj/webamp-desktop",
      "repository": "https://github.com/durasj/webamp-desktop",
      "keywords": [
        "winamp",
        "player",
        "audio",
        "music",
        "equalizer",
        "skins",
        "retro",
        "media"
      ],
      "categories": [
        "AudioVideo",
        "Audio"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/webamp-desktop.png",
      "screenshots": [
        {
          "caption": "Webamp Desktop running on Linux with classic Winamp skin",
          "source": "https://raw.githubusercontent.com/durasj/webamp-desktop/master/res/screen-linux.png"
        },
        {
          "caption": "Webamp Desktop interface with player, equalizer, and playlist windows",
          "source": "https://raw.githubusercontent.com/durasj/webamp-desktop/master/res/screen-mac.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Webamp-Desktop-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
