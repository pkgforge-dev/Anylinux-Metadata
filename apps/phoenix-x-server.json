{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.dec05eba.git.phoenix_x_server",
      "name": "Phoenix X Server",
      "summary": "Modern X11 display server written from scratch in Zig",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Phoenix is a modern, lightweight X11 display server built from the ground up using the Zig programming language. It is designed to offer a fresh implementation of the X Window System protocol, prioritizing efficiency, simplicity, and low-level system control."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for maximum portability, it can run reliably across multiple Linux distributions without host dependencies or container setups."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Clean, from-scratch implementation of the core X11 protocol written in Zig"
              }
            ],
            [
              {
                "type": "text",
                "value": "Lightweight display server footprint for fast execution and minimal resource usage"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern systems-programming design focusing on safety and performance"
              }
            ],
            [
              {
                "type": "text",
                "value": "Standalone execution without requiring FUSE or container virtualization"
              }
            ],
            [
              {
                "type": "text",
                "value": "Broad compatibility across modern, legacy, and musl-based Linux distributions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Phoenix X Server Developers",
        "url": "https://git.dec05eba.com/phoenix"
      },
      "homepage": "https://git.dec05eba.com/phoenix",
      "repository": "https://github.com/pkgforge-dev/phoenix-x-server-AppImage",
      "keywords": [
        "x11",
        "xorg",
        "display server",
        "windowing",
        "zig",
        "graphics",
        "xserver"
      ],
      "categories": [
        "System",
        "Utility",
        "DesktopSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/phoenix-x-server.png",
      "screenshots": [
        {
          "caption": "Phoenix X Server interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/phoenix-x-server-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
