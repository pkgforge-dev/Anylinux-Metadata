{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.samueru_sama.playerctl_appimage_playerctl",
      "name": "playerctl",
      "summary": "Command-line controller and library for media players implementing the MPRIS D-Bus interface",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Playerctl is a comprehensive command-line utility and library designed to control media players that implement the MPRIS D-Bus interface specification. It provides a flexible interface to send playback commands, inspect player statuses, and track media events across a wide range of desktop audio and video players."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged as a fully portable, dependency-bundled binary that requires no external runtime configuration, it operates seamlessly across various Linux distributions and desktop environments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Standard playback controls including play, pause, toggle playback, stop, next, and previous"
              }
            ],
            [
              {
                "type": "text",
                "value": "Query and track metadata such as artist, album, title, track length, and playback status"
              }
            ],
            [
              {
                "type": "text",
                "value": "Position seeking and volume adjustment across active media players"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for selecting specific player instances or automatically managing all running MPRIS players"
              }
            ],
            [
              {
                "type": "text",
                "value": "Event-driven command execution to monitor status changes and track changes in real time"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "playerctl Developers",
        "url": "https://github.com/Samueru-sama/playerctl-AppImage"
      },
      "homepage": "https://github.com/Samueru-sama/playerctl-AppImage",
      "repository": "https://github.com/pkgforge-dev/playerctl-AppImage",
      "keywords": [
        "mpris",
        "dbus",
        "media",
        "playback",
        "controller",
        "audio",
        "cli"
      ],
      "categories": [
        "AudioVideo",
        "Audio"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/playerctl.png",
      "screenshots": [
        {
          "caption": "playerctl interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/playerctl-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
