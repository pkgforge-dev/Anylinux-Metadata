{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.nukeykt.rednukem",
      "name": "Rednukem",
      "summary": "Port of the BUILD engine games Redneck Rampage, Suckin' Portal, and Rides Again",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Rednukem is an open-source reverse-engineered port of the classic BUILD engine games Redneck Rampage, Redneck Rampage Rides Again, and Redneck Deer Huntin'. Based on EDuke32 technology, it brings authentic gameplay mechanics to modern operating systems with native 64-bit performance."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine focuses on faithful DOS-era behavior while providing contemporary conveniences such as high-resolution video modes, enhanced audio playback, and customizable input controls."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native 64-bit compatibility for modern Linux systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Accurate game logic reverse-engineered directly from original DOS executables"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for Redneck Rampage, Rides Again, Suckin' Portal, and Deer Huntin'"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-resolution widescreen video modes and modern display scaling"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced digital audio playback alongside classic MIDI sound support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Configurable modern keyboard, mouse, and game controller bindings"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Rednukem Developers",
        "url": "https://github.com/nukeykt/Rednukem"
      },
      "homepage": "https://github.com/nukeykt/Rednukem",
      "repository": "https://github.com/pkgforge-dev/Rednukem-AppImage",
      "keywords": [
        "build engine",
        "eduke32",
        "redneck rampage",
        "source port",
        "retro",
        "fps",
        "classic shooter",
        "dos"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/rednukem.png",
      "screenshots": [
        {
          "caption": "Rednukem interface screenshot 1",
          "source": "https://github.com/user-attachments/assets/e7650c88-3907-47c3-81eb-2fb012435ca2"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
