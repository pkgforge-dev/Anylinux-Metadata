{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "win.linuxping.git.12to11",
      "name": "12to11",
      "summary": "Run Wayland applications seamlessly on an X11 display server",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "12to11 is a display server bridge designed to run Wayland client applications directly on an X11 desktop environment. It translates Wayland protocols to X11 calls, enabling modern Wayland-exclusive software to integrate smoothly within existing X11 sessions."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Bridges Wayland-only client applications to X11 display servers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enables seamless window management and desktop integration under X11"
              }
            ],
            [
              {
                "type": "text",
                "value": "Translates Wayland surface rendering and input events directly to X11"
              }
            ],
            [
              {
                "type": "text",
                "value": "Operates without requiring full Wayland compositor sessions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "12to11 Developers",
        "url": "https://git.linuxping.win/12to11/12to11"
      },
      "homepage": "https://git.linuxping.win/12to11/12to11",
      "repository": "https://github.com/pkgforge-dev/12to11-AppImage",
      "keywords": [
        "wayland",
        "x11",
        "xorg",
        "display server",
        "bridge",
        "compatibility",
        "window management"
      ],
      "categories": [
        "System",
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/12to11.png",
      "screenshots": [
        {
          "caption": "12to11 interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/12to11-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
