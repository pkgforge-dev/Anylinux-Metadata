{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.nicoboss.nsz",
      "name": "nsz",
      "summary": "Compress and decompress Nintendo Switch packages losslessly using zstd",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "NSZ is an open-source compression and decompression tool designed for Nintendo Switch game dumps. Utilizing the zstandard (zstd) compression algorithm, it significantly reduces file sizes while ensuring completely lossless compression suitable for installation with supported homebrew title installers."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The tool preserves all built-in encryption and protection schemes without circumventing technological protection measures, requiring user-provided keys to process packages."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Lossless compression and decompression of Switch game packages using zstd"
              }
            ],
            [
              {
                "type": "text",
                "value": "Generates compressed formats fully compatible with NSW homebrew title installers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Provides both a graphical user interface and a flexible command-line interface"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automatic detection of standard hactool key locations across Linux configurations"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customizable runtime key loading options for flexible file management"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "nsz Developers",
        "url": "https://github.com/nicoboss/nsz"
      },
      "homepage": "https://github.com/nicoboss/nsz",
      "repository": "https://github.com/pkgforge-dev/NSZ-AppImage",
      "keywords": [
        "compression",
        "decompression",
        "zstd",
        "switch",
        "nintendo",
        "homebrew",
        "rom",
        "archiver"
      ],
      "categories": [
        "Utility",
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/nsz.png",
      "screenshots": [
        {
          "caption": "nsz interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/NSZ-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
