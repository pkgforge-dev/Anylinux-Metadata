{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "br.gov.receitafederal.itr2026",
      "name": "ITR 2026",
      "summary": "Prepare and submit the official Brazilian Rural Land Tax (ITR 2026) declaration",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ITR 2026 is the official software provided by the Brazilian Federal Revenue Service (Receita Federal) designed for the preparation, validation, and electronic submission of the Declaração do Imposto sobre a Propriedade Territorial Rural (DITR)."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for enhanced portability across Linux distributions, the application enables taxpayers and accountants to manage rural land declarations with embedded runtime components and zero external dependency friction."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Creation, editing, and verification of rural property tax declarations"
              }
            ],
            [
              {
                "type": "text",
                "value": "Official calculation of land tax liabilities according to Receita Federal rules"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated transmission of tax returns directly to government servers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Portable standalone execution without requiring root privileges or system FUSE"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in automated update notification system"
              }
            ]
          ]
        }
      ],
      "projectLicense": "LicenseRef-Proprietary",
      "developer": {
        "name": "Secretaria Especial da Receita Federal do Brasil",
        "url": "https://www.gov.br/receitafederal"
      },
      "homepage": "https://www.gov.br/receitafederal/pt-br/centrais-de-conteudo/download/pgd/ditr",
      "repository": "https://github.com/pkgforge-dev/ITR2026-AppImage",
      "keywords": [
        "receita federal",
        "ditr",
        "imposto de renda",
        "taxes",
        "tax declaration",
        "brazil",
        "accounting",
        "finance"
      ],
      "categories": [
        "Office",
        "Finance"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/itr2026.png",
      "screenshots": [
        {
          "caption": "ITR 2026 interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ITR2026-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
