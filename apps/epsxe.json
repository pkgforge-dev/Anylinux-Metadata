{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.epsxe.epsxe",
      "name": "ePSXe",
      "summary": "Play classic PlayStation 1 video games with high compatibility and plugin support",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ePSXe is a renowned PlayStation 1 (PSX/PS1) video game console emulator designed to deliver accurate emulation and high compatibility with original game discs and CD-ROM images on modern operating systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package bundles all essential runtime libraries, audio and video subsystems, and an integrated updater to ensure seamless execution across diverse Linux distributions without requiring external setup."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High compatibility with the expansive PlayStation 1 game library"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for optical discs as well as CD image formats like ISO, BIN/CUE, and IMG"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully self-contained runtime environment compatible with modern and legacy Linux distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated update checker with automated notifications for newer releases"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless execution without requiring root permissions or FUSE kernel modules"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ePSXe Developers",
        "url": "https://www.epsxe.com/"
      },
      "homepage": "https://www.epsxe.com/",
      "repository": "https://github.com/pkgforge-dev/ePSXe-AppImage",
      "keywords": [
        "playstation",
        "psx",
        "ps1",
        "emulator",
        "gaming",
        "retro",
        "classic",
        "console"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/epsxe.png",
      "screenshots": [
        {
          "caption": "ePSXe interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ePSXe-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
