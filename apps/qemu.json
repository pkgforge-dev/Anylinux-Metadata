{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.qemu.qemu",
      "name": "QEMU",
      "summary": "Generic and open-source machine emulator and virtualizer",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "QEMU is a generic, open-source machine emulator and virtualizer that enables users to run operating systems and programs made for one machine on an entirely different architecture, or achieve near-native performance through hardware-assisted virtualization."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package bundles complete system and user-mode emulation targets alongside key auxiliary utilities, requiring no FUSE runtime dependencies across diverse Linux environments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Hardware-assisted virtualization support with KVM acceleration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for UEFI, TPM, virtiofsd, audio, and GPU passthrough"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive multi-architecture emulation including x86, ARM, MIPS, PPC, and m68k"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in disk management and diagnostic utilities like qemu-img and qemu-io"
              }
            ],
            [
              {
                "type": "text",
                "value": "Network and specialized block storage drivers including SSH, NFS, iSCSI, and Gluster"
              }
            ],
            [
              {
                "type": "text",
                "value": "User-mode emulation capability for running foreign architecture Linux binaries"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "QEMU Developers",
        "url": "https://www.qemu.org/"
      },
      "homepage": "https://www.qemu.org/",
      "repository": "https://github.com/pkgforge-dev/QEMU-AppImage",
      "keywords": [
        "virtualization",
        "emulator",
        "kvm",
        "hypervisor",
        "virtual machine",
        "architecture",
        "uefi"
      ],
      "categories": [
        "System",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/qemu.png",
      "screenshots": [
        {
          "caption": "QEMU interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/QEMU-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
