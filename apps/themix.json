{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.github.themix_project.Oomox",
      "name": "Themix",
      "summary": "Design and generate customized desktop themes and icon packs",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Themix is a graphical theme designer that allows users to create, preview, and export customized desktop themes and icon suites across various Linux environments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Through an extensible plugin architecture, it facilitates effortless color scheme generation and styling across GTK, window managers, and diverse terminal and desktop applications."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Export custom Oomox and Materia themes for GTK2, GTK3, Cinnamon, GNOME, Openbox, and Xfwm"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customize icon themes including Archdroid, Gnome-Colors, Numix, Papirus, and Suru++"
              }
            ],
            [
              {
                "type": "text",
                "value": "Import and generate color schemes directly from image files and Xresources"
              }
            ],
            [
              {
                "type": "text",
                "value": "Leverage Base16 plugins to export themes for Alacritty, Emacs, GTK4, KDE, and Qt"
              }
            ],
            [
              {
                "type": "text",
                "value": "Include HiDPI scaling workarounds and CSS modifications for tiling window managers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Themix Project",
        "url": "https://github.com/themix-project"
      },
      "homepage": "https://github.com/themix-project/themix-gui",
      "repository": "https://github.com/themix-project/themix-gui",
      "keywords": [
        "theme",
        "theming",
        "gtk",
        "oomox",
        "materia",
        "icons",
        "base16",
        "palette",
        "customization"
      ],
      "categories": [
        "Settings",
        "DesktopSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/themix.png",
      "screenshots": [
        {
          "caption": "Themix graphical interface for customizing desktop theme colors",
          "source": "https://raw.githubusercontent.com/themix-project/oomox/master/screenshots/screenshot_gui.png"
        },
        {
          "caption": "Generating a color palette from an imported image",
          "source": "https://raw.githubusercontent.com/themix-project/oomox/master/screenshots/pokedex_dawn.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Themix-GUI-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
