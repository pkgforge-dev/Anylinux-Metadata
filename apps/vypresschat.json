{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.vyapin.vypresschat",
      "name": "Vypress Chat",
      "summary": "Real-time messaging application designed for local area network communication",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Vypress Chat is a dedicated real-time messaging application built for instant communication across local area networks (LANs). It facilitates seamless peer-to-peer and channel-based text chat without requiring an external internet connection or centralized server infrastructure."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for seamless execution on Linux environments via Wine compatibility, it provides robust local messaging capabilities tailored for home networks, offices, and isolated workgroups."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Real-time instant text messaging and chat channels across local area networks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Serverless peer-to-peer architecture operating independently of internet access"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable deployment compatible across diverse Linux distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated automatic update detection and notifications"
              }
            ]
          ]
        }
      ],
      "projectLicense": "LicenseRef-Proprietary",
      "developer": {
        "name": "Vyapin Software Systems",
        "url": "https://www.vyapinsoftware.com"
      },
      "homepage": "https://www.vyapinsoftware.com/products/vypress-chat",
      "repository": "https://github.com/pkgforge-dev/VypressChat-AppImage",
      "keywords": [
        "chat",
        "lan",
        "messaging",
        "instant messaging",
        "peer-to-peer",
        "local network",
        "communication"
      ],
      "categories": [
