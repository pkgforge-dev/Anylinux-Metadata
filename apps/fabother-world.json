{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.fabiensanglard.another_world_bytecode_interpreter_fabother_world",
      "name": "Fabother World",
      "summary": "Bytecode interpreter and engine re-implementation for Another World",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Fabother World is an open-source virtual machine re-implementation of the classic cinematic adventure game Another World (released as Out of This World in North America). Based on Gregory Montoir's original RAW interpreter, the codebase is rewritten and structured with readability, legibility, and architectural clarity in mind."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine runs the original English PC DOS release data files (such as BANK* and MEMLIST.BIN) and introduces quality-of-life enhancements suited for modern operating systems."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Support for English PC DOS game data files"
              }
            ],
            [
              {
                "type": "text",
                "value": "Save and load game states across multiple dedicated slots"
              }
            ],
            [
              {
                "type": "text",
                "value": "Adjustable window scale factors with dynamic resizing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in level jump codes for rapid scene navigation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast-forward gameplay toggle and pause controls"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customizable data paths via command-line arguments"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Fabother World Developers",
        "url": "https://github.com/fabiensanglard/Another-World-Bytecode-Interpreter"
      },
      "homepage": "https://github.com/fabiensanglard/Another-World-Bytecode-Interpreter",
      "repository": "https://github.com/pkgforge-dev/Fabother-World-AppImage",
      "keywords": [
        "another world",
        "out of this world",
        "interpreter",
        "virtual machine",
        "retro",
        "dos",
        "cinematic",
        "eric chahi"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
