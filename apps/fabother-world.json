      "name": "Fabother World",
      "summary": "Fabother World is an open-source bytecode interpreter for Another World (Out of This World), the revolutionary 1991 cinematic action-adventure game",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Fabother World is an open-source bytecode interpreter for Another World (Out of This World), the revolutionary 1991 cinematic action-adventure game designed by Éric Chahi. It executes the original game bytecode on modern hardware."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Faithful recreation of cinematic vector animations and gameplay scenes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native cross-platform execution with smooth performance"
              }
            ],
            [
              {
                "type": "text",
                "value": "Scalable high-resolution display rendering while preserving artistic integrity"
              }
            ],
            [
              {
                "type": "text",
                "value": "Accurate digital sound and atmospheric musical score playback"
              }
            ],
            [
              {
                "type": "text",
                "value": "Uses original game data files from DOS or Amiga editions"
              }
            ]
          ]
        }
      ],
