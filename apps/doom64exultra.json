      "name": "Doom64EX-Ultra",
      "summary": "DOOM64 EX+ Ultra is an enhanced fork of the DOOM 64 source port, recreating the dark atmospheric Nintendo 64 installment of DOOM for modern PCs wit",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "DOOM64 EX+ Ultra is an enhanced fork of the DOOM 64 source port, recreating the dark atmospheric Nintendo 64 installment of DOOM for modern PCs with enhanced features, rendering improvements, and bug fixes."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Faithfully recreates the unique atmosphere, textures, sprites, and ambient soundtrack of DOOM 64"
              }
            ],
            [
              {
                "type": "text",
                "value": "Hardware-accelerated OpenGL and Vulkan rendering with widescreen support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full mouse-look, customizable crosshairs, and configurable keybindings"
              }
            ],
            [
              {
                "type": "text",
                "value": "Restored cut levels, extended modding capabilities, and custom map support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced audio backend supporting atmospheric ambient reverb effects"
              }
            ]
          ]
        }
      ],
