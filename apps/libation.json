{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rmcrackan.libation",
      "name": "Libation",
      "summary": "Download, decrypt, and manage your Audible audiobook library",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Libation is an open-source application designed to download, decrypt, and organize your personal Audible audiobook library. Powered by AAXClean for fast decryption without heavy external dependencies, it allows users to manage and preserve their audiobooks across platforms."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Download and decrypt Audible audiobooks to retain offline ownership"
              }
            ],
            [
              {
                "type": "text",
                "value": "Remove DRM efficiently using AAXClean without requiring ffmpeg"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multi-region support covering US, UK, Canada, Germany, France, Australia, Japan, India, and Spain"
              }
            ],
            [
              {
                "type": "text",
                "value": "Organize your collection with powerful search, filtering, and tagging tools"
              }
            ],
            [
              {
                "type": "text",
                "value": "Import existing audiobooks along with high-quality cover art"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Libation Developers",
        "url": "https://github.com/rmcrackan/Libation"
      },
      "homepage": "https://github.com/rmcrackan/Libation",
      "repository": "https://github.com/pkgforge-dev/Libation-AppImage",
      "keywords": [
        "audible",
        "audiobook",
        "downloader",
        "decryption",
        "drm-removal",
        "aax",
        "library",
        "media"
      ],
      "categories": [
        "AudioVideo",
        "Audio",
        "FileTransfer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/libation.png",
      "screenshots": [
        {
          "caption": "Libation interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Libation-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
