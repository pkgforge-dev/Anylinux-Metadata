{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rubberduckycooly.sonic_1_2_2013_decompilation_rsdkv4",
      "name": "RSDKv4",
      "summary": "Standalone decompilation of Retro Engine v4 for Sonic the Hedgehog 1 and 2",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "RSDKv4 is a complete standalone decompilation of Retro Engine v4 and the menus from the 2013 remasters of Sonic the Hedgehog 1 and Sonic the Hedgehog 2. It offers an open-source reimplementation designed to run natively on modern desktop platforms when supplied with original game assets."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "In addition to authentic recreation of the original mobile remasters, the engine incorporates enhanced debugging tools, extended modding capabilities, and modern quality-of-life adjustments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Built-in mod loader and API supporting save file redirection, custom achievements, and XML configuration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Custom networking system and dedicated menus for hosting and joining Sonic 2 2-player versus multiplayer"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated script compiler backported from Retro Engine v5U"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive developer menu with scene jumping, hitbox visualization, and real-time palette monitoring"
              }
            ],
            [
              {
                "type": "text",
                "value": "Unified settings file configuration for easy management of display, gameplay, and engine options"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "RSDKv4 Developers",
        "url": "https://github.com/Rubberduckycooly/Sonic-1-2-2013-Decompilation"
      },
      "homepage": "https://github.com/Rubberduckycooly/Sonic-1-2-2013-Decompilation",
      "repository": "https://github.com/pkgforge-dev/RSDKv4-AppImage",
      "keywords": [
        "sonic",
        "retro engine",
        "decompilation",
        "engine",
        "platformer",
        "sega",
        "multiplayer",
        "mod loader"
      ],
      "categories": [
        "Game",
        "Debugger"
      ]
    },
    "media": {
