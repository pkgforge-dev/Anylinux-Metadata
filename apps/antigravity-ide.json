            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Agent-first editor interface optimized for interactive collaboration with AI"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in multi-turn task planner, artifact review, and visual progress tracking"
              }
            ],
            [
              {
                "type": "text",
                "value": "Deep workspace context awareness with real-time code indexing and diagnostics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated terminal, diff reviewer, and automated change applicator"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensible via custom skills, MCP tools, and personalized engineering rules"
              }
            ]
          ]
        }
      ],
