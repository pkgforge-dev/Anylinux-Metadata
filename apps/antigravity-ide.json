{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "google.antigravity.antigravity_ide",
      "name": "Antigravity IDE",
      "summary": "Agentic AI-powered integrated development environment designed around Google DeepMind coding assistance",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Antigravity IDE is a dedicated integrated development environment designed to provide deep integration with Google DeepMind agentic AI coding assistants. It combines modern code editing, automated project reasoning, and interactive pair-programming capabilities to streamline software engineering workflows."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for maximum portability across Linux distributions, the environment delivers full runtime dependencies without external container requirements or mandatory FUSE filesystem support."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native integration with DeepMind agentic coding workflows and pair programming"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully self-contained runtime environment compatible across glibc and musl distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Standalone execution without requiring FUSE setup or container layers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-updating mechanism with automated new release notifications"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless interoperability with external package managers and package update managers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Antigravity IDE Developers",
        "url": "https://antigravity.google/download"
      },
      "homepage": "https://antigravity.google/download",
      "repository": "https://github.com/pkgforge-dev/antigravity-ide-appimage",
      "keywords": [
        "editor",
        "development",
        "coding",
        "assistant",
        "deepmind",
        "programming",
        "developer"
      ],
      "categories": [
        "Development",
        "IDE",
        "Building"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/antigravity-ide.png",
      "screenshots": [
        {
          "caption": "Antigravity IDE interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Antigravity-IDE-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
