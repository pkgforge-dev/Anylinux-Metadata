{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.luebking.qarma",
      "name": "Qarma",
      "summary": "Create graphical dialog boxes from shell scripts using Qt",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Qarma is a command-line utility built with Qt designed to display graphical dialog boxes from shell scripts and terminal programs. It serves as a drop-in Qt-based alternative to the GNOME Zenity tool, providing seamless integration for Qt-based desktop environments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By relying on the native Qt styling and windowing integration rather than GTK, Qarma allows developers and system administrators to present dialogs that blend naturally into non-GNOME environments without changing existing script workflows."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Compatible command-line syntax modeled as a clone of Zenity"
              }
            ],
            [
              {
                "type": "text",
                "value": "Qt toolkit foundation ensuring native desktop look and feel"
              }
            ],
            [
              {
                "type": "text",
                "value": "Interactive GUI dialogs triggered directly from shell scripts"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for common dialog types such as messages, inputs, and selections"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Qarma Developers",
        "url": "https://github.com/luebking/qarma"
      },
      "homepage": "https://github.com/luebking/qarma",
      "repository": "https://github.com/pkgforge-dev/qarma-AppImage",
      "keywords": [
        "zenity",
        "dialog",
        "qt",
        "gui",
        "shell",
        "scripting",
        "toolkit",
        "prompt"
      ],
      "categories": [
        "Development",
        "Utility",
        "GUIDesigner"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/qarma.png",
      "screenshots": [
        {
          "caption": "Qarma interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/qarma-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
