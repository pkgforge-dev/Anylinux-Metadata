{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.gitlab.starfox64recomp",
      "name": "Star Fox 64 Recompiled",
      "summary": "Native PC port of the classic Nintendo 64 space rail-shooter Star Fox 64",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Star Fox 64 Recompiled is an enhanced native PC port of the classic Nintendo 64 space rail-shooter Star Fox 64 (Lylat Wars). Built using static recompilation techniques, it brings the iconic space combat experience directly to modern desktop systems without traditional emulation overhead."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native executable execution delivering optimal performance and responsiveness"
              }
            ],
            [
              {
                "type": "text",
                "value": "Faithful recreation of the original Nintendo 64 space rail-shooter gameplay"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully standalone portable runtime requiring no external system emulators"
              }
            ],
            [
              {
                "type": "text",
                "value": "Wide distribution compatibility across modern Linux environments"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Star Fox 64 Recompiled Developers",
        "url": "https://gitlab.com/sonicdcer/Starfox64Recomp"
      },
      "homepage": "https://gitlab.com/sonicdcer/Starfox64Recomp",
      "repository": "https://github.com/pkgforge-dev/Starfox64Recomp-AppImage",
      "keywords": [
        "star fox",
        "lylat wars",
        "recompiled",
        "nintendo 64",
        "space shooter",
        "rail shooter",
        "port"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/starfox64recomp.png",
      "screenshots": [
        {
          "caption": "Star Fox 64 Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
