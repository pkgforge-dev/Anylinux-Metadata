{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pkgforge_dev.commander_genius_appimage_commander_genius",
      "name": "commander-genius",
      "summary": "Modern game engine interpreter for Commander Keen episodes 1 through 6, Dreams, and Cosmos",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Commander Genius (also known as CloneKeenPlus) is an open-source game engine that interprets classic DOS platformers including Commander Keen 1 through 6, Keen Dreams, and Cosmo's Cosmic Adventure. It provides modern compatibility, enhanced audio and video options, and improved control handling while preserving original gameplay physics."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Full compatibility with Commander Keen episodes 1 to 6 and Keen Dreams"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for interpreting Cosmo's Cosmic Adventure"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern graphics scaling, screen resolutions, and visual filters"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced sound support and updated soundtrack playback"
              }
            ],
            [
              {
                "type": "text",
                "value": "Configurable input options with modern gamepad and joystick support"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "commander-genius Developers",
        "url": "https://github.com/pkgforge-dev/Commander-Genius-AppImage"
      },
      "homepage": "https://github.com/pkgforge-dev/Commander-Genius-AppImage",
      "repository": "https://github.com/pkgforge-dev/Commander-Genius-AppImage",
      "keywords": [
        "keen",
        "platformer",
