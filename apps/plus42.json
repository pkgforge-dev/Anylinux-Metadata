  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.thomasokken.plus42",
      "name": "Plus42",
      "summary": "Plus42 is an advanced scientific programmable calculator based on Free42, extending the capabilities of the iconic HP-42S",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Plus42 is an advanced scientific programmable calculator based on Free42, extending the capabilities of the iconic HP-42S. Designed for scientists, mathematicians, and engineers, it adds formula evaluation, units conversions, and expanded memory."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Complete HP-42S compatibility with Reverse Polish Notation (RPN) computation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Expanded multi-line LCD display with dynamic font sizing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Algebraic expression evaluation and numerical integration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive unit conversion system covering scientific and engineering quantities"
              }
            ],
            [
              {
                "type": "text",
                "value": "Matrix algebra, complex number arithmetic, and statistical distributions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Plus42 Developers",
        "url": "https://thomasokken.com/plus42"
      },
      "homepage": "https://thomasokken.com/plus42",
      "repository": "https://github.com/pkgforge-dev/Plus42-AppImage",
      "keywords": [
        "plus42",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Utility",
        "Calculator",
        "Science",
        "Math"
      ]
    },
    "media": {
