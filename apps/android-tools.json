{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.samueru_sama.android_tools_appimage",
      "name": "android-tools",
      "summary": "Communicate, debug, and flash Android devices using official platform utilities",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "android-tools packages the essential Android SDK Platform-Tools into a portable, standalone Linux bundle. It equips developers and enthusiasts with core command-line utilities such as the Android Debug Bridge (adb) and fastboot to interface with Android devices directly from any desktop distribution."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed for maximum portability and compatibility, this distribution bundles all necessary runtime dependencies without requiring FUSE to execute."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Includes adb for debugging, sideloading firmware packages, file transfers, and remote shell access"
              }
            ],
            [
              {
                "type": "text",
                "value": "Provides fastboot for flashing system images, kernel partitions, and unlocking bootloaders"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable runtime operating across glibc and musl-based Linux distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Runs out-of-the-box without requiring FUSE kernel modules or drivers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-updating mechanism to detect and prompt for new upstream platform releases"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "android-tools Developers",
        "url": "https://github.com/Samueru-sama/android-tools-AppImage"
      },
      "homepage": "https://github.com/Samueru-sama/android-tools-AppImage",
      "repository": "https://github.com/pkgforge-dev/android-tools-AppImage",
      "keywords": [
        "adb",
        "fastboot",
        "android",
        "debugging",
        "flashing",
        "sideload",
        "firmware",
        "bootloader"
      ],
      "categories": [
        "Development",
        "System",
        "Debugger"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/android-tools.png",
      "screenshots": [
        {
          "caption": "android-tools interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/android-tools-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
