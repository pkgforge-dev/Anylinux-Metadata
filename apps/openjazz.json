{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.alistert.openjazz",
      "name": "OpenJazz",
      "summary": "Free and open-source game engine reimplementation of Jazz Jackrabbit",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "OpenJazz is an open-source game engine reimplementation of the classic 1994 platformer Jazz Jackrabbit. Built to run natively across modern operating systems, it provides a faithful way to enjoy the fast-paced, colorful DOS classic without relying on traditional DOS emulators."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "To play the game, original data files from registered or shareware versions of Jazz Jackrabbit are required. OpenJazz seamlessly loads original game levels, graphics, and audio while introducing enhancements for modern gaming environments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Faithful reimplementation of classic Jazz Jackrabbit platforming mechanics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native modern platform support replacing the need for DOS emulation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiplayer gameplay mode for cooperative and competitive play"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full support for original cutscene movie playback and 3D bonus stages"
              }
            ],
            [
              {
                "type": "text",
                "value": "Recreated visual touches including authentic main menu plasma effects"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "OpenJazz Developers",
        "url": "https://github.com/AlisterT/openjazz"
      },
      "homepage": "https://github.com/AlisterT/openjazz",
      "repository": "https://github.com/pkgforge-dev/OpenJazz-AppImage",
      "keywords": [
        "jazz jackrabbit",
        "platformer",
        "game engine",
        "epic games",
        "dos",
        "retro",
        "multiplayer",
        "shareware"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/openjazz.png",
      "screenshots": [
        {
          "caption": "OpenJazz interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/OpenJazz-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
