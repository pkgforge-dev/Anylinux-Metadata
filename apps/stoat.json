{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "chat.stoat.StoatDesktop",
      "name": "Stoat",
      "summary": "Connect with communities through messaging and voice channels",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Stoat is an open-source, user-first communication platform designed for text messaging, voice channels, and community collaboration. Built as an extensible desktop client, Stoat provides a privacy-conscious, customizable chat environment that puts users in control of their digital spaces."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The platform enables private messaging, group discussions, and community server management with robust modern chat capabilities across multiple desktop operating systems."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Organized community servers with configurable text channels and categories"
              }
            ],
            [
              {
                "type": "text",
                "value": "Low-latency voice channels for group conversations and meetings"
              }
            ],
            [
              {
                "type": "text",
                "value": "Direct messaging and group chat support for private conversations"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform desktop application built with web technologies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for custom branding assets and custom server connections"
              }
            ]
          ]
        }
      ],
      "projectLicense": "AGPL-3.0-or-later",
      "developer": {
        "name": "Revolt Platforms Ltd",
        "url": "https://stoat.chat"
      },
      "homepage": "https://stoat.chat",
      "repository": "https://github.com/stoatchat/for-desktop",
      "keywords": [
        "chat",
        "messaging",
        "voice",
        "community",
        "im",
        "collaboration",
        "conference",
        "server"
      ],
      "categories": [
        "Network",
        "Chat",
        "InstantMessaging",
        "VideoConference"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/stoat.png",
      "screenshots": [
        {
          "caption": "Stoat interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "stoatchat/for-desktop"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
