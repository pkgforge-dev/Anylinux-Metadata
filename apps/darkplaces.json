{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.darkplacesengine.darkplaces",
      "name": "DarkPlaces",
      "summary": "Advanced Quake engine source port with modernized rendering and extended modding capabilities",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "DarkPlaces is an advanced, open-source game engine based on id Software's classic Quake. It modernizes the original 1996 engine by implementing enhanced graphics pipelines, extending the native QuakeC scripting system, and supporting broader community content formats."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Built on top of modern SDL2 graphics and audio foundations, DarkPlaces serves as a flexible framework capable of executing original Quake campaigns, standalone total conversions, and custom community modifications."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Modernized real-time rendering features, dynamic lighting, and visual enhancements"
              }
            ],
            [
              {
                "type": "text",
                "value": "Expanded QuakeC virtual machine with support for advanced game logic and scripting"
              }
            ],
            [
              {
                "type": "text",
                "value": "Broadened support for contemporary 3D model formats and higher-resolution map files"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for standalone games, official Quake mission packs, and third-party mods"
              }
            ],
            [
              {
                "type": "text",
                "value": "Hierarchical Quake virtual file system supporting flexible search paths and mod directories"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "DarkPlaces Developers",
        "url": "https://github.com/DarkPlacesEngine/DarkPlaces"
      },
      "homepage": "https://github.com/DarkPlacesEngine/DarkPlaces",
      "repository": "https://github.com/pkgforge-dev/DarkPlaces-AppImage",
      "keywords": [
        "quake",
        "engine",
        "sourceport",
        "quakec",
        "fps",
        "shooter",
        "retro",
        "opengl"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/darkplaces.png",
      "screenshots": [
        {
          "caption": "DarkPlaces interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/DarkPlaces-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
