{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.darkplacesengine.darkplaces",
      "name": "DarkPlaces",
      "summary": "DarkPlaces is an advanced, open-source Quake engine source port developed by Forest \"LordHavoc\" Hale",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "DarkPlaces is an advanced, open-source Quake engine source port developed by Forest \"LordHavoc\" Hale. Renowned for its cutting-edge graphics technology, it introduces real-time dynamic per-pixel lighting, normal mapping, and advanced particle effects to classic Quake."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Modern rendering pipeline featuring real-time dynamic shadows, bloom, and gloss maps"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for high-resolution replacement textures and 3D character models"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced networking and multiplayer protocol with improved client prediction"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive console configuration options and video settings"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatible with classic Quake, Quake mission packs, and standalone total conversions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "DarkPlaces Developers",
        "url": "https://github.com/DarkPlacesEngine/DarkPlaces"
      },
      "homepage": "https://github.com/DarkPlacesEngine/DarkPlaces",
      "repository": "https://github.com/pkgforge-dev/DarkPlaces-AppImage",
      "keywords": [
        "darkplaces",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/darkplaces.png",
      "screenshots": [
        {
          "caption": "DarkPlaces interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/DarkPlaces-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
