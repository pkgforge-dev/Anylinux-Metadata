{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.nxengine.nxengine_evo",
      "name": "NXEngine-evo",
      "summary": "Upgraded open-source game engine recreation of Cave Story with modern enhancements",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "NXEngine-evo is an enhanced, refactored open-source rewrite of NXEngine built with SDL2. It delivers a modern, high-fidelity recreation of the classic platform-adventure game Cave Story with cleaner code and extensive gameplay improvements."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine brings modern display capabilities, broader controller support, and expanded audiovisual customization options to the original experience."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Full HD and proper widescreen resolution support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Upgraded modern main menu and animated character portraits"
              }
            ],
            [
              {
                "type": "text",
                "value": "Force feedback rumble support and localization capabilities"
              }
            ],
            [
              {
                "type": "text",
                "value": "Custom soundtrack integration and initial modding support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Numerous gameplay bug fixes and SDL2 engine overhaul"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "NXEngine-evo Developers",
        "url": "https://github.com/nxengine/nxengine-evo"
      },
      "homepage": "https://github.com/nxengine/nxengine-evo",
      "repository": "https://github.com/pkgforge-dev/NXEngine-evo-AppImage-Enhanced",
      "keywords": [
        "cavestory",
        "doukutsu",
        "platformer",
        "engine",
        "sdl2",
        "retro",
        "metroidvania",
        "remake"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/nxengine-evo.png",
      "screenshots": [
        {
          "caption": "NXEngine-evo in-game gameplay showing character interaction and widescreen rendering",
          "source": "https://raw.githubusercontent.com/nxengine/nxengine-evo/master/screenshot.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/NXEngine-evo-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
