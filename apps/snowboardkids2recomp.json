{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.cdlewis.snowboardkids2recomp",
      "name": "Snowboard Kids 2 Recompiled",
      "summary": "Native PC port of Snowboard Kids 2 created using static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Snowboard Kids 2 Recompiled is an enhanced native PC port of the classic Nintendo 64 snowboarding title, produced using N64: Recompiled static recompilation technology and the RT64 rendering engine."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The project runs the game natively on modern hardware without traditional emulation overhead while preserving original visual effects and adding modern display options. Note that original game assets are not included and a legitimate copy of the game ROM is required to run."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Plug-and-play ROM loading with automatic asset extraction at the main menu"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully intact N64 graphical effects powered by the RT64 rendering engine"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern graphics enhancements including widescreen display support"
              }
            ],
            [
              {
                "type": "text",
                "value": "In-game configuration menus navigable by controller, keyboard, or mouse"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customizable gameplay, audio settings, and input mappings"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive modding capabilities built directly into the recompiled engine"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "cdlewis",
        "url": "https://github.com/cdlewis"
      },
      "homepage": "https://github.com/cdlewis/snowboardkids2-recomp",
      "repository": "https://github.com/cdlewis/snowboardkids2-recomp",
      "keywords": [
        "snowboard",
        "racing",
        "n64",
        "recompiled",
        "port",
        "rt64",
        "vulkan",
        "emulator"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/snowboardkids2recomp.png",
      "screenshots": [
        {
          "caption": "Snowboard Kids 2 Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/SnowboardKids2Recomp-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
