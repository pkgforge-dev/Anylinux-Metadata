{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.ghostty_org.ghostty",
      "name": "Ghostty",
      "summary": "Fast, feature-rich, and native terminal emulator pushing modern standards",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Ghostty is a cross-platform, standards-compliant terminal emulator engineered in Zig and C with a strong focus on native platform integration, high rendering performance, and rich windowing capabilities."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed to provide speed without sacrificing features or native UI aesthetics, it can be run as a standalone terminal application or embedded into other software via libghostty."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Comprehensive xterm-compliant terminal emulation supporting standard legacy control sequences"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for modern terminal graphics protocols including the Kitty image and graphics protocols"
              }
            ],
            [
              {
                "type": "text",
                "value": "Advanced window management with multi-window, tabbed interface, and split pane layouts"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native platform experience and rendering without web-view overhead"
              }
            ],
            [
              {
                "type": "text",
                "value": "Embeddable terminal functionality provided by the zero-dependency libghostty library"
              }
            ]
          ]
        }
      ],
      "projectLicense": "MIT",
      "developer": {
        "name": "Ghostty Developers",
        "url": "https://github.com/ghostty-org/ghostty"
      },
      "homepage": "https://github.com/ghostty-org/ghostty",
      "repository": "https://github.com/pkgforge-dev/ghostty-appimage",
      "keywords": [
        "ghostty",
        "terminal",
        "emulator",
        "tty",
        "shell",
        "console",
        "command-line",
        "kitty-graphics",
        "xterm"
      ],
      "categories": [
        "System",
        "TerminalEmulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/ghostty.png",
      "screenshots": [
        {
          "caption": "Ghostty interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ghostty-appimage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
