{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.fgsfdsfgs.perfect_dark",
      "name": "Perfect Dark",
      "summary": "Byte-matching decompilation and native build system for Perfect Dark",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Perfect Dark is a matching decompilation project of Rare's classic Nintendo 64 first-person shooter. Designed to reconstruct the original source code, the project allows enthusiasts and developers to compile and build the game directly from source combined with assets extracted from a legally owned base ROM."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By aiming for byte-for-byte fidelity with the retail game, the project provides an authentic foundation for preservation, modification, and modern platform porting."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Comprehensive support for multiple ROM releases including NTSC, PAL, and Japanese versions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automated asset extraction pipeline that preserves local modifications across runs"
              }
            ],
            [
              {
                "type": "text",
                "value": "Targeted byte-matching verification via built-in test suites and checksum comparisons"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for custom build configurations using environment variables like ROMID"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full cross-compilation pipeline utilizing MIPS toolchains and armips"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Perfect Dark Developers",
        "url": "https://github.com/fgsfdsfgs/perfect_dark"
      },
      "homepage": "https://github.com/fgsfdsfgs/perfect_dark",
      "repository": "https://github.com/pkgforge-dev/Perfect-Dark-AppImage",
      "keywords": [
        "decompilation",
        "reverse-engineering",
        "nintendo-64",
        "fps",
        "shooter",
        "mips",
        "retro",
        "emulator",
        "preservation"
      ],
      "categories": [
        "Development",
        "Game",
        "Building"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/perfect-dark.png",
      "screenshots": [
        {
          "caption": "Perfect Dark interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
