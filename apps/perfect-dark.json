{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.fgsfdsfgs.perfect_dark",
      "name": "Perfect Dark",
      "summary": "Perfect Dark (PC Port) is a native PC port of Rare's acclaimed 2000 Nintendo 64 first-person shooter Perfect Dark",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Perfect Dark (PC Port) is a native PC port of Rare's acclaimed 2000 Nintendo 64 first-person shooter Perfect Dark. Built from the decompilation of the original ROM, it brings Joanna Dark's sci-fi espionage adventure natively to PC."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native execution eliminating emulation latency and providing silky-smooth 60+ FPS gameplay"
              }
            ],
            [
              {
                "type": "text",
                "value": "True widescreen, ultrawide, and high-resolution rendering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern first-person shooter controls supporting keyboard, mouse-look, and dual-analog gamepads"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced visual fidelity with customizable field of view and texture filtering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Complete preservation of single-player missions, Combat Simulator multiplayer, and co-op modes"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Perfect Dark Developers",
        "url": "https://github.com/fgsfdsfgs/perfect_dark"
      },
      "homepage": "https://github.com/fgsfdsfgs/perfect_dark",
      "repository": "https://github.com/pkgforge-dev/Perfect-Dark-AppImage",
      "keywords": [
        "perfect-dark",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "ActionGame",
        "Shooter"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/perfect-dark.png",
      "screenshots": [
        {
          "caption": "Perfect Dark interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
