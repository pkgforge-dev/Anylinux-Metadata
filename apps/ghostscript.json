{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.ghostscript.ghostscript",
      "name": "Ghostscript",
      "summary": "Interpret, convert, and render PostScript language and PDF files",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Ghostscript is an interpreter for the PostScript language and Portable Document Format (PDF) files. It serves as a foundational tool for document processing, enabling high-performance rasterization, rendering, and format conversion."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged as a standalone and portable distribution, it provides a comprehensive execution environment compatible across diverse Linux distributions."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Fully interprets and processes PostScript and PDF documents"
              }
            ],
            [
              {
                "type": "text",
                "value": "Renders vector files into raster image formats and printer-ready data"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable package with broad distribution compatibility"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-updater to seamlessly check and notify for new versions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatible with external package managers without requiring FUSE to run"
              }
            ]
          ]
        }
      ],
      "projectLicense": "AGPL-3.0-or-later",
      "developer": {
        "name": "Artifex Software",
        "url": "https://artifex.com"
      },
      "homepage": "https://www.ghostscript.com",
      "repository": "https://github.com/ArtifexSoftware/ghostpdl",
      "keywords": [
        "postscript",
        "pdf",
        "interpreter",
        "rasterizer",
        "printing",
        "vector",
        "conversion"
      ],
      "categories": [
        "Graphics",
        "Publishing",
        "Printing",
        "VectorGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/ghostscript.png",
      "screenshots": [
        {
          "caption": "Ghostscript interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Ghostscript-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
