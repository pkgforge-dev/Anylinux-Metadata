{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.david20122.sound_space_plus",
      "name": "Sound Space Plus",
      "summary": "Rhythm-based aim precision game featuring cursor control and custom user levels",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Sound Space Plus is an open-source, rhythm-based precision aim game inspired by classic precision cursor mechanics. Players test their hand-eye coordination and timing by navigating and clicking targets synced to music."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Built for high-performance and competitive play, the game supports extensive user customizations, local map storage, and dedicated player profile folders across multiple platforms."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Fast-paced rhythm mechanics combining precise mouse aim with musical timing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform support with native Linux x86_64 builds"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dedicated local user data folder for managing songs, replays, and configuration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Quick in-game shortcut to directly access settings and custom files"
              }
            ],
            [
              {
                "type": "text",
                "value": "Open-source client architecture allowing community modifications and themes"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Sound Space Plus Developers",
        "url": "https://github.com/David20122/sound-space-plus"
      },
      "homepage": "https://github.com/David20122/sound-space-plus",
      "repository": "https://github.com/pkgforge-dev/sound-space-plus-AppImage",
      "keywords": [
        "rhythm",
        "aim",
        "precision",
        "music",
        "cursor",
        "reaction",
        "timing"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/sound-space-plus.png",
      "screenshots": [
        {
          "caption": "Sound Space Plus interface screenshot 1",
