      "name": "Sound Space Plus",
      "summary": "Sound Space Plus is an open-source, rhythm-based aim precision game",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Sound Space Plus is an open-source, rhythm-based aim precision game. Challenging players to hit targets to the beat of diverse music tracks, it tests both auditory rhythm and mouse cursor aim speed."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Precision aim mechanics combining rhythm timing with 2D spatial targeting"
              }
            ],
            [
              {
                "type": "text",
                "value": "Access to an extensive library of community-created beatmaps and songs"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customizable visual elements, cursor skins, particle effects, and note styles"
              }
            ],
            [
              {
                "type": "text",
                "value": "Detailed performance analysis and timing accuracy breakdowns"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiple game modifiers to customize challenge and gameplay speed"
              }
            ]
          ]
        }
      ],
