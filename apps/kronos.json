{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.fcare.kronos",
      "name": "Kronos",
      "summary": "Play Sega Saturn and Sega ST-V arcade games with modern emulation features",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Kronos is an advanced Sega Saturn and Sega Titan Video (ST-V) arcade emulator forked from the Yabause project. It focuses on achieving high hardware compatibility and modern graphical fidelity, offering both a standalone desktop interface and core integration for frontend environments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Built on top of a refined modern CMake framework, Kronos provides comprehensive emulation of complex Saturn hardware components alongside flexible front-end options."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Accurate emulation of Sega Saturn console and ST-V arcade hardware architecture"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern standalone desktop interface powered by Qt5"
              }
            ],
            [
              {
                "type": "text",
                "value": "Libretro core support for integration with frontends such as RetroArch"
              }
            ],
            [
              {
                "type": "text",
                "value": "Advanced shader-based graphical rendering pipeline for enhanced visual reproduction"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for loading and running disc images and arcade ROM dumps"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Kronos Developers",
        "url": "https://github.com/FCare/Kronos"
      },
      "homepage": "https://github.com/FCare/Kronos",
      "repository": "https://github.com/pkgforge-dev/Kronos-AppImage",
      "keywords": [
        "emulator",
        "emulation",
        "sega",
        "saturn",
        "stv",
        "arcade",
        "libretro",
        "retroarch",
        "yabause"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/kronos.png",
      "screenshots": [
        {
          "caption": "Kronos interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Kronos-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
