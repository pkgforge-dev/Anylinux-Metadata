{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.openxray.xray_16_openxray",
      "name": "OpenXRay",
      "summary": "Improved, open-source game engine port of GSC Game World's X-Ray Engine for S.T.A.L.K.E.R",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "OpenXRay is an improved, open-source port of the X-Ray Engine, originally developed by GSC Game World for the S.T.A.L.K.E.R. series. Designed as a modernized drop-in replacement, it delivers cross-platform support on Linux with a native OpenGL renderer and extensive bug fixes while preserving vanilla gameplay and compatibility."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Modernized OpenGL renderer with multi-platform Linux and 64-bit architecture support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive bug fixes addressing long-standing issues from the original X-Ray Engine"
              }
            ],
            [
              {
                "type": "text",
                "value": "Improved framerates and engine performance via multithreading and code parallelization"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced modding capabilities featuring frame and render graph pipelines and updated scripting"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in support for gamepads and multi-architecture ports including ARM64 and PPC64LE"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "OpenXRay Developers",
        "url": "https://github.com/OpenXRay/xray-16"
      },
      "homepage": "https://github.com/OpenXRay/xray-16",
      "repository": "https://github.com/pkgforge-dev/openxray-appimage",
      "keywords": [
        "stalker",
        "engine",
        "xray",
        "cop",
        "pripyat",
        "opengl",
        "fps",
        "gamedev"
      ],
      "categories": [
        "Game",
        "Development"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/openxray.png",
      "screenshots": [
        {
          "caption": "OpenXRay interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/OpenXRay-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
