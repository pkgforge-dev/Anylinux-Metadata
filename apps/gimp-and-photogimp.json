{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.diolinux.photogimp",
      "name": "PhotoGIMP",
      "summary": "Patch for GIMP providing an Adobe Photoshop-style interface layout and keyboard shortcuts",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "PhotoGIMP is a curated customization patch for the GNU Image Manipulation Program (GIMP) crafted by Diolinux. It reshapes the GIMP environment into a layout familiar to Adobe Photoshop users."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The bundle includes custom workspace layouts, standard Photoshop keyboard shortcuts, thousands of curated fonts, and optimized default tool preferences."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Adobe Photoshop-inspired toolbar organization and panel arrangement"
              }
            ],
            [
              {
                "type": "text",
                "value": "Standard industry keyboard shortcut mappings for common image editing tools"
              }
            ],
            [
              {
                "type": "text",
                "value": "Curated bundle of open-source creative fonts ready for graphic design"
              }
            ],
            [
              {
                "type": "text",
                "value": "Streamlined export and saving dialog configurations"
              }
            ],
            [
              {
                "type": "text",
                "value": "Complete non-destructive integration with underlying GIMP capabilities"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Diolinux",
        "url": "https://diolinux.com.br"
      },
      "homepage": "https://github.com/Diolinux/PhotoGIMP",
      "repository": "https://github.com/Diolinux/PhotoGIMP",
      "keywords": [
        "gimp-and-photogimp",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Graphics",
        "2DGraphics",
        "RasterGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/gimp-and-photogimp.png",
      "screenshots": [
        {
          "caption": "PhotoGIMP interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/GIMP-and-PhotoGIMP-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
