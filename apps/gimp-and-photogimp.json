{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.diolinux.photogimp",
      "name": "PhotoGIMP",
      "summary": "Transform GIMP with an Adobe Photoshop layout and keyboard shortcuts",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "PhotoGIMP is a patch that customizes the GNU Image Manipulation Program (GIMP) to provide an interface layout and workflow tailored for Adobe Photoshop users. It adapts the tool arrangements, default settings, and shortcuts so creators transitioning to open-source software can work comfortably without relearning fundamental controls."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Reorganized tool layout mirroring standard Adobe Photoshop positions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Photoshop-compatible keyboard shortcuts based on official desktop standards"
              }
            ],
            [
              {
                "type": "text",
                "value": "Optimized interface settings designed to maximize usable canvas space"
              }
            ],
            [
              {
                "type": "text",
                "value": "Custom startup splash screen greeting users upon launching"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dedicated desktop integration with distinct application naming and icon"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Diolinux",
        "url": "https://diolinux.com.br"
      },
      "homepage": "https://github.com/Diolinux/PhotoGIMP",
      "repository": "https://github.com/Diolinux/PhotoGIMP",
      "keywords": [
        "gimp",
        "photoshop",
        "image editor",
        "photo retouching",
        "graphic design",
        "shortcuts",
        "raster graphics"
      ],
      "categories": [
        "Graphics",
        "2DGraphics",
        "RasterGraphics",
        "Photography"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/gimp-and-photogimp.png",
      "screenshots": [
        {
          "caption": "PhotoGIMP application window showing the Photoshop-style layout",
          "source": "https://raw.githubusercontent.com/Diolinux/PhotoGIMP/master/screenshots/photogimp_3_-_diolinux.png"
        },
        {
          "caption": "PhotoGIMP custom startup splash screen",
          "source": "https://raw.githubusercontent.com/Diolinux/PhotoGIMP/master/.config/GIMP/3.0/splashes/splash-screen-2025-v2.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/GIMP-and-PhotoGIMP-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
