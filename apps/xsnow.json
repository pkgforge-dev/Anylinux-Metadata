{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "net.sourceforge.xsnow",
      "name": "Xsnow",
      "summary": "Bring falling snow, Santa, reindeer, and seasonal holiday cheer to your desktop",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Xsnow is a classic desktop animation toy for the X Window System that decorates your workspace with falling snowflakes, accumulating snowdrifts, and seasonal characters. Originally conceived for vintage Unix workstations, it enlivens standard desktop environments with festive graphics and peaceful holiday scenery."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The software renders continuous seasonal animations over the desktop background while dynamically accumulating snow along the bottom of the screen and atop open application windows."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Animated snowflakes drifting down the desktop with variable speed and wind direction"
              }
            ],
            [
              {
                "type": "text",
                "value": "Snow buildup that realistically gathers on open windows and the desktop panel"
              }
            ],
            [
              {
                "type": "text",
                "value": "Santa Claus in his sleigh flying across the screen pulled by reindeer"
              }
            ],
            [
              {
                "type": "text",
                "value": "Scattered Christmas trees and scenery elements decorating the desktop surface"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customizable animation parameters including flake quantity, size, and falling speed"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Xsnow Developers",
        "url": "https://sourceforge.net/projects/xsnow"
      },
      "homepage": "https://sourceforge.net/projects/xsnow",
      "repository": "https://github.com/pkgforge-dev/Xsnow-AppImage",
      "keywords": [
        "snow",
        "desktop toy",
        "holiday",
        "christmas",
        "santa",
        "x11",
        "animation",
        "seasonal"
      ],
      "categories": [
        "Game",
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/xsnow.png",
      "screenshots": [
        {
          "caption": "Xsnow interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Xsnow-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
