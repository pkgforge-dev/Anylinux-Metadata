{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.l3ib.nitrogen",
      "name": "Nitrogen",
      "summary": "Fast and lightweight wallpaper browser and desktop background setter for X11",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Nitrogen is a fast and lightweight wallpaper browser and desktop background setter designed for the X11 Window System. Built with gtkmm, it provides an intuitive graphical interface for previewing images and quickly applying them across multi-head desktop setups."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "In addition to interactive wallpaper management, Nitrogen offers a command-line mode capable of restoring saved wallpaper configurations during window manager or desktop session startup."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Fast thumbnail generation and browsing for image directories"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiple image placement modes including scaled, centered, tiled, and zoomed"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full multi-monitor and multi-head display support with independent background configuration"
              }
            ],
            [
              {
                "type": "text",
                "value": "In-memory caching of thumbnails for rapid browsing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Command-line restoration mode for automated session startup integration"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Nitrogen Developers",
        "url": "https://github.com/l3ib/nitrogen"
      },
      "homepage": "https://github.com/l3ib/nitrogen",
      "repository": "https://github.com/pkgforge-dev/nitrogen-appimage",
      "keywords": [
        "wallpaper",
        "background",
        "x11",
        "desktop",
        "image viewer",
        "gtkmm",
        "multihead"
      ],
      "categories": [
        "Graphics",
        "Settings",
        "DesktopSettings",
        "2DGraphics",
        "Viewer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/nitrogen.png",
      "screenshots": [
        {
          "caption": "Nitrogen interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Nitrogen-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
