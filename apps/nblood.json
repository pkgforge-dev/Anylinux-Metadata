{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.nukeykt.nblood",
      "name": "NBlood",
      "summary": "Reverse-engineered source port of the horror first-person shooter Blood based on EDuke32",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "NBlood is an accurate, reverse-engineered source port of Monolith Productions' classic 1997 horror first-person shooter Blood, built using EDuke32 engine technology and principles. It provides modern system compatibility and performance enhancements while faithfully preserving the original game mechanics and feel."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Requires original game data files from a retail CD, Steam, or GOG installation of Blood 1.21 to run."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Automatic detection and loading of digital game copies from Steam or GOG installations"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full support for the Cryptic Passage expansion campaign via custom game parameters"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-quality CD soundtrack support using modern FLAC and OGG audio formats"
              }
            ],
            [
              {
                "type": "text",
                "value": "Playback of original game cutscenes copied from the retail CD or GOG images"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modernized engine core based on EDuke32 for improved stability and controls"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "NBlood Developers",
        "url": "https://github.com/nukeykt/NBlood"
      },
      "homepage": "https://github.com/nukeykt/NBlood",
      "repository": "https://github.com/pkgforge-dev/NBlood-AppImage",
      "keywords": [
        "blood",
        "eduke32",
        "build engine",
        "first-person shooter",
        "fps",
        "source port",
        "cryptic passage",
        "retro gaming"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/nblood.png",
      "screenshots": [
        {
          "caption": "In-game gameplay in NBlood featuring classic environments and HUD",
          "source": "https://github.com/user-attachments/assets/f517d412-ac7f-4002-ab47-35e41bab9f26"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
