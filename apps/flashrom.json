{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.flashrom.flashrom",
      "name": "flashrom",
      "summary": "Identify, read, write, verify, and erase flash memory chips and BIOS/ROM firmware",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "flashrom is a universal utility designed to identify, read, write, verify, and erase flash memory chips. It is widely used for flashing BIOS, coreboot, EFI, and other firmware images across a wide array of motherboards, PCI/PCIe cards, and dedicated external programmer hardware."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged as a standalone portable package that does not require FUSE, it operates reliably across diverse Linux distributions and environments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Supports hundreds of flash memory chips across parallel, LPC, FWH, and SPI interfaces"
              }
            ],
            [
              {
                "type": "text",
                "value": "Works with numerous internal motherboards, chipsets, and external USB or serial programming devices"
              }
            ],
            [
              {
                "type": "text",
                "value": "Performs fast, safe chip verification and partial write operations to prevent firmware corruption"
              }
            ],
            [
              {
                "type": "text",
                "value": "Includes standalone runtime execution requiring no external FUSE dependencies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in update notification system with automatic detection of package managers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "flashrom Developers",
        "url": "https://flashrom.org/index.html"
      },
      "homepage": "https://flashrom.org/index.html",
      "repository": "https://github.com/pkgforge-dev/flashrom-appimage",
      "keywords": [
        "firmware",
        "bios",
        "coreboot",
        "rom",
        "programmer",
        "spi",
        "flasher",
        "hardware",
        "eeprom"
      ],
      "categories": [
        "System",
        "HardwareSettings"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/flashrom.png",
      "screenshots": [
        {
          "caption": "flashrom interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Flashrom-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
