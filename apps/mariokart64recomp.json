{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.gitlab.mariokart64recomp",
      "name": "Mario Kart 64 Recompiled",
      "summary": "Mario Kart 64 Recompiled is an enhanced native PC port of the classic Nintendo 64 kart racer Mario Kart 64",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Mario Kart 64 Recompiled is an enhanced native PC port of the classic Nintendo 64 kart racer Mario Kart 64. Using static recompilation, it runs natively on modern PC hardware with high framerates and enhanced graphics."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native execution eliminating emulation latency, delivering smooth 60 FPS gameplay"
              }
            ],
            [
              {
                "type": "text",
                "value": "True widescreen and high-resolution rendering with customizable aspect ratios"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full analog gamepad support with modern rumble feedback and button mapping"
              }
            ],
            [
              {
                "type": "text",
                "value": "Preserved four-player split-screen multiplayer racing and battle modes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for community mods, custom texture packs, and audio enhancements"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Mario Kart 64 Recompiled Developers",
        "url": "https://gitlab.com/sonicdcer/MarioKart64Recomp"
      },
      "homepage": "https://gitlab.com/sonicdcer/MarioKart64Recomp",
      "repository": "https://github.com/pkgforge-dev/MarioKart64Recomp-AppImage",
      "keywords": [
        "mariokart64recomp",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "ArcadeGame",
        "SportsGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/mariokart64recomp.png",
      "screenshots": [
        {
          "caption": "Mario Kart 64 Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
