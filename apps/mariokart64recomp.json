{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.gitlab.mariokart64recomp",
      "name": "Mario Kart 64 Recompiled",
      "summary": "Enhanced native PC port and static recompilation of Mario Kart 64",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Mario Kart 64 Recompiled is an enhanced native PC port of the classic Nintendo 64 kart racer, built using static recompilation technology for modern systems. It delivers authentic N64 gameplay running natively on Linux without emulation overhead."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native executable execution without traditional emulator overhead"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully bundled standalone package compatible across diverse Linux distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Runs without requiring FUSE installed on the host system"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated update notification support with package manager detection"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Mario Kart 64 Recompiled Developers",
        "url": "https://gitlab.com/sonicdcer/MarioKart64Recomp"
      },
      "homepage": "https://gitlab.com/sonicdcer/MarioKart64Recomp",
      "repository": "https://github.com/pkgforge-dev/MarioKart64Recomp-AppImage",
      "keywords": [
        "mario kart",
        "recompilation",
        "port",
        "racing",
        "kart",
        "n64",
        "nintendo",
        "game"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/mariokart64recomp.png",
      "screenshots": [
        {
          "caption": "Mario Kart 64 Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
