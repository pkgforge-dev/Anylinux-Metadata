{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.friskthefallenhuman.prey2006",
      "name": "Prey (2006)",
      "summary": "Native source port of the classic 2006 sci-fi first-person shooter Prey",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Prey (2006) is a native Linux source port of the acclaimed sci-fi first-person shooter built on the id Tech 4 engine. It brings Tommy's mind-bending journey aboard the alien mothership Sphere to modern Linux desktop environments with improved portability and compatibility."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for cross-distribution compatibility, this build bundles necessary runtime dependencies and incorporates portable execution improvements to run reliably across a wide range of Linux setups."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native modern Linux execution for the classic 2006 sci-fi title"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully self-contained package compatible with both glibc and musl-based distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "FUSE-independent portable execution via uruntime"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in self-updater prompting when new releases and engine updates are available"
              }
            ],
            [
              {
                "type": "text",
                "value": "Automatic integration and compatibility with package managers like soar, am, and dbin"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Prey (2006) Developers",
        "url": "https://github.com/FriskTheFallenHuman/Prey2006"
      },
      "homepage": "https://github.com/FriskTheFallenHuman/Prey2006",
      "repository": "https://github.com/pkgforge-dev/Prey2006-AppImage",
      "keywords": [
        "fps",
        "shooter",
        "idtech4",
        "scifi",
        "sourceport",
        "action",
        "classic"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/prey2006.png",
      "screenshots": [
        {
          "caption": "Prey (2006) interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Prey2006-AppImage"
  },
  "sandbox": {
