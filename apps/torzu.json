{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pkgforge_dev.torzu_appimage",
      "name": "Torzu",
      "summary": "Emulate Nintendo Switch games with targeted CPU optimizations and high portable performance",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Torzu is an open-source Nintendo Switch emulator designed to run modern console titles on Linux systems. Built using Qt and highly optimized execution pipelines, it focuses on high-performance game playback across both 64-bit ARM and x86 architectures."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Torzu provides targeted builds optimized for modern processor features, delivering improved execution speed, frame rates, and broad compatibility."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Optimized execution pipelines with dedicated support for modern x86_64_v3 instruction sets"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-architecture support targeting both x86_64 and 64-bit ARM (aarch64) systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Flexible display protocol support for both Wayland and X11/XCB display environments"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-fidelity Nintendo Switch game emulation and custom configuration profiles"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Torzu Developers",
        "url": "https://github.com/pkgforge-dev/Torzu-AppImage"
      },
      "homepage": "https://github.com/pkgforge-dev/Torzu-AppImage",
      "repository": "https://github.com/pkgforge-dev/Torzu-AppImage",
      "keywords": [
        "switch",
        "emulator",
        "nintendo",
        "gaming",
        "qt6",
        "console",
        "x86_64_v3",
        "aarch64"
      ],
      "categories": [
        "Game",
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/torzu.png",
      "screenshots": [
        {
          "caption": "Torzu interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Torzu-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
