{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pkgforge_dev.torzu_appimage",
      "name": "Torzu",
      "summary": "Torzu is an open-source Nintendo Switch emulator with targeted optimizations for modern x86_64 CPUs",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Torzu is an open-source Nintendo Switch emulator with targeted optimizations for modern x86_64 CPUs. Built to deliver fluid framerates, it enables playing Switch titles with high fidelity on PC hardware."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Hardware-accelerated Vulkan and OpenGL graphics rendering pipelines"
              }
            ],
            [
              {
                "type": "text",
                "value": "Resolution scaling up to 4K and 8K with anisotropic texture filtering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Broad support for modern game controllers with motion gyro aiming and rumble"
              }
            ],
            [
              {
                "type": "text",
                "value": "Local wireless multiplayer and network session emulation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Optimized CPU instruction set builds (x86_64_v3) for modern processor architectures"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Torzu Developers",
        "url": "https://github.com/pkgforge-dev/Torzu-AppImage"
      },
      "homepage": "https://github.com/pkgforge-dev/Torzu-AppImage",
      "repository": "https://github.com/pkgforge-dev/Torzu-AppImage",
      "keywords": [
        "torzu",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/torzu.png",
      "screenshots": [
        {
          "caption": "Torzu interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Torzu-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
