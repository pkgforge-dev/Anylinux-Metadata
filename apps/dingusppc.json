{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.dingusdev.dingusppc",
      "name": "DingusPPC",
      "summary": "Experimental PowerPC Macintosh emulator focused on hardware accuracy and debugging",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "DingusPPC is an experimental, open-source PowerPC emulator designed to deliver accurate emulation of classic Macintosh hardware. Unlike conventional high-level emulators, DingusPPC focuses on low-level hardware fidelity and offers a robust environment tailored for running and testing PowerPC NuBus and Old World ROMs alongside early New World systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Built for developers and retrocomputing enthusiasts, the emulator features an integrated interactive debugging suite and disassembler to aid reverse engineering and system diagnosis."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Accurate emulation of classic Old World and early New World PowerPC Macintosh architectures"
              }
            ],
            [
              {
                "type": "text",
                "value": "Targeted support for models including Power Macintosh 6100, 7500, G3 Beige, and Apple Pippin"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated interactive debugger with CPU disassembler support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Flexible command-line interface supporting custom boot ROM loading and machine identification"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dedicated CPU test suite to ensure correctness in PowerPC instruction emulation"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-2.0-or-later",
      "developer": {
        "name": "DingusPPC Developers",
        "url": "https://github.com/dingusdev"
      },
      "homepage": "https://github.com/dingusdev/dingusppc",
      "repository": "https://github.com/dingusdev/dingusppc",
      "keywords": [
        "emulator",
        "powerpc",
        "macintosh",
        "debugger",
        "disassembler",
        "retrocomputing",
        "mac",
        "pippin"
      ],
      "categories": [
        "System",
        "Development",
        "Debugger"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dingusppc.png",
      "screenshots": [
        {
          "caption": "DingusPPC interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/DingusPPC-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
