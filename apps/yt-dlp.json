{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.yt_dlp.yt_dlp",
      "name": "yt-dlp",
      "summary": "Download audio and video streams from thousands of websites via the command line",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "yt-dlp is an advanced, feature-rich command-line audio and video downloader written in Python. Originating as an enhanced fork of youtube-dl and youtube-dlc, it aims to deliver active development, bug fixes, and extensive extraction support across thousands of multimedia platforms."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Support for extracting media and metadata from thousands of audio and video websites"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive format selection, filtering, and sorting to choose optimal resolutions and codecs"
              }
            ],
            [
              {
                "type": "text",
                "value": "Subtitle download, embedding, and automatic conversion capabilities"
              }
            ],
            [
              {
                "type": "text",
                "value": "Flexible post-processing, thumbnail embedding, and metadata modification"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native integration with SponsorBlock to mark or remove sponsored sections"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensible architecture supporting third-party plugins and custom extractor configurations"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "yt-dlp Developers",
        "url": "https://github.com/yt-dlp/yt-dlp"
      },
      "homepage": "https://github.com/yt-dlp/yt-dlp",
      "repository": "https://github.com/pkgforge-dev/yt-dlp-AppImage",
      "keywords": [
        "download",
        "video",
        "audio",
        "streaming",
        "media",
        "cli",
        "extractor",
        "subtitles"
      ],
      "categories": [
        "AudioVideo",
        "Network",
        "FileTransfer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/yt-dlp.png",
      "screenshots": [
        {
          "caption": "yt-dlp interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/yt-dlp-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
