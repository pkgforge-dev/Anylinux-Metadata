{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rainchus.donkeykong64recomp",
      "name": "Donkey Kong 64 Recompiled",
      "summary": "Play Donkey Kong 64 natively on PC with enhanced graphics and modern features",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Donkey Kong 64: Recompiled is an enhanced native PC port of the classic Nintendo 64 game created using static recompilation via N64: Recompiled. Powered by the RT64 rendering engine, it delivers high performance and modern PC enhancements without relying on traditional emulation."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The project requires an original game ROM to provide game assets and features faithful reproduction of original visual effects alongside modern display and control options."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High framerate gameplay supporting arbitrary monitor refresh rates without affecting game logic"
              }
            ],
            [
              {
                "type": "text",
                "value": "Widescreen and ultrawide aspect ratio support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully intact N64 graphical and screen effects rendered via RT64 with Vulkan and Direct3D 12 backends"
              }
            ],
            [
              {
                "type": "text",
                "value": "Low input lag and instant load times compared to original hardware"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive in-game configuration menus usable via mouse, keyboard, or gamepad"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native compatibility for Linux desktop and Steam Deck"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Rainchus",
        "url": "https://github.com/Rainchus"
      },
      "homepage": "https://github.com/Rainchus/Donkey-Kong-64-Recompiled",
      "repository": "https://github.com/Rainchus/Donkey-Kong-64-Recompiled",
      "keywords": [
        "nintendo",
        "n64",
        "recompilation",
        "recompiled",
        "port",
        "rt64",
        "platformer",
        "retro"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/donkeykong64recomp.png",
      "screenshots": [
        {
          "caption": "Donkey Kong 64 Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/DonkeyKong64Recomp-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
