{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.link4electronics.dethrace",
      "name": "Dethrace",
      "summary": "Reverse-engineered open-source port of the classic vehicular combat game Carmageddon",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Dethrace is an open-source, reverse-engineered source port of the iconic 1997 vehicular combat and racing game Carmageddon. Built using CMake and modern SDL libraries, the project aims to reconstruct the original game engine to run natively on modern operating systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine requires the original game assets to run, supporting files from retail copies as well as official playable demos."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native modern system support via SDL2 and SDL3 runtimes"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern rendering with SDL3 GPU and 3dfx emulation using GLSL and SPIR-V shaders"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatibility with original CD data from Carmageddon and the Splat Pack demo"
              }
            ],
            [
              {
                "type": "text",
                "value": "Emulation of original CD audio tracks using digital OGG Vorbis files"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customizable game settings and asset directories through INI configuration"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Dethrace Developers",
        "url": "https://github.com/Link4Electronics/dethrace"
      },
      "homepage": "https://github.com/Link4Electronics/dethrace",
      "repository": "https://github.com/pkgforge-dev/dethrace-AppImage",
      "keywords": [
        "carmageddon",
        "racing",
        "vehicular combat",
        "source port",
        "reverse engineering",
        "sdl",
        "retro gaming"
      ],
      "categories": [
        "Game",
        "Simulation"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dethrace.png",
      "screenshots": [
        {
          "caption": "Dethrace interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/dethrace-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
