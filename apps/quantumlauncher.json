{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.mrmaydie.quantumlauncher",
      "name": "QuantumLauncher",
      "summary": "Lightweight and powerful open-source Minecraft launcher designed for high performance",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "QuantumLauncher is a fast, lightweight, and open-source launcher for Minecraft focused on delivering high performance and seamless instance management across various Linux environments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This enhanced portable packaging is designed to run reliably across distributions without host libc dependencies, ensuring full compatibility even on older systems and musl-based distributions such as Alpine Linux."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Optimized runtime execution that ensures downloaded Java runtimes execute reliably across diverse environments"
              }
            ],
            [
              {
                "type": "text",
                "value": "Broad compatibility across modern, legacy, and musl-libc Linux distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Standalone operation without requiring FUSE to launch or run"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in update notification system with intelligent detection of system package managers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Lightweight footprint engineered for responsive game launching and instance configuration"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "mrmaydie",
        "url": "https://github.com/mrmaydie"
      },
      "homepage": "https://github.com/mrmaydie/QuantumLauncher",
      "repository": "https://github.com/mrmaydie/QuantumLauncher",
      "keywords": [
        "minecraft",
        "launcher",
        "gaming",
        "instances",
        "modpacks",
        "java"
      ],
      "categories": [
        "Game",
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/quantumlauncher.png",
      "screenshots": [
        {
          "caption": "QuantumLauncher interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/QuantumLauncher-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
