{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.itsmattkc.isle_isle_portable",
      "name": "ISLE Portable",
      "summary": "Open-source decompilation and modern source port of LEGO Island",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ISLE is an open-source recreation and instruction-matching decompilation of the classic 1997 PC game LEGO Island. Written in C++ and managed with CMake, the project aims to recreate the original game logic and engine with machine-code precision, providing an accurate, modifiable, and portable codebase for modern platforms."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By reconstructing the original architecture, ISLE enables preservation, modernization, and porting of the original open-world island adventure while supporting integration with original game assets."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Instruction-matching decompilation for high accuracy against original binaries"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully decompiled executable behaving identically to the retail release"
              }
            ],
            [
              {
                "type": "text",
                "value": "CMake build system providing cross-platform configuration flexibility"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatibility for pairing recompiled executables with original game data files"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensible codebase designed for future improvements, modding, and platform ports"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ISLE Portable Developers",
        "url": "https://github.com/itsmattkc/isle"
      },
      "homepage": "https://github.com/itsmattkc/isle",
      "repository": "https://github.com/pkgforge-dev/isle-portable-AppImage-Enhanced",
      "keywords": [
        "decompilation",
        "reverse-engineering",
        "source port",
        "adventure",
        "retro",
        "open-world",
        "game engine"
      ],
      "categories": [
        "Game",
        "Development",
        "Building"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/isle-portable.png",
      "screenshots": [
        {
          "caption": "ISLE Portable interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
