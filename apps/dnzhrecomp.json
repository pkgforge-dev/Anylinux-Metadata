{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.gitlab.dnzhrecomp",
      "name": "DNZHRecomp",
      "summary": "Native PC port of the classic Nintendo 64 third-person shooter Duke Nukem: Zero Hour",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "DNZHRecomp is a native PC port and static recompilation of the 1999 Nintendo 64 third-person shooter Duke Nukem: Zero Hour. It executes original game logic natively on modern hardware without traditional emulation overhead, delivering improved performance and modern system compatibility."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged with portable runtime dependencies, this release delivers the time-traveling shooter experience across modern Linux environments with zero external setup requirements."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native executable execution avoiding high CPU emulation overhead"
              }
            ],
            [
              {
                "type": "text",
                "value": "High compatibility across diverse Linux distributions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated runtime eliminating external FUSE dependencies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in optional self-updater for seamless game client updates"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "DNZHRecomp Developers",
        "url": "https://gitlab.com/sonicdcer/DNZHRecomp"
      },
      "homepage": "https://gitlab.com/sonicdcer/DNZHRecomp",
      "repository": "https://github.com/pkgforge-dev/DNZHRecomp-AppImage",
      "keywords": [
        "duke nukem",
        "zero hour",
        "recompilation",
        "port",
        "n64",
        "shooter",
        "action",
        "retro"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dnzhrecomp.png",
      "screenshots": [
        {
          "caption": "DNZHRecomp interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/DNZHRecomp-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
