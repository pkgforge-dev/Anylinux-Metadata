{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.dillo_browser.dillo",
      "name": "Dillo",
      "summary": "Dillo is an ultra-fast, minimalist graphical web browser engineered for efficiency and low resource consumption",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Dillo is an ultra-fast, minimalist graphical web browser engineered for efficiency and low resource consumption. Built on FLTK, it loads web pages almost instantaneously and functions smoothly on low-end or vintage hardware."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Extremely lightweight footprint consuming only a few megabytes of memory"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast HTML rendering engine supporting CSS styling and web images"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated privacy features blocking third-party tracking cookies by default"
              }
            ],
            [
              {
                "type": "text",
                "value": "Tabbed browsing interface with simple navigation and bookmark management"
              }
            ],
            [
              {
                "type": "text",
                "value": "Written in clean C and C++ with virtually zero external library bloat"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Dillo Developers",
        "url": "https://github.com/dillo-browser/dillo"
      },
      "homepage": "https://github.com/dillo-browser/dillo",
      "repository": "https://github.com/pkgforge-dev/dillo-appimage",
      "keywords": [
        "dillo",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dillo.png",
      "screenshots": [
        {
          "caption": "Dillo interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Dillo-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
