{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.dillo_browser.dillo",
      "name": "Dillo",
      "summary": "Lightweight and fast graphical web browser focused on privacy and security",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Dillo is a multi-platform graphical web browser built using the FLTK 1.3 GUI toolkit, engineered for exceptional speed, minimal resource usage, and a small memory footprint."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "It is developed with a strict focus on personal security and user privacy, offering an efficient web navigation experience suitable for both modern systems and resource-constrained hardware."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Built using the lightweight FLTK 1.3 toolkit for responsive user interface rendering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Ultra-low memory footprint and efficient CPU utilization"
              }
            ],
            [
              {
                "type": "text",
                "value": "Engineered with a focus on personal privacy and browsing security"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform graphical rendering engine"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Dillo Developers",
        "url": "https://github.com/dillo-browser/dillo"
      },
      "homepage": "https://github.com/dillo-browser/dillo",
      "repository": "https://github.com/pkgforge-dev/dillo-appimage",
      "keywords": [
        "browser",
        "web",
        "fltk",
        "lightweight",
        "privacy",
        "fast",
        "minimalist",
        "html"
      ],
      "categories": [
        "Network",
        "WebBrowser"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dillo.png",
      "screenshots": [
        {
          "caption": "Dillo web browser displaying the official website",
          "source": "https://raw.githubusercontent.com/dillo-browser/dillo/master/doc/dillo.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
