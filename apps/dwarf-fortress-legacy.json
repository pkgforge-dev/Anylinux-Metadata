    "metadata": {
      "id": "com.bay12games.dwarf_fortress_legacy",
      "name": "Dwarf Fortress (Legacy)",
      "summary": "Dwarf Fortress (Legacy) is the classic, acclaimed ASCII-based fantasy world simulation and fortress management game by Bay 12 Games",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Dwarf Fortress (Legacy) is the classic, acclaimed ASCII-based fantasy world simulation and fortress management game by Bay 12 Games. It procedurally generates an intricate world complete with geology, mythology, history, and civilizations."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Complete fortress management simulation with complex economics, engineering, and sociology"
              }
            ],
            [
              {
                "type": "text",
                "value": "Adventure mode allowing exploration of the procedurally generated historical world"
              }
            ],
            [
              {
                "type": "text",
                "value": "Authentic classic ASCII interface with support for community tilesets"
              }
            ],
            [
              {
                "type": "text",
                "value": "Unmatched procedural depth with detailed body anatomy, combat, and fluids physics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Deep, living sandbox universe where every creature and civilization leaves historical records"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Dwarf Fortress (Legacy) Developers",
        "url": "https://bay12games.com/dwarves"
      },
      "homepage": "https://bay12games.com/dwarves",
      "repository": "https://github.com/pkgforge-dev/dwarf-fortress-legacy-appimage",
