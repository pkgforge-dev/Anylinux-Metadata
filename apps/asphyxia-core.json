{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.asphyxia_core.core_asphyxia_core",
      "name": "Asphyxia CORE",
      "summary": "Modular, high-performance server emulator and network backend designed for arcade rhythm games",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Asphyxia CORE is a modular, high-performance custom network server and backend emulator engineered for arcade rhythm games. Built for speed and extensibility, it recreates essential network services and game profiles to power modern rhythm game setups."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "It provides a robust plugin architecture allowing community developers to implement custom network protocols, title support, and event tracking seamlessly across different titles."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Extensible modular plugin system for supporting diverse game titles and custom game handlers"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-performance network backend designed for low latency profile saving and score synchronization"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in web management interface for profile administration, score tracking, and server configuration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Lightweight runtime footprint engineered for seamless deployment across varied Linux environments"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Asphyxia CORE Developers",
        "url": "https://github.com/asphyxia-core/core"
      },
      "homepage": "https://github.com/asphyxia-core/core",
      "repository": "https://github.com/pkgforge-dev/asphyxia-core-appimage",
      "keywords": [
        "arcade",
        "rhythm",
        "emulator",
        "server",
        "backend",
        "bemani",
        "network"
      ],
      "categories": [
        "Game",
        "Network"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/asphyxia-core.png",
      "screenshots": [
        {
          "caption": "Asphyxia CORE interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Asphyxia-CORE-AppImage"
  },
  "sandbox": {
