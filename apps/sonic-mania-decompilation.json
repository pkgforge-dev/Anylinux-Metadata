    "metadata": {
      "id": "io.github.rubberduckycooly.sonic_mania_decompilation",
      "name": "Sonic Mania Decompilation",
      "summary": "Sonic Mania Decompilation is a native PC port created from the byte-accurate decompilation of Sonic Mania (2017) and the Retro Engine v5",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Sonic Mania Decompilation is a native PC port created from the byte-accurate decompilation of Sonic Mania (2017) and the Retro Engine v5. It runs natively on Linux with zero overhead and full mod support."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native Linux execution delivering responsive 60 FPS platforming action"
              }
            ],
            [
              {
                "type": "text",
                "value": "Widescreen and ultrawide display support with scalable UI elements"
              }
            ],
            [
              {
                "type": "text",
                "value": "Complete support for the Sonic Mania Plus expansion and Encore Mode"
              }
            ],
            [
              {
                "type": "text",
                "value": "Rich modding ecosystem with integrated mod manager support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern gamepad and arcade fight-stick compatibility with rumble feedback"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Sonic Mania Decompilation Developers",
