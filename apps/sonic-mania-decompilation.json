{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.rubberduckycooly.sonic_mania_decompilation",
      "name": "Sonic Mania Decompilation",
      "summary": "Byte-accurate native engine decompilation of Sonic Mania and the Retro Engine v5",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Sonic Mania Decompilation is a native port built upon a byte-accurate reverse engineering of Sonic Mania and Retro Engine v5 (RSDKv5). Designed for portability, performance, and preservation, it enables running the game natively on Linux systems while requiring original game assets from legitimate retail releases."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "In addition to authentic engine recreation, the project integrates modern quality-of-life enhancements and an extensive development framework for community modifications and version targeting."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Built-in mod loader and dedicated API calls for community mods"
              }
            ],
            [
              {
                "type": "text",
                "value": "Target support for both standalone RSDKv5 and RSDKv5U"
              }
            ],
            [
              {
                "type": "text",
                "value": "Configurable builds targeting release versions 1.00, 1.03, and the 1.06 Plus update"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless save data transfer from official PC releases"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform multimedia and graphics backend powered by SDL2 and OpenGL"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Sonic Mania Decompilation Developers",
        "url": "https://github.com/Rubberduckycooly/Sonic-Mania-Decompilation"
      },
      "homepage": "https://github.com/Rubberduckycooly/Sonic-Mania-Decompilation",
      "repository": "https://github.com/pkgforge-dev/Sonic-Mania-Decompilation-AppImage",
      "keywords": [
        "sonic",
        "mania",
        "decompilation",
        "retroengine",
        "rsdkv5",
        "platformer",
        "engine",
        "port"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/sonic-mania-decompilation.png",
      "screenshots": [
        {
          "caption": "Sonic Mania Decompilation interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
