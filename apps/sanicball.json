{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.bk_tn.sanicball",
      "name": "Sanicball",
      "summary": "Race at ludicrous speeds in a physics-defying multiplayer arcade parody",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Sanicball is a fast-paced, physics-defying multiplayer arcade racing game built on the Unity engine that parodies popular speed-centric platformers. Players roll around wacky tracks at uncontrollable speeds, negotiating steep ramps, loop-de-loops, and exaggerated physics."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed for chaotic competition, the game emphasizes absurd velocity and momentum-based racing mechanics across custom obstacles."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High-velocity momentum and physics-driven racing mechanics"
              }
            ],
            [
              {
                "type": "text",
                "value": "Online multiplayer support with dedicated server list connectivity"
              }
            ],
            [
              {
                "type": "text",
                "value": "Variety of meme-inspired parody characters rolling as spherical racers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Challenging stunt circuits featuring giant ramps and loops"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Sanicball Developers",
        "url": "https://github.com/BK-TN/Sanicball"
      },
      "homepage": "https://github.com/BK-TN/Sanicball",
      "repository": "https://github.com/pkgforge-dev/Sanicball-AppImage",
      "keywords": [
        "racing",
        "arcade",
        "multiplayer",
        "physics",
        "unity",
        "parody",
        "speed",
        "kart"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/sanicball.png",
      "screenshots": [
        {
          "caption": "Sanicball interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
