{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.interkarma.daggerfall_unity",
      "name": "Daggerfall Unity",
      "summary": "Daggerfall Unity is an open-source recreation of The Elder Scrolls II: Daggerfall using the Unity engine",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Daggerfall Unity is an open-source recreation of The Elder Scrolls II: Daggerfall using the Unity engine. It brings the massive open world and deep RPG systems of the 1996 classic into the modern era with high-resolution graphics, smooth controls, and extensive modding support."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Full widescreen rendering with modern graphics, enhanced lighting, and high-resolution textures"
              }
            ],
            [
              {
                "type": "text",
                "value": "Smooth first-person mouse controls with configurable keybindings and controller support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Restored cut content and fixes for hundreds of bugs present in the original game"
              }
            ],
            [
              {
                "type": "text",
                "value": "Powerful modding framework supporting community quests, graphical overhauls, and gameplay tweaks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Requires original Daggerfall game assets (freely available from Bethesda)"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Daggerfall Unity Developers",
        "url": "https://github.com/Interkarma/daggerfall-unity"
      },
      "homepage": "https://github.com/Interkarma/daggerfall-unity",
      "repository": "https://github.com/pkgforge-dev/Daggerfall-Unity-AppImage",
      "keywords": [
        "daggerfall-unity",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "RolePlaying"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/daggerfall-unity.png",
      "screenshots": [
        {
          "caption": "Daggerfall Unity interface screenshot 1",
