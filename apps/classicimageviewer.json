{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.classicimageviewer.classicimageviewer",
      "name": "classicimageviewer",
      "summary": "View, edit, and batch process images with a lightweight Qt interface",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ClassicImageViewer is a fast and lightweight image viewer and graphic editor built using the Qt framework. Designed for rapid navigation and basic photo manipulation, it offers a traditional, responsive interface capable of handling multiple common raster formats."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Beyond straightforward image viewing, the application provides built-in tools for fine-grained image adjustments, batch workflow automation, and custom annotation."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Standard transformation operations including resize, rotate, flip, and color adjustments"
              }
            ],
            [
              {
                "type": "text",
                "value": "Advanced visual filters and effects such as blur, unsharp mask, median, and denoise"
              }
            ],
            [
              {
                "type": "text",
                "value": "Paint mode featuring annotation shapes, text insertion, and clone stamp tools"
              }
            ],
            [
              {
                "type": "text",
                "value": "Batch image conversion and batch file renaming capabilities"
              }
            ],
            [
              {
                "type": "text",
                "value": "Thumbnail overview browser and automated slideshow display"
              }
            ],
            [
              {
                "type": "text",
                "value": "Macro recording and execution for repetitive editing workflows"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "classicimageviewer Developers",
        "url": "https://github.com/classicimageviewer/ClassicImageViewer"
      },
      "homepage": "https://github.com/classicimageviewer/ClassicImageViewer",
      "repository": "https://github.com/pkgforge-dev/ClassicImageViewer-AppImage-Enhanced",
      "keywords": [
        "image viewer",
        "photo editor",
        "slideshow",
        "batch conversion",
        "thumbnails",
        "qt",
        "raster graphics"
      ],
      "categories": [
        "Graphics",
        "2DGraphics",
        "RasterGraphics",
        "Viewer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/classicimageviewer.png",
      "screenshots": [
        {
          "caption": "classicimageviewer interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ClassicImageViewer-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
