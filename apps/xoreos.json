{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.xoreos.xoreos",
      "name": "xoreos",
      "summary": "Reimplementation of BioWare's Aurora engine and its successors",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "xoreos is an open-source reimplementation of BioWare's Aurora engine and its derivatives, developed to run games built with these engines in a portable manner across modern platforms. It focuses on reverse-engineering the foundational formats, graphics rendering, audio subsystems, and resource management pipelines."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "While full gameplay mechanics remain in development, xoreos enables exploration and verification of original game assets through internal spectator viewing modes and developmental interfaces."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Targeted support for Neverwinter Nights, Neverwinter Nights 2, and Jade Empire"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for Star Wars: Knights of the Old Republic and its sequel The Sith Lords"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatibility targets for The Witcher, Sonic Chronicles, and Dragon Age I and II"
              }
            ],
            [
              {
                "type": "text",
                "value": "Spectator mode to fly around and examine area geometry and scene objects"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in subsystems for sound playback, basic resource handling, and archive reading"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "xoreos Developers",
        "url": "https://github.com/xoreos/xoreos"
      },
      "homepage": "https://github.com/xoreos/xoreos",
      "repository": "https://github.com/pkgforge-dev/xoreos-AppImage",
      "keywords": [
        "bioware",
        "aurora",
        "engine",
        "reimplementation",
        "rpg",
        "odyssey",
        "electron",
        "emulator"
      ],
      "categories": [
        "Game",
        "Development",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/xoreos.png",
      "screenshots": [
        {
          "caption": "xoreos interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/xoreos-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
