{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.itgmania.itgmania",
      "name": "ITGmania",
      "summary": "Modern open-source rhythm game engine tailored for arcade and home dance gaming",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "ITGmania is an open-source rhythm game engine forked from StepMania 5.1, specifically optimized for modern operating systems, competitive dance gaming, and arcade cabinets. Built with native 64-bit support and integrated network connectivity, it delivers a smooth and responsive experience for 4-panel and custom rhythm gaming setups."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Built-in online networking support for connected profiles and leaderboards"
              }
            ],
            [
              {
                "type": "text",
                "value": "Optimized 64-bit performance tailored for modern operating systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "In-game song reload functionality directly from the song select screen"
              }
            ],
            [
              {
                "type": "text",
                "value": "Per-player timing window configuration and visual delay adjustment"
              }
            ],
            [
              {
                "type": "text",
                "value": "Engine-level tracking of held misses to assist in dance pad debugging"
              }
            ],
            [
              {
                "type": "text",
                "value": "Configurable note rendering order preferences and fixes for overlapping holds"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ITGmania Developers",
        "url": "https://github.com/itgmania/itgmania"
      },
      "homepage": "https://github.com/itgmania/itgmania",
      "repository": "https://github.com/pkgforge-dev/ITGmania-AppImage",
      "keywords": [
        "stepmania",
        "rhythm",
        "dance",
        "arcade",
        "simulator",
        "in the groove",
        "music"
      ],
      "categories": [
        "Game",
        "Midi"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/itgmania.png",
      "screenshots": [
        {
          "caption": "ITGmania interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/ITGmania-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
