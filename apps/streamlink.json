{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.github.streamlink",
      "name": "streamlink",
      "summary": "Pipe video streams from various online streaming services into your favorite media player",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Streamlink is a command-line utility designed to extract video streams from various online platforms and pipe them directly into a local media player such as VLC or MPV. It enables users to bypass resource-heavy web players and enjoy high-performance video playback with lower CPU and memory usage."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package bundles all necessary runtime dependencies and libraries, providing a fully self-contained media streaming client ready to run across various Linux environments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Pipes live video streams and video-on-demand content into external players"
              }
            ],
            [
              {
                "type": "text",
                "value": "Reduces CPU and memory overhead compared to browser-based video playback"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully portable runtime without requiring FUSE to execute"
              }
            ],
            [
              {
                "type": "text",
                "value": "Includes an integrated self-updater with permission prompts for new version notifications"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrates seamlessly with existing package managers to manage updates automatically"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "streamlink Developers",
        "url": "https://github.com/streamlink"
      },
      "homepage": "https://github.com/streamlink",
      "repository": "https://github.com/pkgforge-dev/Streamlink-AppImage",
      "keywords": [
        "stream",
        "video",
        "player",
        "livestream",
        "playback",
        "cli",
        "vlc",
        "hls"
      ],
      "categories": [
        "AudioVideo",
        "Video",
        "Viewer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/streamlink.png",
      "screenshots": [
        {
          "caption": "streamlink interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Streamlink-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
