{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "net.imput.helium",
      "name": "Helium Browser",
      "summary": "Browse the web with a privacy-focused and de-Googled Chromium browser",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Helium is a privacy-centric web browser built upon Chromium, tailored to remove background Google telemetry and integration while keeping modern web compatibility. Originating from ungoogled-chromium foundations, it delivers a clean, track-free browsing environment with the speed and reliability of the Chromium rendering engine."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Optimized specifically for Linux environments, Helium is built with full native sandboxing security and robust multi-architecture support across modern systems."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "De-Googled Chromium codebase stripped of tracking, background services, and telemetry"
              }
            ],
            [
              {
                "type": "text",
                "value": "Maintains uncompromising, hardened native Chromium sandboxing without weakening isolation"
              }
            ],
            [
              {
                "type": "text",
                "value": "First-class Linux multi-architecture support across both x86_64 and arm64 systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatible with standard web extensions and modern web application standards"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-performance rendering engine delivering low-latency web navigation"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "imputnet",
        "url": "https://imput.net"
      },
      "homepage": "https://github.com/imputnet/helium-linux",
      "repository": "https://github.com/imputnet/helium-linux",
      "keywords": [
        "browser",
        "web",
        "chromium",
        "privacy",
        "ungoogled",
        "internet",
        "navigator"
      ],
      "categories": [
        "Network",
        "WebBrowser"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/helium-browser.png",
      "screenshots": [
        {
          "caption": "Helium Browser interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Helium-Browser-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
