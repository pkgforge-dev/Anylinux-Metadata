{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.revosucks.bmherorecomp",
      "name": "Bomberman Hero Recompiled",
      "summary": "Play a native PC port of Bomberman Hero created through static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Bomberman Hero Recompiled is an enhanced native PC port of the classic Nintendo 64 platformer, produced via static recompilation using N64: Recompiled and rendered with the RT64 engine. It delivers modernized performance, high-fidelity graphics, and extensive configurability while preserving original game mechanics."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Assets are loaded directly from a user-provided original game ROM with no manual asset extraction or compilation required."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Plug-and-play ROM loading without requiring asset extraction"
              }
            ],
            [
              {
                "type": "text",
                "value": "High framerate gameplay matched to high-refresh monitor rates"
              }
            ],
            [
              {
                "type": "text",
                "value": "Widescreen and ultrawide display resolution support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Faithfully preserved Nintendo 64 visual effects using RT64"
              }
            ],
            [
              {
                "type": "text",
                "value": "In-game configuration menus supporting mouse, keyboard, and gamepad input"
              }
            ],
            [
              {
                "type": "text",
                "value": "Instant load times and reduced input latency"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Revo",
        "url": "https://github.com/RevoSucks"
      },
      "homepage": "https://github.com/RevoSucks/BMHeroRecomp",
      "repository": "https://github.com/RevoSucks/BMHeroRecomp",
      "keywords": [
        "bomberman",
        "recompiled",
        "port",
        "n64",
        "rt64",
        "vulkan",
        "platformer",
        "recompilation"
      ],
      "categories": [
        "Game",
        "ActionGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/bmherorecomp.png",
      "screenshots": [
        {
          "caption": "Bomberman Hero Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
