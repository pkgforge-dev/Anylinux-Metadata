{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.dvershinin.bettermediainfo",
      "name": "BetterMediaInfo",
      "summary": "View detailed technical information and metadata for audio and video files",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "BetterMediaInfo is a modern, lightweight desktop utility designed to inspect and display comprehensive technical specifications and stream metadata for multimedia files."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Built using Tauri for responsive cross-platform performance, the application provides an intuitive graphical interface for analyzing container formats, codecs, bitrates, audio tracks, and subtitles."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Inspect comprehensive container, video, audio, and subtitle stream details"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern, responsive user interface powered by Tauri and web technologies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Detailed breakdown of codecs, bitrates, resolutions, and frame rates"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fast parsing and extraction of technical multimedia metadata"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "BetterMediaInfo Developers",
        "url": "https://github.com/dvershinin/bettermediainfo"
      },
      "homepage": "https://github.com/dvershinin/bettermediainfo",
      "repository": "https://github.com/pkgforge-dev/BetterMediaInfo-AppImage-Enhanced",
      "keywords": [
        "mediainfo",
        "video",
        "audio",
        "metadata",
        "codec",
        "inspector",
        "analyzer",
        "multimedia",
        "streams"
      ],
      "categories": [
        "AudioVideo",
        "Utility",
        "Viewer"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/bettermediainfo.png",
      "screenshots": [
        {
          "caption": "BetterMediaInfo screenshot",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-25",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/BetterMediaInfo-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
