{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.trevorbayless.cli_chess",
      "name": "cli-chess",
      "summary": "Customizable terminal chess client supporting online play via Lichess and offline AI",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "cli-chess is a terminal-based chess client built in Python that allows players to enjoy chess directly in the console. It offers integration with Lichess.org for online multiplayer matches as well as offline gameplay against the integrated Fairy-Stockfish engine."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed for maximum flexibility and keyboard-driven efficiency, cli-chess provides support for all standard Lichess game variants, customizable color themes, and multiple move input formats."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Play online matches using your Lichess account or play offline against Fairy-Stockfish"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full support for all official Lichess chess variants"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiple move notation inputs including UCI, SAN, and LAN"
              }
            ],
            [
              {
                "type": "text",
                "value": "Customizable themes and color schemes for the board, pieces, and UI elements"
              }
            ],
            [
              {
                "type": "text",
                "value": "In-game opponent chat, blindfold mode, and live Lichess TV streaming"
              }
            ],
            [
              {
                "type": "text",
                "value": "PGN game export support for post-match analysis"
              }
            ]
          ]
        }
      ],
      "projectLicense": "MIT",
      "developer": {
        "name": "Trevor Bayless",
        "url": "https://github.com/trevorbayless"
      },
      "homepage": "https://github.com/trevorbayless/cli-chess",
      "repository": "https://github.com/trevorbayless/cli-chess",
      "keywords": [
        "chess",
        "lichess",
        "stockfish",
        "terminal",
        "tui",
        "boardgame",
        "pgn",
        "uci"
      ],
      "categories": [
        "Game",
        "Network",
        "Chat"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/cli-chess.png",
      "screenshots": [
        {
