{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.interrupt.systemshock_shockolate",
      "name": "Shockolate",
      "summary": "Cross-platform source port of the classic cyberpunk immersive sim System Shock",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Shockolate is a cross-platform, open-source source port of the 1994 cyberpunk immersive sim System Shock, built using SDL2 and based on the PowerPC source code. It aims to preserve the classic feel while modernizing the engine for portability, stability, and modern hardware."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "In addition to authentic retro gameplay, Shockolate introduces quality-of-life enhancements and expanded engine capabilities for players and creators alike."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Modernized movement scheme featuring standard WASD controls and a dedicated mouselook toggle"
              }
            ],
            [
              {
                "type": "text",
                "value": "Hardware-accelerated OpenGL renderer with hotkeys to cycle rendering modes"
              }
            ],
            [
              {
                "type": "text",
                "value": "FluidSynth MIDI and SDL2_mixer audio support for authentic music reproduction"
              }
            ],
            [
              {
                "type": "text",
                "value": "Mod and fan mission support with loading from custom resource and mission files or directories"
              }
            ],
            [
              {
                "type": "text",
                "value": "Asset compatibility with original CD-ROM and System Shock: Enhanced Edition data files"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Shockolate Developers",
        "url": "https://github.com/Interrupt/systemshock"
      },
      "homepage": "https://github.com/Interrupt/systemshock",
      "repository": "https://github.com/pkgforge-dev/shockolate-appimage",
      "keywords": [
        "system shock",
        "source port",
        "immersive sim",
        "cyberpunk",
        "sdl2",
        "retrogaming",
        "opengl"
      ],
      "categories": [
        "Game",
        "Midi"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/shockolate.png",
      "screenshots": [
        {
          "caption": "Shockolate interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Shockolate-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
