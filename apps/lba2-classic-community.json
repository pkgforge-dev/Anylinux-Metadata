{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.lbalab.lba2_classic_community",
      "name": "Little Big Adventure 2 Classic Community",
      "summary": "Community modernization and source port for Little Big Adventure 2 (Twinsun's Odyssey)",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Little Big Adventure 2 Classic Community is an open-source modernization project for the classic adventure title Little Big Adventure 2 (Twinsun's Odyssey). Maintained by LBALab, it preserves the 1997 classic for modern operating systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The source port delivers high-resolution rendering, updated audio mixing, widescreen presentation, and modern gamepad support while retaining original gameplay and narrative."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native modern execution preserving authentic narrative and character dialogue"
              }
            ],
            [
              {
                "type": "text",
                "value": "Widescreen display rendering with support for modern desktop resolutions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Updated audio engine supporting high-quality music playback and voice tracks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern game controller and mouse navigation compatibility"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform reliability with numerous stability improvements over the original release"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-2.0-or-later",
      "developer": {
        "name": "LBALab",
        "url": "https://github.com/LBALab"
      },
      "homepage": "https://github.com/LBALab/lba2-classic-community",
      "repository": "https://github.com/LBALab/lba2-classic-community",
      "keywords": [
        "lba2-classic-community",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Game",
        "AdventureGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/lba2-classic-community.png",
      "screenshots": [
        {
          "caption": "Little Big Adventure 2 Classic Community interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "LBALab/lba2-classic-community"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
