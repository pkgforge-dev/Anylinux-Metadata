{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.touchhle.touchhle",
      "name": "touchHLE",
      "summary": "touchHLE is a high-level emulator (HLE) for early iPhone OS / iOS applications and games",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "touchHLE is a high-level emulator (HLE) for early iPhone OS / iOS applications and games. Written in Rust, it allows classic touch-screen games from the iPhone's golden era (Super Monkey Ball, Flight Control) to run natively on PC."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High-level emulation approach executing ARM binaries with high speed and low overhead"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern mouse and gamepad controls simulating iPhone touchscreens and accelerometers"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-resolution rendering upscaling original mobile graphics to modern PC monitors"
              }
            ],
            [
              {
                "type": "text",
                "value": "Clean audio playback replicating original sound effects and music"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatible with classic 32-bit iPhone OS .ipa application packages"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "touchHLE Developers",
        "url": "https://github.com/touchHLE/touchHLE"
      },
      "homepage": "https://github.com/touchHLE/touchHLE",
      "repository": "https://github.com/pkgforge-dev/TouchHLE-AppImage",
      "keywords": [
        "touchhle",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/touchhle.png",
      "screenshots": [
        {
          "caption": "touchHLE interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/TouchHLE-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
