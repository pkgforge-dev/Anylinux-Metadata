{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.touchhle.touchhle",
      "name": "touchHLE",
      "summary": "High-level emulator for early iPhone OS and iOS applications and games",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "touchHLE is a high-level emulator written in Rust designed to run apps and games from the early days of iPhone OS. Rather than simulating physical iPhone hardware, it directly implements system frameworks such as Foundation, UIKit, OpenGL ES, and OpenAL to execute app binaries efficiently."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The project primarily targets iPhone and iPod touch titles from the iPhone OS 2.x and 3.0 eras, featuring versatile input mapping systems designed to replicate touch and accelerometer controls across modern desktop environments."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High-level emulation implementing key system frameworks like UIKit and OpenGL ES"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for early iPhone OS 2.x and 3.0 games and applications"
              }
            ],
            [
              {
                "type": "text",
                "value": "Touchscreen simulation via mouse, trackpad, virtual cursor, or direct touch screens"
              }
            ],
            [
              {
                "type": "text",
                "value": "Configurable button, D-pad, and analog stick mapping to on-screen touch positions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Simulated accelerometer and tilt controls using mouse movements or gamepad analog sticks"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "touchHLE Developers",
        "url": "https://github.com/touchHLE/touchHLE"
      },
      "homepage": "https://github.com/touchHLE/touchHLE",
      "repository": "https://github.com/pkgforge-dev/TouchHLE-AppImage",
      "keywords": [
        "emulator",
        "ios",
        "iphone",
        "ipod",
        "hle",
        "retrogaming",
        "dynarmic",
        "opengles"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/touchhle.png",
      "screenshots": [
        {
          "caption": "touchHLE interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/TouchHLE-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
