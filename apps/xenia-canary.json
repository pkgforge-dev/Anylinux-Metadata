{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.xenia_canary.xenia_canary",
      "name": "Xenia Canary",
      "summary": "Play Xbox 360 games on Linux with an experimental open-source research emulator",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Xenia Canary is an experimental research fork of the Xenia emulator designed to emulate Microsoft Xbox 360 hardware and software. Written in modern C++, it serves as an active testbed for bleeding-edge features, performance optimizations, and community-driven compatibility improvements."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "As a community fork, Canary receives rapid updates to tackle unimplemented console subsystems, graphical pipeline advancements, and gaming enhancements prior to upstream integration."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Experimental Xbox 360 system emulation and CPU/GPU pipeline improvements"
              }
            ],
            [
              {
                "type": "text",
                "value": "Experimental netplay capabilities for multiplayer testing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive community game compatibility tracking and ongoing bug triage"
              }
            ],
            [
              {
                "type": "text",
                "value": "Custom build orchestration and tooling via the xb build utility"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform development targeting both Linux and Windows environments"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Xenia Canary Developers",
        "url": "https://github.com/xenia-canary/xenia-canary"
      },
      "homepage": "https://github.com/xenia-canary/xenia-canary",
      "repository": "https://github.com/pkgforge-dev/xenia-canary-AppImage",
      "keywords": [
        "xbox",
        "xbox 360",
        "emulator",
        "emulation",
        "gaming",
        "console",
        "netplay"
      ],
      "categories": [
        "Game",
        "Debugger"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/xenia-canary.png",
      "screenshots": [
        {
          "caption": "Xenia Canary interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/xenia-canary-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
