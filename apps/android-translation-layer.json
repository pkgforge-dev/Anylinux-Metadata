{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pkgforge_dev.android_translation_layer_appimage",
      "name": "android-translation-layer",
      "summary": "Run Android applications directly on Linux through an execution translation layer",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "android-translation-layer is an execution environment and compatibility translation layer designed to run Android applications natively on GNU/Linux distributions without relying on full emulation or containerized virtual machines."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "By translating Android runtime and OS calls directly into standard Linux equivalents, it provides efficient execution and native desktop integration for mobile applications."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Executes Android binaries directly on standard Linux systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Eliminates the overhead of heavy virtual machine hypervisors"
              }
            ],
            [
              {
                "type": "text",
                "value": "Translates Android platform API calls into native system interfaces"
              }
            ],
            [
              {
                "type": "text",
                "value": "Seamless integration with existing desktop environments and window managers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Portable deployment compatible across glibc and musl-based distributions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "android-translation-layer Developers",
        "url": "https://github.com/pkgforge-dev/android_translation_layer-AppImage"
      },
      "homepage": "https://github.com/pkgforge-dev/android_translation_layer-AppImage",
      "repository": "https://github.com/pkgforge-dev/android_translation_layer-AppImage",
      "keywords": [
        "android",
        "compatibility",
        "translation",
        "runtime",
        "apk",
        "execution",
        "bridge"
      ],
      "categories": [
        "System",
        "Utility",
        "Translation"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/android-translation-layer.png",
      "screenshots": [
        {
          "caption": "android-translation-layer interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/android_translation_layer-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
