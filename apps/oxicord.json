{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.oxicord.oxicord",
      "name": "Oxicord",
      "summary": "Lightweight and fast terminal Discord client written in Rust",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Oxicord is a lightweight and performant terminal-based Discord client developed in Rust. Built with modern terminal user interface principles, it offers an efficient, keyboard-centric way to connect to Discord without the heavy resource usage of standard web or Electron applications."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed for minimalism and speed, Oxicord provides essential communication tools straight from the command line while integrating cleanly into power-user workflows."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High-performance, resource-efficient backend written in pure Rust"
              }
            ],
            [
              {
                "type": "text",
                "value": "Responsive terminal user interface for seamless message reading and sending"
              }
            ],
            [
              {
                "type": "text",
                "value": "Keyboard-driven navigation optimized for CLI environments and window managers"
              }
            ],
            [
              {
                "type": "text",
                "value": "Low memory and CPU consumption compared to Electron-based clients"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Oxicord Developers",
        "url": "https://github.com/oxicord"
      },
      "homepage": "https://github.com/oxicord/oxicord",
      "repository": "https://github.com/oxicord/oxicord",
      "keywords": [
        "discord",
        "client",
        "terminal",
        "tui",
        "cli",
        "rust",
        "chat",
        "messaging"
      ],
      "categories": [
        "Network",
        "Chat",
        "InstantMessaging"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/oxicord.png",
      "screenshots": [
        {
          "caption": "Oxicord interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Oxicord-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
