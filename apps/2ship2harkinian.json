{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.harbourmasters.2ship2harkinian",
      "name": "2 Ship 2 Harkinian",
      "summary": "PC port of The Legend of Zelda: Majora's Mask with modern controls and enhancements",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "2 Ship 2 Harkinian is an advanced native PC port of The Legend of Zelda: Majora's Mask built upon the reverse-engineered decompilation project. It modernizes the classic action-adventure experience for contemporary desktop operating systems with native performance, high framerate rendering, and customizable input."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The port requires an original game ROM to extract and build assets, preserving legitimate game ownership while introducing comprehensive engine improvements and quality-of-life options."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native PC rendering supporting arbitrary resolutions, ultrawide aspect ratios, and unlocked framerates"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modernized control schemes with full gamepad mapping, mouse camera controls, and keyboard navigation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Direct asset extraction from legally acquired retail N64 game ROMs"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated graphical and gameplay enhancements with configurable visual tweaks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive quality-of-life toggles and modern debugging capabilities"
              }
            ]
          ]
        }
      ],
      "projectLicense": "CC0-1.0",
      "developer": {
        "name": "Harbour Masters",
        "url": "https://www.harbourmasters.org"
      },
      "homepage": "https://www.harbourmasters.org",
      "repository": "https://github.com/HarbourMasters/2ship2harkinian",
      "keywords": [
        "zelda",
        "majora",
        "decompilation",
        "port",
        "n64",
        "rom",
        "adventure",
        "action"
      ],
      "categories": [
        "Game",
        "ActionGame",
        "AdventureGame"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/2ship2harkinian.png",
      "screenshots": [
        {
          "caption": "2 Ship 2 Harkinian interface screenshot 1",
