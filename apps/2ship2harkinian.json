    "metadata": {
      "id": "io.github.harbourmasters.2ship2harkinian",
      "name": "2 Ship 2 Harkinian",
      "summary": "PC port of The Legend of Zelda: Majora's Mask with modern controls and high framerate rendering",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "2 Ship 2 Harkinian is an enhanced native PC port of The Legend of Zelda: Majora's Mask developed by the Harbour Masters team. It provides modern graphics enhancements, high framerates, and customizable gameplay options while preserving authentic game mechanics."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The project delivers a responsive and immersive experience with modern camera control, widescreen display rendering, and comprehensive game controller support."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native PC execution with uncapped framerates and ultra-smooth animations"
              }
            ],
            [
              {
                "type": "text",
                "value": "True widescreen and ultra-widescreen high-resolution display rendering"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern dual-analog camera controls with optional mouse aiming"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive quality-of-life enhancements and customization options"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full gamepad support with remappable button layouts and rumble feedback"
              }
            ]
          ]
        }
      ],
      "projectLicense": "CC0-1.0",
      "developer": {
