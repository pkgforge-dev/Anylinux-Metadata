        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The minimal, blazing-fast, and infinitely customizable prompt for any shell."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "- Fast: it's fast – _really really_ fast! 🚀 - Customizable: configure every aspect of your prompt. - Universal: works on any shell, on any operating system. - Intelligent: shows relevant information at a glance. - Feature rich: support for all your favorite tools. - Easy: quick to install – start using it in minutes."
            }
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
