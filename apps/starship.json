{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "rs.starship.starship",
      "name": "starship",
      "summary": "Minimal, blazing-fast, and infinitely customizable prompt for any shell",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Starship is a fast, highly customizable cross-shell prompt designed to provide essential contextual information concisely while staying out of your way. Built with modern shell workflows in mind, it seamlessly integrates with virtually every shell to display git branch status, runtime environments, package versions, and system details on demand."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "This portable package bundles all dependencies to run cleanly across different Linux distributions without requiring system FUSE or complex setup."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Universal compatibility across major shells including Bash, Zsh, Fish, and PowerShell"
              }
            ],
            [
              {
                "type": "text",
                "value": "Intelligent context awareness displaying Git repository status and programming language environments"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive customizability through simple configuration files to adjust colors, icons, and modules"
              }
            ],
            [
              {
                "type": "text",
                "value": "High-performance architecture optimized for instantaneous prompt rendering without latency"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated update notification support with seamless portable packaging"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "starship Developers",
        "url": "https://starship.rs/"
      },
      "homepage": "https://starship.rs/",
      "repository": "https://github.com/pkgforge-dev/Starship-AppImage-Enhanced",
      "keywords": [
        "prompt",
        "shell",
        "terminal",
        "bash",
        "zsh",
        "fish",
        "cli"
      ],
      "categories": [
        "Development",
        "System",
        "TextTools"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/starship.png",
      "screenshots": [
        {
          "caption": "starship interface screenshot 1",
          "source": "https://raw.githubusercontent.com/starship/starship/main/media/demo.gif"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Starship-AppImage-Enhanced"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
