{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pjasicek.openclaw",
      "name": "OpenClaw",
      "summary": "Modern open-source reimplementation of the classic Captain Claw platformer game",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "OpenClaw is a multiplatform C++ reimplementation written completely from scratch for the classic 1997 side-scrolling platformer Captain Claw. Powered by SDL2 and Box2D physics, it breathes new life into the beloved pirate adventure across modern operating systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The engine reads original game assets directly from the original CLAW.REZ archive, recreating authentic physics, audio, and gameplay dynamics on modern hardware."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Complete from-scratch C++ engine reimplementation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Original CLAW.REZ asset loading for authentic graphics and level data"
              }
            ],
            [
              {
                "type": "text",
                "value": "Accurate 2D platforming physics powered by Box2D"
              }
            ],
            [
              {
                "type": "text",
                "value": "Modern multiplatform rendering and input handling via SDL2"
              }
            ],
            [
              {
                "type": "text",
                "value": "MIDI background soundtrack playback support via Timidity"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "OpenClaw Developers",
        "url": "https://github.com/pjasicek/OpenClaw"
      },
      "homepage": "https://github.com/pjasicek/OpenClaw",
      "repository": "https://github.com/pkgforge-dev/OpenClaw-AppImage",
      "keywords": [
        "captain claw",
        "platformer",
        "side-scroller",
        "retro",
        "pirate",
        "sdl2",
        "box2d",
        "game engine",
        "reimplementation"
      ],
      "categories": [
        "Game",
        "Midi"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/openclaw.png",
      "screenshots": [
        {
          "caption": "OpenClaw interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/OpenClaw-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
