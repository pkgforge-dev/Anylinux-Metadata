{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.brunonymous.powermanga",
      "name": "Powermanga",
      "summary": "Classic arcade-style 2D vertical shoot-em-up featuring intense waves and retro visuals",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Powermanga is an arcade-style 2D vertical scrolling shoot-em-up space game inspired by retro classics. Players pilot a starfighter through dozens of challenging sectors packed with aggressive enemy formations, heavy firepower, and formidable bosses."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for broad Linux compatibility, this release ensures a self-contained gaming experience across modern and legacy distributions without requiring external system runtimes."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "41 intensive levels with progressive difficulty and varied hostile environments"
              }
            ],
            [
              {
                "type": "text",
                "value": "Over a dozen distinct spacecraft and weapon upgrade tiers to unlock"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dozens of unique enemy ship classes and specialized boss encounters"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-updater to seamlessly check for and notify of new game versions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable execution with no FUSE dependency required"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "TLK Games",
        "url": "https://github.com/brunonymous/Powermanga"
      },
      "homepage": "https://github.com/brunonymous/Powermanga",
      "repository": "https://github.com/brunonymous/Powermanga",
      "keywords": [
        "shmup",
        "arcade",
        "shooter",
        "vertical shooter",
        "space",
        "retro",
        "2d game"
      ],
      "categories": [
        "Game",
        "2DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/powermanga.png",
      "screenshots": [
        {
          "caption": "Powermanga interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Powermanga-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
