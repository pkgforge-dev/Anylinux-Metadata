{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.zelda64recomp.zelda64recomp",
      "name": "Zelda 64: Recompiled",
      "summary": "Statically recompiled native PC port of Nintendo 64 Zelda titles with RT64 enhancements",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Zelda 64: Recompiled is a native PC port of classic Nintendo 64 Zelda titles powered by N64: Recompiled static recompilation and the RT64 rendering engine. It delivers native performance, visual enhancements, and modern control options while preserving original rendering effects."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The project operates on a plug-and-play model, loading game assets directly from an original game copy without requiring manual asset extraction or compilation."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Plug-and-play asset loading directly from an original game copy via the main menu"
              }
            ],
            [
              {
                "type": "text",
                "value": "High framerate, widescreen, and ultrawide display support"
              }
            ],
            [
              {
                "type": "text",
                "value": "RT64 rendering engine maintaining authentic N64 visual effects with modern graphical features"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dual analog camera control, gyroscope aiming, and modern gamepad configuration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extensive modding support, autosaving, near-instant load times, and reduced input lag"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native Linux and Steam Deck compatibility with Vulkan rendering"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Zelda64Recomp Team",
        "url": "https://github.com/Zelda64Recomp"
      },
      "homepage": "https://github.com/Zelda64Recomp/Zelda64Recomp",
      "repository": "https://github.com/Zelda64Recomp/Zelda64Recomp",
      "keywords": [
        "zelda",
        "n64",
        "recompilation",
        "recompiled",
        "rt64",
        "port",
        "vulkan",
        "modding"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/zelda64recomp.png",
      "screenshots": [
        {
          "caption": "Zelda 64: Recompiled interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Zelda64Recomp-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "full",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [
      "gpu",
      "input"
    ],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
