{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.gryphel.mini_vmac",
      "name": "Mini vMac",
      "summary": "Emulate early Macintosh computers based on the Motorola 68000 microcomputer architecture",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Mini vMac is a lightweight, dedicated emulator engineered to reproduce the hardware of early Apple Macintosh computers powered by the Motorola 68000 microprocessor family. It provides an accurate environment to run classic System software, legacy applications, and vintage Mac games seamlessly on modern Linux systems."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Built for portability and efficiency, this packaging bundles all essential runtime libraries using SDL display integration without requiring external container runtimes or elevated system privileges."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Emulates vintage Macintosh hardware models based on Motorola 68000 architecture"
              }
            ],
            [
              {
                "type": "text",
                "value": "Runs classic Macintosh System software, legacy productivity tools, and retro games"
              }
            ],
            [
              {
                "type": "text",
                "value": "SDL-based graphical display backend configured for stable X11 desktop sessions"
              }
            ],
            [
              {
                "type": "text",
                "value": "Standalone portable architecture requiring no FUSE installation to execute"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-updater that detects new releases and integrates with existing package managers"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Mini vMac Developers",
        "url": "https://www.gryphel.com/c/minivmac/"
      },
      "homepage": "https://www.gryphel.com/c/minivmac/",
      "repository": "https://github.com/pkgforge-dev/Mini-vMac-AppImage",
      "keywords": [
        "macintosh",
        "emulator",
        "m68k",
        "motorola",
        "retrocomputing",
        "apple",
        "vintage",
        "sdl"
      ],
      "categories": [
        "System",
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/mini-vmac.png",
      "screenshots": [
        {
          "caption": "Mini vMac interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Mini-vMac-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
