{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.uowuo.abaddon",
      "name": "Abaddon",
      "summary": "Lightweight and customizable alternative Discord client written in C++ and GTK",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Abaddon is an alternative, resource-efficient Discord client built with C++ and GTK. Designed as a native desktop application without Electron, it delivers high performance and a fully customizable interface for communicating across servers and direct messages."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The client focuses on responsiveness and a lightweight footprint while supporting essential platform interactions, including server administration tools and voice communication."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native voice call support and comprehensive chat message rendering including embeds and replies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full interface theming and visual customization options"
              }
            ],
            [
              {
                "type": "text",
                "value": "Direct messaging, group DMs, and thread support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Server moderation capabilities such as role management, audit logs, and member moderation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Desktop notifications, unread indicators, and mention badges"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Abaddon Developers",
        "url": "https://github.com/uowuo/abaddon"
      },
      "homepage": "https://github.com/uowuo/abaddon",
      "repository": "https://github.com/pkgforge-dev/Abaddon-AppImage",
      "keywords": [
        "discord",
        "chat",
        "messaging",
        "instant messaging",
        "gtk",
        "voice",
        "voip",
        "communication"
      ],
      "categories": [
        "Network",
        "InstantMessaging",
        "Chat",
        "Telephony"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/abaddon.png",
      "screenshots": [
        {
          "caption": "Chat view displaying server channels, message history, and user list",
          "source": "https://raw.githubusercontent.com/uowuo/abaddon/master/.readme/s5.png"
        },
        {
          "caption": "Customizable theme layout and dark interface view",
          "source": "https://raw.githubusercontent.com/uowuo/abaddon/master/.readme/s6.png"
        },
        {
          "caption": "Direct message and thread conversation interface",
          "source": "https://raw.githubusercontent.com/uowuo/abaddon/master/.readme/s7.png"
        },
        {
          "caption": "Compact channel browser and embedded media view",
          "source": "https://raw.githubusercontent.com/uowuo/abaddon/master/.readme/s8.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Abaddon-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
