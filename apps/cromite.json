{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.uazo.cromite",
      "name": "Cromite",
      "summary": "Cromite is a privacy-hardened, open-source web browser forked from Chromium, continuing the legacy of Bromite",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Cromite is a privacy-hardened, open-source web browser forked from Chromium, continuing the legacy of Bromite. It integrates built-in ad blocking, DNS-over-HTTPS, and security patches designed to defend against online tracking and fingerprinting."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Built-in ad-blocking engine using customizable filter lists"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced privacy settings disabling telemetry, metrics, and background pings"
              }
            ],
            [
              {
                "type": "text",
                "value": "Advanced fingerprinting countermeasures for canvas, audio, and client hints"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full Chromium extension support with regular security updates"
              }
            ],
            [
              {
                "type": "text",
                "value": "Native Linux desktop integration with dark mode and Wayland support"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Cromite Developers",
        "url": "https://github.com/uazo/cromite"
      },
      "homepage": "https://github.com/uazo/cromite",
      "repository": "https://github.com/pkgforge-dev/Cromite-AppImage",
      "keywords": [
        "cromite",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Network",
        "WebBrowser"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/cromite.png",
      "screenshots": [
        {
          "caption": "Cromite interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Cromite-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
