{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.uazo.cromite",
      "name": "Cromite",
      "summary": "Privacy-hardened open-source web browser based on Chromium and Bromite with ad blocking",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Cromite is a privacy-focused web browser built as a fork of Chromium, carrying forward the privacy and security enhancements originally introduced by the Bromite project. It aims to minimize telemetry, tracking vectors, and tight browser integration with upstream device or platform services, returning control to the user."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed for clean and secure daily browsing, Cromite disables intrusive tracking mechanisms by default and provides powerful tools to customize browsing privacy and behavior."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Built-in ad blocking engines and tracking script mitigation"
              }
            ],
            [
              {
                "type": "text",
                "value": "Continuity of research, patches, and security mitigations from Bromite"
              }
            ],
            [
              {
                "type": "text",
                "value": "Anti-fingerprinting protections designed to limit habitual tracking"
              }
            ],
            [
              {
                "type": "text",
                "value": "Disabled telemetry and reduced platform-manufacturer integration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Granular user toggles for privacy and web platform capabilities"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Cromite Developers",
        "url": "https://github.com/uazo/cromite"
      },
      "homepage": "https://github.com/uazo/cromite",
      "repository": "https://github.com/pkgforge-dev/Cromite-AppImage",
      "keywords": [
        "browser",
        "chromium",
        "bromite",
        "privacy",
        "adblocker",
        "security",
        "antitracking",
        "web"
      ],
      "categories": [
        "Network",
        "WebBrowser"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/cromite.png",
      "screenshots": [
        {
          "caption": "Cromite interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Cromite-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
