{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pkgforge_dev.gapless_appimage_gapless",
      "name": "gapless",
      "summary": "Play music with seamless gapless playback designed for large audio collections",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Gapless (formerly G4Music) is a lightweight and responsive audio player written in GTK4 and Libadwaita. Built with a focus on speed and minimalism, it effortlessly handles large music collections containing tens of thousands of songs with rapid startup times and minimal system resource usage."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The player features an adaptive user interface that harmonizes with modern desktop styling, highlighting embedded album art with smooth Gaussian blur backdrops and fluid playback controls."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Native gapless audio playback for continuous listening experiences"
              }
            ],
            [
              {
                "type": "text",
                "value": "High performance indexing optimized for large music libraries"
              }
            ],
            [
              {
                "type": "text",
                "value": "Support for most popular audio formats and embedded album cover art"
              }
            ],
            [
              {
                "type": "text",
                "value": "Adaptive GTK4 user interface with blurred background album styling"
              }
            ],
            [
              {
                "type": "text",
                "value": "Volume normalization using ReplayGain and audio peak visualizer"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integration with MPRIS for system-wide media playback controls"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "gapless Developers",
        "url": "https://github.com/pkgforge-dev/Gapless-AppImage"
      },
      "homepage": "https://github.com/pkgforge-dev/Gapless-AppImage",
      "repository": "https://github.com/pkgforge-dev/Gapless-AppImage",
      "keywords": [
        "music",
        "player",
        "audio",
        "gtk4",
        "libadwaita",
        "playback",
        "mpris",
        "replaygain",
        "sound"
      ],
      "categories": [
        "AudioVideo",
        "Audio"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/gapless.png",
      "screenshots": [
        {
          "caption": "gapless interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Gapless-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
