{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "br.gov.itr2025",
      "name": "ITR 2025",
      "summary": "Programa Gerador da Declaração do Imposto sobre a Propriedade Territorial Rural 2025 da Receita Federal",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "O ITR 2025 (Programa Gerador da Declaração do ITR 2025) é o aplicativo oficial da Secretaria Especial da Receita Federal do Brasil destinado à elaboração e transmissão da Declaração do Imposto sobre a Propriedade Territorial Rural para o exercício de 2025."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Esta edição empacotada de forma portátil foi construída para funcionar de maneira transparente em diversas distribuições Linux modernas e legadas, sem exigir dependências complexas de sistema."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Elaboração completa da Declaração do Imposto sobre a Propriedade Territorial Rural (DITR)"
              }
            ],
            [
              {
                "type": "text",
                "value": "Validação de dados fiscais e cálculo automático do imposto devido"
              }
            ],
            [
              {
                "type": "text",
                "value": "Geração e impressão de comprovantes, recibos e DARF para pagamento"
              }
            ],
            [
              {
                "type": "text",
                "value": "Gravação e transmissão eletrônica da declaração diretamente à base da Receita Federal"
              }
            ],
            [
              {
                "type": "text",
                "value": "Execução portátil sem necessidade do FUSE via uruntime integrado"
              }
            ],
            [
              {
                "type": "text",
                "value": "Sistema de notificação de atualização integrado com suporte a gerenciadores de pacotes"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ITR 2025 Developers",
        "url": "https://www.gov.br/receitafederal/pt-br/centrais-de-conteudo/download/pgd/ditr"
      },
      "homepage": "https://www.gov.br/receitafederal/pt-br/centrais-de-conteudo/download/pgd/ditr",
      "repository": "https://github.com/pkgforge-dev/ITR2025-AppImage",
      "keywords": [
        "receita federal",
        "ditr",
        "imposto territorial rural",
        "tributos",
        "declaracao",
        "fiscal",
        "fazenda"
      ],
      "categories": [
        "Office",
        "Finance"
      ]
    },
    "media": {
