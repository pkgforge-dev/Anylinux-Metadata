{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.ffmpeg.ffmpeg",
      "name": "ffmpeg",
      "summary": "FFmpeg is the universal, open-source multimedia framework capable of decoding, encoding, transcoding, muxing, demuxing, streaming, filtering, and p",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "FFmpeg is the universal, open-source multimedia framework capable of decoding, encoding, transcoding, muxing, demuxing, streaming, filtering, and playing virtually any audio or video format."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Complete multimedia toolset including the ffmpeg, ffprobe, and ffplay binaries"
              }
            ],
            [
              {
                "type": "text",
                "value": "Hardware-accelerated video decoding and encoding via VA-API, NVENC, and QuickSync"
              }
            ],
            [
              {
                "type": "text",
                "value": "Broad codec support including AV1, H.264, HEVC, VP9, AAC, FLAC, and Opus"
              }
            ],
            [
              {
                "type": "text",
                "value": "Powerful audio and video filtering pipeline for resizing, cropping, and color grading"
              }
            ],
            [
              {
                "type": "text",
                "value": "Comprehensive container support for MP4, MKV, WebM, MOV, and streaming protocols"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "ffmpeg Developers",
        "url": "https://www.ffmpeg.org/"
      },
      "homepage": "https://www.ffmpeg.org/",
      "repository": "https://github.com/pkgforge-dev/FFmpeg-AppImage",
      "keywords": [
        "ffmpeg",
        "appimage",
        "anylinux"
      ],
      "categories": [
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/ffmpeg.png",
      "screenshots": [
        {
          "caption": "ffmpeg interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
