{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.mcarcady.lnp_forge_dwarf_fortress",
      "name": "dwarf-fortress",
      "summary": "Colony simulation and fantasy generator bundled with popular utilities, graphics, and community tools",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "LinuxDwarfPack provides a complete setup for Dwarf Fortress on Linux, compiling and packaging the game alongside essential community tools, utility managers, and graphical enhancements directly from source repositories."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The distribution delivers a rich fantasy world generator and fortress management experience enhanced with labor administration tools, extended soundscapes, and comprehensive history visualizers."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Integrated DFHack engine extension and Text Will Be Text (TWBT) renderer plugin"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full suite of DFGraphics tilesets with configurable embark profiles and keybindings"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dwarf Therapist labor management utility for monitoring and assigning dwarf tasks"
              }
            ],
            [
              {
                "type": "text",
                "value": "SoundSense-RS audio companion for contextual music and event audio"
              }
            ],
            [
              {
                "type": "text",
                "value": "Legends Browser 1 and 2 integration for exploring generated historical logs and lore"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dedicated Announcement Window for tracking fortress events and combat alerts in real time"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "dwarf-fortress Developers",
        "url": "https://github.com/McArcady/lnp-forge"
      },
      "homepage": "https://github.com/McArcady/lnp-forge",
      "repository": "https://github.com/pkgforge-dev/Dwarf-Fortress-AppImage",
      "keywords": [
        "simulation",
        "roguelike",
        "strategy",
        "dfhack",
        "therapist",
        "soundsense",
        "tilesets",
        "colony"
      ],
      "categories": [
        "Game",
        "Building"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dwarf-fortress.png",
      "screenshots": [
        {
          "caption": "dwarf-fortress interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Dwarf-Fortress-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
