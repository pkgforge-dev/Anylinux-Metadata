{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "org.freedesktop.gitlab.xeyes",
      "name": "xeyes",
      "summary": "Follow the mouse cursor on screen with a classic pair of animated eyes",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "xeyes is an iconic X Window System utility that displays a pair of animated eyes whose pupils continuously track the position of the pointer across the screen. Originally created as a playful graphical demonstration, it has long served as a classic visual indicator for tracking cursor coordinates and window system activity."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged with portable runtime enhancements, this build provides zero-configuration deployment across a wide range of Linux distributions without requiring system-level FUSE integration."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Real-time tracking of cursor movement across the entire display workspace"
              }
            ],
            [
              {
                "type": "text",
                "value": "Smooth geometric pupil motion calculation reflecting mouse coordinates"
              }
            ],
            [
              {
                "type": "text",
                "value": "Classic lightweight X11 demo tool architecture with minimal resource overhead"
              }
            ],
            [
              {
                "type": "text",
                "value": "Self-contained portable distribution compatible across glibc and musl-based systems"
              }
            ],
            [
              {
                "type": "text",
                "value": "Runs standalone without requiring FUSE setup or container environments"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "xeyes Developers",
        "url": "https://gitlab.freedesktop.org/xorg/app/xeyes"
      },
      "homepage": "https://gitlab.freedesktop.org/xorg/app/xeyes",
      "repository": "https://github.com/pkgforge-dev/xeyes-AppImage",
      "keywords": [
        "cursor",
        "mouse",
        "tracking",
        "x11",
        "xorg",
        "demo",
        "eyes",
        "pointer"
      ],
      "categories": [
        "Utility",
        "Graphics",
        "2DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/xeyes.png",
      "screenshots": [
        {
          "caption": "xeyes interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/xeyes-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
