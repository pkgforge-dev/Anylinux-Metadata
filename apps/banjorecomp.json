{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.banjorecomp.banjorecomp",
      "name": "BanjoRecomp",
      "summary": "Enhanced native PC port of the classic Nintendo 64 platformer Banjo-Kazooie using static recompilation",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Banjo: Recompiled is an enhanced native port of the classic platformer Banjo-Kazooie, created via static recompilation using N64: Recompiled and the RT64 rendering engine. It delivers performance improvements, visual enhancements, and modern convenience while preserving the authenticity of the original game."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Game assets are not included and must be supplied from an original North American 1.0 ROM. The port automatically extracts and loads required assets upon launch without demanding manual extraction or rebuilding."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "High framerate support alongside widescreen and ultrawide aspect ratio options"
              }
            ],
            [
              {
                "type": "text",
                "value": "Dual analog camera controls and modernized input handling with low latency"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully intact graphical effects, transitions, and original mipmapping accuracy"
              }
            ],
            [
              {
                "type": "text",
                "value": "Faithful audio emulation preserving precise synchronization without stutter"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated quality-of-life enhancements such as note saving and extensive mod support"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "BanjoRecomp Developers",
        "url": "https://github.com/BanjoRecomp/BanjoRecomp"
      },
      "homepage": "https://github.com/BanjoRecomp/BanjoRecomp",
      "repository": "https://github.com/pkgforge-dev/banjorecomp-appimage",
      "keywords": [
        "banjo",
        "kazooie",
        "n64",
        "recompilation",
        "recompiled",
        "platformer",
        "rt64",
        "emulator",
        "port"
      ],
      "categories": [
        "Game"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/banjorecomp.png",
      "screenshots": [
        {
          "caption": "BanjoRecomp interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/BanjoRecomp-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
