{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.pickrecalled.sacdextractgui",
      "name": "SACDExtractGUI",
      "summary": "Extract audio tracks and data from Super Audio CD images with a graphical interface",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "SACDExtractGUI provides a cross-platform graphical user interface for sacd_extract, simplifying the process of processing and extracting high-resolution audio from Super Audio CD (SACD) disc images. Developed in Java, it removes the need to manually execute command-line instructions when managing SACD rips."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Designed specifically for modern forks of sacd_extract, this utility streamlines configuration options and workflow management into an intuitive desktop layout."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Intuitive front-end eliminating complex command-line parameter handling"
              }
            ],
            [
              {
                "type": "text",
                "value": "Tailored integration with the setmind fork of sacd-ripper tools"
              }
            ],
            [
              {
                "type": "text",
                "value": "Cross-platform Java desktop interface running seamlessly on Linux"
              }
            ],
            [
              {
                "type": "text",
                "value": "Convenient selection and conversion of SACD ISO image files"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "SACDExtractGUI Developers",
        "url": "https://github.com/PickRecalled/SACDExtractGUI"
      },
      "homepage": "https://github.com/PickRecalled/SACDExtractGUI",
      "repository": "https://github.com/pkgforge-dev/sacdextractgui-appimage",
      "keywords": [
        "sacd",
        "ripper",
        "audio",
        "extraction",
        "iso",
        "dsd",
        "dsf",
        "gui"
      ],
      "categories": [
        "AudioVideo",
        "Audio",
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/sacdextractgui.png",
      "screenshots": [
        {
          "caption": "SACDExtractGUI interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/SACDExtractGUI-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
