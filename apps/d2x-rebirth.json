{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "io.github.dxx_rebirth.dxx_rebirth_d2x_rebirth",
      "name": "D2X-Rebirth",
      "summary": "Source port of Descent II updating the classic six-degrees-of-freedom shooter for modern systems",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "D2X-Rebirth is an open-source port of the classic six-degrees-of-freedom first-person shooter Descent II. Built using OpenGL and SDL, it modernizes the original game engine for contemporary operating systems while faithfully preserving original gameplay mechanics, physics, and mission compatibility."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "OpenGL rendering engine providing smooth graphics, arbitrary display resolutions, aspect ratios, and VSync"
              }
            ],
            [
              {
                "type": "text",
                "value": "Enhanced visual effects including transparency, colored lighting, texture filtering, and full-scene anti-aliasing"
              }
            ],
            [
              {
                "type": "text",
                "value": "Robust input handling via SDL with simultaneous keyboard, mouse, and modern multi-axis joystick support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Multiplayer matches over UDP/IP for both local area network and online internet play"
              }
            ],
            [
              {
                "type": "text",
                "value": "Extended audio playback supporting original MIDI, CD-Audio, and custom external music tracks"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full backward compatibility with original DOS savegames, demo recordings, expansions, and custom levels"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "D2X-Rebirth Developers",
        "url": "https://github.com/dxx-rebirth/dxx-rebirth"
      },
      "homepage": "https://github.com/dxx-rebirth/dxx-rebirth",
      "repository": "https://github.com/pkgforge-dev/d2x-rebirth-AppImage",
      "keywords": [
        "descent",
        "shooter",
        "fps",
        "opengl",
        "sdl",
        "multiplayer",
        "udp",
        "sourceport",
        "retro"
      ],
      "categories": [
        "Game",
        "3DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/d2x-rebirth.png",
      "screenshots": [
        {
          "caption": "D2X-Rebirth interface screenshot 1",
