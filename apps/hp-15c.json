{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "de.hp_15c_simulator.hp15c",
      "name": "HP-15C Simulator",
      "summary": "Precise software simulation of the Hewlett-Packard HP-15C programmable scientific calculator",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "HP-15C Simulator provides a faithful recreation of the classic Hewlett-Packard HP-15C high-end scientific programmable pocket calculator. It accurately simulates the calculator's computational algorithms, Reverse Polish Notation (RPN) logic, matrix operations, complex number support, numerical integration, and programming capabilities."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for maximum portability on Linux, the simulator runs out-of-the-box across a wide variety of distributions with integrated self-updating functionality."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Authentic emulation of the HP-15C scientific calculator interface and keypad layout"
              }
            ],
            [
              {
                "type": "text",
                "value": "Reverse Polish Notation (RPN) stack-based calculation engine"
              }
            ],
            [
              {
                "type": "text",
                "value": "Full support for complex numbers, matrix mathematics, and numerical integration"
              }
            ],
            [
              {
                "type": "text",
                "value": "Built-in program memory and keystroke sequence execution"
              }
            ],
            [
              {
                "type": "text",
                "value": "Standalone, dependency-free execution compatible with modern and legacy Linux distributions"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "Torsten Manz",
        "url": "https://hp-15c.homepage.t-online.de"
      },
      "homepage": "https://hp-15c.homepage.t-online.de",
      "repository": "https://github.com/pkgforge-dev/HP-15C-Simulator-AppImage",
      "keywords": [
        "calculator",
        "scientific",
        "rpn",
        "hewlett-packard",
        "simulation",
        "emulator",
        "math",
        "matrix"
      ],
      "categories": [
        "Science",
        "Utility"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/hp-15c.png",
      "screenshots": [
        {
          "caption": "HP-15C Simulator interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
