{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "de.mister_muffin.img2pdf",
      "name": "img2pdf",
      "summary": "Losslessly convert raster images into PDF format without re-encoding image streams",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "img2pdf is a specialized command-line utility designed to convert raster image formats into PDF documents directly without re-encoding existing image data. By embedding existing JPEG, JPEG2000, PNG, and TIFF streams directly into PDF wrappers, the software preserves original image quality and file size without introducing generation loss."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Distributed as a standalone portable package, this application bundles all runtime dependencies to ensure reliable operation across various Linux distributions without requiring system-level installation or FUSE filesystem layers."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Performs true lossless image conversion without recompressing original image streams"
              }
            ],
            [
              {
                "type": "text",
                "value": "Significantly faster processing speeds and lower memory overhead than conventional raster-to-PDF tools"
              }
            ],
            [
              {
                "type": "text",
                "value": "Direct preservation of original image color spaces, palettes, and metadata"
              }
            ],
            [
              {
                "type": "text",
                "value": "Bundled runtime architecture running independently without requiring FUSE support"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-updater capable of detecting new package releases"
              }
            ]
          ]
        }
      ],
      "projectLicense": "LGPL-3.0-or-later",
      "developer": {
        "name": "Johannes Schauer Marin Rodrigues",
        "url": "https://mister-muffin.de"
      },
      "homepage": "https://gitlab.mister-muffin.de/josch/img2pdf",
      "repository": "https://gitlab.mister-muffin.de/josch/img2pdf",
      "keywords": [
        "pdf",
        "converter",
        "raster",
        "lossless",
        "jpeg",
        "tiff",
        "png",
        "document"
      ],
      "categories": [
        "Graphics",
        "Publishing",
        "RasterGraphics",
        "2DGraphics"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/img2pdf.png",
      "screenshots": [
        {
          "caption": "img2pdf interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/img2pdf-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
