{
  "$schema": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/schema/app-manifest.json",
  "appstream": {
    "type": "manual",
    "metadata": {
      "id": "com.aarongiles.dreamm.dreamm",
      "name": "DREAMM",
      "summary": "Play and preserve LucasArts graphic adventure and arcade classics",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "DREAMM is an emulator and preservation engine created by Aaron Giles dedicated to LucasArts graphic adventure and arcade games. It provides an authentic and highly accurate platform tailored specifically for vintage SCUMM and related titles, ensuring seamless modern playback and historical preservation."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Packaged for maximum portability and broad compatibility across Linux distributions, the application runs self-contained without demanding external system dependencies or runtime containers."
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Dedicated emulation engine tailored for LucasArts adventure and arcade titles"
              }
            ],
            [
              {
                "type": "text",
                "value": "Authentic audio and graphic rendering designed for classic games"
              }
            ],
            [
              {
                "type": "text",
                "value": "Integrated self-updater to easily keep the emulator up to date"
              }
            ],
            [
              {
                "type": "text",
                "value": "Fully standalone deployment requiring no external FUSE dependencies"
              }
            ],
            [
              {
                "type": "text",
                "value": "Broad Linux distribution compatibility across glibc and musl environments"
              }
            ]
          ]
        }
      ],
      "projectLicense": "GPL-3.0-or-later",
      "developer": {
        "name": "DREAMM Developers",
        "url": "https://dreamm.aarongiles.com/"
      },
      "homepage": "https://dreamm.aarongiles.com/",
      "repository": "https://github.com/pkgforge-dev/dreamm-appimage",
      "keywords": [
        "lucasarts",
        "emulator",
        "scumm",
        "adventure",
        "preservation",
        "retrogaming",
        "arcade"
      ],
      "categories": [
        "Game",
        "Emulator"
      ]
    },
    "media": {
      "icon": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-Metadata/main/icons/dreamm.png",
      "screenshots": [
        {
          "caption": "DREAMM interface screenshot 1",
          "source": "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/main/assets/banner.png"
        }
      ]
    }
  },
  "addedAt": "2026-09-16",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/DREAMM-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": true,
    "filesystem": [],
    "devices": [],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "none",
      "rules": []
    }
  }
}
