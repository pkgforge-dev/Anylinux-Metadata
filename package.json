{
  "name": "anylinux-metadata",
  "version": "1.0.0",
  "description": "Production-grade community metadata database for Anylinux AppImages not on Flathub",
  "type": "module",
  "scripts": {
    "validate": "bun run scripts/validate.ts",
    "sync": "bun run scripts/sync-upstream.ts",
    "import": "bun run scripts/import-pla.ts",
    "generate-schema": "bun run scripts/generate-schema.ts",
    "export": "bun run scripts/export-catalog.ts",
    "test": "bun test"
  },
  "keywords": [
    "appimage",
    "appstream",
    "metadata",
    "freedesktop",
    "linux",
    "pkgforge"
  ],
  "author": "AnyLinux Community",
  "license": "CC0-1.0",
  "dependencies": {
    "spdx-expression-parse": "^4.0.0",
    "spdx-license-ids": "^3.0.21",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.5.5",
    "@types/spdx-expression-parse": "^4.0.0",
    "typescript": "^5.6.2"
  }
}
